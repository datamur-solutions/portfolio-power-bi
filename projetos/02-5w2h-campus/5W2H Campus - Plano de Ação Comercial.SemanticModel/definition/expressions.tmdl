	annotation PBI_ResultType = List

expression 'Mapa Consultores' =
		let
		    Mapa = {
		        {"Nome", "t", {"Title", "Título"}},
		        {"Matricula", "t", {"Matricula", "Matrícula"}},
		        {"EmailConsultor", "t", {"EmailConsultor", "E-mail do consultor"}},
		        {"Funcao", "t", {"Funcao", "Função"}},
		        {"Situacao", "t", {"Situacao", "Situação"}},
		        {"Unidade", "t", {"Unidade"}},
		        {"Filial", "t", {"Filial"}},
		        {"Regional", "t", {"Regional"}},
		        {"Coordenador", "t", {"Coordenador"}},
		        {"EmailCoordenador", "t", {"EmailCoordenador", "E-mail do coordenador"}},
		        {"Gerente", "t", {"Gerente"}},
		        {"EmailGerente", "t", {"EmailGerente", "E-mail do gerente"}},
		        {"Ativo", "b", {"Ativo"}}
		    }
		in
		    Mapa
	lineageTag: 5a1b81d4-5582-5ebb-a67b-ffb44ef82c15

	annotation PBI_ResultType = List

expression 'Ações Base' =
		let
		    T = Normalizar(#"Fonte Ações", #"Mapa Ações"),
		    Validas = Table.SelectRows(T, each [DataInicio] <> null and ([Matricula] <> "" or [EmailConsultor] <> "" or [Consultor] <> "")),
		    C1 = Table.AddColumn(Validas, "Chave", each ChaveConsultor([Matricula], [EmailConsultor], [Consultor]), type text),
		    C2 = Table.AddColumn(C1, "Fim", each if [DataFim] = null or [DataFim] < [DataInicio] then [DataInicio] else [DataFim], type date),
		    C3 = Table.AddColumn(C2, "MesData", each Date.StartOfMonth([DataInicio]), type date),
		    // a chave da semana usa a mesma fórmula do app a partir da data de início; a aba Diagnóstico aponta divergência com a semana gravada
		    C4 = Table.AddColumn(C3, "SemanaN", each SemanaDoMes([DataInicio]), Int64.Type),
		    C5 = Table.AddColumn(C4, "ChaveSemana", each [Chave] & "|" & Date.ToText([MesData], [Format = "yyyy-MM"]) & "|" & Text.From([SemanaN]), type text),
		    C6 = Table.AddColumn(C5, "StatusN", each if [Status] = "" then "Planejada" else [Status], type text),
		    C7 = Table.AddColumn(C6, "ListaProdutos", each ListaChaves([Produtos], {{"Grad", {"grad"}}, {"Pos", {"pós", "pos"}}, {"Tec", {"téc", "tec"}}, {"Prof", {"prof"}}}, "todos")),
		    C8 = Table.AddColumn(C7, "ListaModalidades", each ListaChaves([Modalidades], {{"Pres", {"pres"}}, {"Semi", {"semi"}}, {"EAD", {"ead", "a distância", "a distancia"}}}, "todas")),
		    C9 = Table.AddColumn(C8, "TemFechamento", each [RealInscritos] <> null or [RealMatriculas] <> null or [CustoRealizado] <> null or [StatusN] <> "Planejada", type logical)
		in
		    Table.Buffer(C9)
	lineageTag: ebf20355-4a69-5bfa-9f6e-42d9b1f7e0fd

	annotation PBI_ResultType = Table

expression 'Consultores Base' =
		let
		    T = Normalizar(#"Fonte Consultores", #"Mapa Consultores"),
		    Validos = Table.SelectRows(T, each [Matricula] <> "" or [EmailConsultor] <> "" or [Nome] <> ""),
		    ComChave = Table.AddColumn(Validos, "Chave", each ChaveConsultor([Matricula], [EmailConsultor], [Nome]), type text),
		    // um registro por consultor (prioriza o ativo)
		    Ordenada = Table.Sort(ComChave, {{"Ativo", Order.Descending}}),
		    Unicos = Table.Buffer(Table.Distinct(Table.Buffer(Ordenada), {"Chave"}))
		in
		    Unicos
	lineageTag: b6762bf4-dd5a-56ff-8947-b4852f561016

	annotation PBI_ResultType = Table

expression 'Semanas Base' =
		let
		    A = Table.Buffer(#"Ações Base"),
		    C = Table.Buffer(#"Consultores Base"),
		    Meses = List.Sort(List.Distinct(A[MesData])),
		    Cal = List.Combine(List.Transform(Meses, (m) => List.Transform(SemanasDoMes(m), (s) => s & [MesData = m]))),
		    Chaves = List.Distinct(Table.SelectRows(C, each [Ativo])[Chave] & A[Chave]),
		    Grade = Table.FromRecords(List.Combine(List.Transform(Chaves, (k) => List.Transform(Cal, (s) => s & [Chave = k]))),
		        {"SemanaN", "Inicio", "Fim", "N", "DiasLista", "MesData", "Chave"}, MissingField.UseNull),
		    ComChaveSem = Table.AddColumn(Grade, "ChaveSemana", each [Chave] & "|" & Date.ToText([MesData], [Format = "yyyy-MM"]) & "|" & Text.From([SemanaN]), type text),
		    Grupos = Table.Group(A, {"ChaveSemana"}, {{"G", each Table.Sort(_, {{"DataInicio", Order.Ascending}, {"ID", Order.Ascending}}), type table}}),
		    J1 = Table.NestedJoin(ComChaveSem, {"ChaveSemana"}, Grupos, {"ChaveSemana"}, "JG", JoinKind.LeftOuter),
		    J2 = Table.AddColumn(J1, "Acoes", each if Table.IsEmpty([JG]) then Table.FirstN(A, 0) else [JG]{0}[G]),
		    J3 = Table.NestedJoin(Table.RemoveColumns(J2, {"JG"}), {"Chave"}, C, {"Chave"}, "JC", JoinKind.LeftOuter),
		    J4 = Table.AddColumn(J3, "Cad", each if Table.IsEmpty([JC]) then null else [JC]{0}),
		    Ordenada = Table.Sort(Table.RemoveColumns(J4, {"JC"}), {{"Chave", Order.Ascending}, {"MesData", Order.Ascending}, {"SemanaN", Order.Ascending}}),
		    ComId = Table.AddIndexColumn(Ordenada, "IdSemana", 1, 1, Int64.Type),
		    // hierarquia: base fixa do cadastro (Consultores 5W2H); a gravada na ação só entra para quem não está no cadastro
		    Info = Table.AddColumn(ComId, "Info", (r) =>
		        let
		            a = if Table.IsEmpty(r[Acoes]) then null else Table.First(r[Acoes]),
		            c = r[Cad],
		            pega = (ca as text, cc as text) as text =>
		                let va = if a = null then "" else Record.Field(a, ca), vc = if c = null then "" else Record.Field(c, cc) in if vc <> "" then vc else va
		        in
		            [Consultor = pega("Consultor", "Nome"), Matricula = pega("Matricula", "Matricula"), Regional = pega("Regional", "Regional"), Unidade = pega("Unidade", "Unidade"),
		             Coordenador = pega("Coordenador", "Coordenador"), EmailCoordenador = Text.Lower(pega("EmailCoordenador", "EmailCoordenador")),
		             Gerente = pega("Gerente", "Gerente"), EmailGerente = Text.Lower(pega("EmailGerente", "EmailGerente")),
		             EmailConsultor = Text.Lower(pega("EmailConsultor", "EmailConsultor")),
		             Filial = if c = null then "" else c[Filial], Funcao = if c = null then "" else c[Funcao], Situacao = if c = null then "" else c[Situacao],
		             Ativo = if c = null then false else c[Ativo]]),
		    Expandida = Table.ExpandRecordColumn(Info, "Info", {"Consultor", "Matricula", "Regional", "Unidade", "Coordenador", "EmailCoordenador", "Gerente", "EmailGerente",
		        "EmailConsultor", "Filial", "Funcao", "Situacao", "Ativo"})
		in
		    Table.Buffer(Expandida)
	lineageTag: 30cd443b-0e53-52ba-9217-37e7d8b6cdda

	annotation PBI_ResultType = Table

expression 'Ações Expandidas' =
		let
		    S = Table.Buffer(Table.RenameColumns(Table.SelectColumns(#"Semanas Base", {"IdSemana", "ChaveSemana"}), {{"ChaveSemana", "CS"}})),
		    A = Table.Buffer(#"Ações Base"),
		    J = Table.Join(A, "ChaveSemana", S, "CS", JoinKind.Inner),
		    // nº da ação dentro da semana do consultor (ordem de início e ID)
		    Ord = Table.AddIndexColumn(Table.Sort(J, {{"IdSemana", Order.Ascending}, {"DataInicio", Order.Ascending}, {"ID", Order.Ascending}}), "Pos", 0, 1, Int64.Type),
		    Prim = Table.Group(Ord, {"IdSemana"}, {{"Ini", each List.Min([Pos]), Int64.Type}}),
		    J2 = Table.Join(Ord, "IdSemana", Table.RenameColumns(Prim, {{"IdSemana", "IdS2"}}), "IdS2", JoinKind.Inner),
		    ComNum = Table.AddColumn(J2, "NumAcao", each [Pos] - [Ini] + 1, Int64.Type),
		    Limpa = Table.RemoveColumns(ComNum, {"CS", "Pos", "Ini", "IdS2"}),
		    ComId = Table.AddColumn(Limpa, "IdAcao", each if [ID] > 0 then [ID] else 100000000 + [IdSemana] * 100 + [NumAcao], Int64.Type),
		    ComDias = Table.AddColumn(ComId, "DiasAcao", each DiasUteis([DataInicio], [Fim]))
		in
		    Table.Buffer(ComDias)
	lineageTag: 0fad0d27-b424-51ee-9cdf-079553f25ca5

	annotation PBI_ResultType = Table

