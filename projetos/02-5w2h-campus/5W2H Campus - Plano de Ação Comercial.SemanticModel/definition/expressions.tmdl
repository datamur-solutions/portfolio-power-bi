/// Data de referência fixa do portfólio (dd/mm/aaaa): prazos e vencimentos ficam estáveis.
expression DataReferencia = "23/10/2026" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=false]
	lineageTag: a6104c86-7783-55e6-b0f9-276bf6cd6dc3

	annotation PBI_ResultType = Text

expression Resolver =
		(fonte as record, mapa as list) as table =>
		let
		    Cols = Table.ColumnNames(fonte[Itens]),
		    CamposU = Table.Distinct(Table.SelectRows(fonte[Campos], each [Title] <> null and [InternalName] <> null), {"Title"}),
		    PorTitulo = Record.FromList(CamposU[InternalName], CamposU[Title]),
		    PorInterno = Record.FromList(CamposU[Title], CamposU[InternalName]),
		    Resolve = (nomes as list) as nullable text =>
		        let achados = List.Select(List.Transform(nomes, (n) => if List.Contains(Cols, n) then n else Record.FieldOrDefault(PorTitulo, n, null)), each _ <> null and List.Contains(Cols, _))
		        in if List.IsEmpty(achados) then null else achados{0}
		in
		    Table.FromRecords(List.Transform(mapa, (d) =>
		        let fonteCol = Resolve(d{2}) in
		        [Campo = d{0}, Tipo = d{1}, Candidatos = Text.Combine(d{2}, " | "), Fonte = fonteCol,
		         Titulo = if fonteCol = null then null else Record.FieldOrDefault(PorInterno, fonteCol, fonteCol)]),
		        {"Campo", "Tipo", "Candidatos", "Fonte", "Titulo"})
	lineageTag: 83bc8d82-68ad-561f-b046-54d84a1e4b97

	annotation PBI_ResultType = Function

expression Normalizar =
		(fonte as record, mapa as list) as table =>
		let
		    Itens = fonte[Itens],
		    Mapa = Table.ToRecords(Resolver(fonte, mapa)),
		    ParaTexto = (v) => if v = null then "" else if Value.Is(v, type record) then (try Text.From(v[Title]) otherwise "")
		        else if Value.Is(v, type list) then Text.Combine(List.Transform(v, each try Text.From(_) otherwise ""), "; ") else Text.Trim(Text.From(v)),
		    ParaNumero = (v) => if v = null or v = "" then null else if Value.Is(v, type number) then v
		        else (try Number.FromText(Text.Trim(Text.From(v)), "pt-BR") otherwise null),
		    ParaBool = (v) => if v = null then false else if Value.Is(v, type logical) then v
		        else List.Contains({"sim", "yes", "true", "1", "verdadeiro"}, Text.Lower(Text.Trim(Text.From(v)))),
		    // A API devolve datas em UTC ("2026-10-23T03:00:00Z"): converte para São Paulo (-3h) antes de tirar a data
		    ParaData = (v) => if v = null or v = "" then null
		        else if Value.Is(v, type date) then v
		        else if Value.Is(v, type datetimezone) then Date.From(DateTimeZone.SwitchZone(v, -3))
		        else if Value.Is(v, type datetime) then Date.From(v)
		        else let t = Text.Trim(Text.From(v)), cauda = if Text.Length(t) > 10 then Text.Range(t, 10) else "" in
		            if Text.EndsWith(t, "Z") or Text.Contains(cauda, "+") or Text.Contains(cauda, "-")
		            then (try Date.From(DateTimeZone.SwitchZone(DateTimeZone.FromText(t), -3)) otherwise null)
		            else (try Date.From(DateTime.FromText(t, [Culture = "pt-BR"])) otherwise (try Date.FromText(t, [Culture = "pt-BR"]) otherwise null)),
		    Conv = (tipo as text, v) => if tipo = "n" then (let x = ParaNumero(v) in if x = null then 0 else x)
		        else if tipo = "nn" then ParaNumero(v) else if tipo = "b" then ParaBool(v) else if tipo = "d" then ParaData(v) else ParaTexto(v),
		    Campos = List.Transform(Mapa, each [Campo]),
		    Linhas = Table.TransformRows(Itens, (r) => Record.FromList(List.Transform(Mapa, (m) => Conv(m[Tipo], if m[Fonte] = null then null else Record.Field(r, m[Fonte]))), Campos))
		in
		    Table.Buffer(Table.FromRecords(Linhas, Campos, MissingField.UseNull))
	lineageTag: cc9c14c7-a7aa-56c6-941d-86da027121b7

	annotation PBI_ResultType = Function

expression SemanaDoMes =
		(d as date) as number =>
		let
		    dw = Date.DayOfWeek(Date.StartOfMonth(d), Day.Monday),
		    desloc = if dw = 6 then -1 else dw
		in
		    List.Max({1, Number.RoundUp((Date.Day(d) + desloc) / 7)})
	lineageTag: 0a87417a-5720-5a99-8997-f205f7c7465d

	annotation PBI_ResultType = Function

expression SemanasDoMes =
		(mes as date) as list =>
		let
		    ini = Date.StartOfMonth(mes),
		    dias = List.Select(List.Dates(ini, Date.DaysInMonth(ini), #duration(1, 0, 0, 0)), each Date.DayOfWeek(_, Day.Monday) <> 6),
		    nums = List.Distinct(List.Transform(dias, SemanaDoMes))
		in
		    List.Transform(nums, (n) => let ds = List.Select(dias, each SemanaDoMes(_) = n) in
		        [SemanaN = n, Inicio = List.Min(ds), Fim = List.Max(ds), N = List.Count(ds), DiasLista = ds])
	lineageTag: 77e57b23-1b8c-5141-8d88-0a213b1589cd

	annotation PBI_ResultType = Function

expression DiasUteis =
		(ini as nullable date, fim as nullable date) as list =>
		    if ini = null then {} else
		    let f = if fim = null or fim < ini then ini else fim,
		        n = List.Min({Duration.Days(f - ini) + 1, 92})
		    in List.Select(List.Dates(ini, n, #duration(1, 0, 0, 0)), each Date.DayOfWeek(_, Day.Monday) <> 6)
	lineageTag: 25b6c2c0-91d9-5255-a42b-8ac8386ae7f2

	annotation PBI_ResultType = Function

expression ChaveConsultor =
		(matricula as text, email as text, nome as text) as text =>
		let m = Text.Select(matricula, {"0".."9"}) in
		    if m <> "" then m else if email <> "" then Text.Lower(email) else Text.Upper(nome)
	lineageTag: 6a04834b-0c1f-5b25-92f0-024e7af075dc

	annotation PBI_ResultType = Function

expression MesTexto = (d as date) as text => {"Jan", "Fev", "Mar", "Abr", "Mai", "Jun", "Jul", "Ago", "Set", "Out", "Nov", "Dez"}{Date.Month(d) - 1} & "/" & Text.End(Text.From(Date.Year(d)), 2)
	lineageTag: fac411a0-8647-5c40-a45f-d646083e3da2

	annotation PBI_ResultType = Function

expression ListaChaves =
		(texto as text, opcoes as list, todos as text) as list =>
		let
		    // "Graduação; Pós-graduação" -> {"Grad", "Pos"} · "Todos"/"Todas" -> todas as chaves
		    itens = List.Select(List.Transform(Text.SplitAny(texto, ";,"), (x) => Text.Lower(Text.Trim(x))), each _ <> ""),
		    tudo = List.Contains(itens, todos),
		    chaves = List.Distinct(List.Combine(List.Transform(itens, (x) => List.Select(opcoes, (o) => List.AnyTrue(List.Transform(o{1}, (p) => Text.StartsWith(x, p)))))))
		in
		    List.Transform(if tudo then opcoes else chaves, each _{0})
	lineageTag: a36c762f-058b-5108-859a-683040e7be2d

	annotation PBI_ResultType = Function

expression Localizar =
		(unidade as nullable text, filial as nullable text) as record =>
		let
		    // localização da unidade para o mapa: UF (com a regra usada) e cidade
		    Estados = [AC = "Acre", AL = "Alagoas", AP = "Amapá", AM = "Amazonas", BA = "Bahia", CE = "Ceará", DF = "Distrito Federal", ES = "Espírito Santo", GO = "Goiás", MA = "Maranhão", MT = "Mato Grosso", MS = "Mato Grosso do Sul", MG = "Minas Gerais", PA = "Pará", PB = "Paraíba", PR = "Paraná", PE = "Pernambuco", PI = "Piauí", RJ = "Rio de Janeiro", RN = "Rio Grande do Norte", RS = "Rio Grande do Sul", RO = "Rondônia", RR = "Roraima", SC = "Santa Catarina", SP = "São Paulo", SE = "Sergipe", TO = "Tocantins"],
		    SemAcento = (t as text) as text => List.Accumulate({{"Á", "A"}, {"À", "A"}, {"Â", "A"}, {"Ã", "A"}, {"É", "E"}, {"Ê", "E"}, {"Í", "I"}, {"Ó", "O"}, {"Ô", "O"}, {"Õ", "O"}, {"Ú", "U"}, {"Ç", "C"}},
		        Text.Upper(t), (s, par) => Text.Replace(s, par{0}, par{1})),
		    Letras = {"A".."Z"},
		    // nome por extenso (sem "PARA", que também é preposição)
		    Nomes = List.Select(List.Transform(Record.FieldNames(Estados), (u) => {u, SemAcento(Record.Field(Estados, u))}), each _{0} <> "PA"),
		    // 1) sigla logo depois de "/": "EDUNOVA - VALINHOS/SP"
		    PorBarra = (t as text) as nullable text =>
		        let ok = List.Select(List.Transform(List.Skip(Text.Split(t, "/"), 1), (p) => let x = Text.Trim(p) in
		                if Text.Length(x) >= 2 and Record.HasFields(Estados, Text.Start(x, 2)) and (Text.Length(x) = 2 or not List.Contains(Letras, Text.Middle(x, 2, 1)))
		                then Text.Start(x, 2) else null), each _ <> null)
		        in if List.IsEmpty(ok) then null else List.Last(ok),
		    // 2) sigla isolada: "UNIDADE CENTRO - MG", "(BA)"
		    PorSigla = (t as text) as nullable text =>
		        let ok = List.Select(Text.SplitAny(t, " -–/()[],.|;:_0123456789"), each Record.HasFields(Estados, _))
		        in if List.IsEmpty(ok) then null else List.Last(ok),
		    // 3) nome do estado por extenso: "... SANTA CATARINA"
		    PorNome = (t as text) as nullable text =>
		        let x = " " & Text.Combine(Text.SplitAny(t, " -–/()[],.|;:_"), " ") & " ", ok = List.Select(Nomes, (n) => Text.Contains(x, " " & n{1} & " "))
		        in if List.IsEmpty(ok) then null else List.Last(ok){0},
		    Tenta = (t as nullable text) as record =>
		        let x = SemAcento(if t = null then "" else t), b = PorBarra(x), s = if b = null then PorSigla(x) else null, n = if b = null and s = null then PorNome(x) else null
		        in [UF = if b <> null then b else if s <> null then s else n,
		            Regra = if b <> null then "sigla após /" else if s <> null then "sigla no nome" else if n <> null then "nome do estado" else null],
		    U = Tenta(unidade),
		    F = if U[UF] <> null then [UF = null, Regra = null] else Tenta(filial),
		    UF = if U[UF] <> null then U[UF] else if F[UF] <> null then F[UF] else "",
		    Origem = if U[UF] <> null then "Unidade · " & U[Regra] else if F[UF] <> null then "Filial · " & F[Regra] else "Não identificada",
		    // cidade: trecho antes de "/UF", depois do último " - " e sem [prefixo]
		    Cidade = if U[Regra] <> "sigla após /" then "" else
		        let antes = Text.BeforeDelimiter(unidade, "/", {0, RelativePosition.FromEnd}),
		            ult = if Text.Contains(antes, " - ") then Text.AfterDelimiter(antes, " - ", {0, RelativePosition.FromEnd}) else antes,
		            limpo = Text.Trim(if Text.Contains(ult, "]") then Text.AfterDelimiter(ult, "]", {0, RelativePosition.FromEnd}) else ult, {" ", "-", "–"})
		        in Text.Proper(limpo)
		in
		    [UF = UF, Estado = if UF = "" then "" else Record.Field(Estados, UF), Cidade = Cidade, Origem = Origem]
	lineageTag: 6abf9425-01f5-5f2f-ad05-d9a7b25cd1b7

