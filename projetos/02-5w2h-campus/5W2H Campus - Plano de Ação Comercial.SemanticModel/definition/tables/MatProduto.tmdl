	partition MatProduto = m
		mode: import
		source =
				let
				    A = #"Ações Expandidas",
				    // uma linha por ação × produto (ou modalidade): 1 item = total da ação; 2+ itens = abertura {M|R}{Ins|Mat}_{chave}; sem item = "Não informado"
				    L = Table.AddColumn(A, "P", (a) =>
				        let
				            ks = a[ListaProdutos],
				            base = [IdSemana = a[IdSemana], IdAção = a[IdAcao], #"Data Início" = a[DataInicio], #"Data Fim" = a[Fim], #"Dias Válidos" = List.Max({1, List.Count(a[DiasAcao])})],
				            campo = (pre, k) => Record.FieldOrDefault(a, pre & "_" & k, null),
				            temAbertura = List.AnyTrue(List.Transform(ks, (k) => campo("MMat", k) <> null or campo("RMat", k) <> null or campo("MIns", k) <> null or campo("RIns", k) <> null)),
				            total = (k) => base & [Produto = k, #"Meta INS" = a[MetaInscritos], #"Real INS" = a[RealInscritos], #"Meta MAT" = a[MetaMatriculas], #"Real MAT" = a[RealMatriculas]],
				            zero = (v) => if v = null then 0 else v
				        in
				            if List.Count(ks) = 1 then {total(ks{0})}
				            else if List.Count(ks) >= 2 and temAbertura then
				                List.Transform(ks, (k) => base & [Produto = k, #"Meta INS" = zero(campo("MIns", k)), #"Real INS" = campo("RIns", k),
				                                                    #"Meta MAT" = zero(campo("MMat", k)), #"Real MAT" = campo("RMat", k)])
				            else {total("NaoInformado")}),
				    Tabela = Table.FromRecords(List.Combine(L[P]), {"IdSemana", "IdAção", "Produto", "Meta INS", "Real INS", "Meta MAT", "Real MAT", "Data Início", "Data Fim", "Dias Válidos"},
				        MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Tabela, {{"IdSemana", Int64.Type}, {"IdAção", Int64.Type}, {"Produto", type text}, {"Meta INS", type number}, {"Real INS", type number},
				        {"Meta MAT", type number}, {"Real MAT", type number}, {"Data Início", type date}, {"Data Fim", type date}, {"Dias Válidos", Int64.Type}})
				in
				    Tipos

	annotation PBI_ResultType = Table

