	column 'Meta INS Dia'
		dataType: double
		isHidden
		formatString: #,0.00
		lineageTag: 1feb6f1c-3d2b-5f3f-93e0-790a1ab58c90
		summarizeBy: sum
		sourceColumn: Meta INS Dia

		annotation SummarizationSetBy = Automatic

	column 'Tem Ação'
		dataType: boolean
		isHidden
		lineageTag: d711b4c8-1b58-5751-ab78-93cd49daddd1
		summarizeBy: none
		sourceColumn: Tem Ação

		annotation SummarizationSetBy = Automatic

	partition Dias = m
		mode: import
		source =
				let
				    S = #"Semanas Base",
				    Nomes = {"Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"},
				    L = Table.AddColumn(S, "D", (r) =>
				        let
				            acs = Table.ToRecords(r[Acoes]),
				            semana = r[DiasLista],
				            diasAcao = (a) => let ds = List.Select(DiasUteis(a[DataInicio], a[Fim]), each List.Contains(semana, _)) in if List.IsEmpty(ds) then semana else ds,
				            metaDia = (d as date) as number => List.Sum({0} & List.Transform(acs, (a) => let ds = diasAcao(a) in if List.Contains(ds, d) then a[MetaInscritos] / List.Count(ds) else 0)),
				            insDia = (d as date) as number => List.Sum({0} & List.Transform(acs, (a) => let ds = diasAcao(a), v = a[RealInscritos] in if v <> null and ds{0} = d then v else 0))
				        in
				            List.Transform(semana, (d) => [IdSemana = r[IdSemana], Data = d, #"Nº Dia" = Date.DayOfWeek(d, Day.Monday) + 1,
				                #"Dia da Semana" = Nomes{Date.DayOfWeek(d, Day.Monday)}, Foi = "", INS = insDia(d), Motivo = "", #"Meta INS Dia" = metaDia(d),
				                #"Tem Ação" = not List.IsEmpty(acs)])),
				    Tabela = Table.FromRecords(List.Combine(L[D]), {"IdSemana", "Data", "Nº Dia", "Dia da Semana", "Foi", "INS", "Motivo", "Meta INS Dia", "Tem Ação"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Tabela, {{"IdSemana", Int64.Type}, {"Data", type date}, {"Nº Dia", Int64.Type}, {"Dia da Semana", type text}, {"Foi", type text},
				        {"INS", type number}, {"Motivo", type text}, {"Meta INS Dia", type number}, {"Tem Ação", type logical}})
				in
				    Tipos

	annotation PBI_ResultType = Table

