	column 'Dias Válidos'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 15feadf8-6921-5311-925d-bbc3f7636d8c
		summarizeBy: none
		sourceColumn: Dias Válidos

		annotation SummarizationSetBy = Automatic

	partition Ações = m
		mode: import
		source =
				let
				    A = #"Ações Expandidas",
				    Nomes = {"Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"},
				    C1 = Table.AddColumn(A, "Dias Programados", each Text.Combine(List.Transform([DiasAcao], (d) => Nomes{Date.DayOfWeek(d, Day.Monday)} & " " & Date.ToText(d, [Format = "dd/MM"])), ", "), type text),
				    C2 = Table.AddColumn(C1, "Nº Dias Programados", each List.Count([DiasAcao]), Int64.Type),
				    C3 = Table.AddColumn(C2, "Tipo", each if [TipoAcao] = "" then "(tipo não informado)" else [TipoAcao], type text),
				    C4 = Table.AddColumn(C3, "Produtos da Ação", each Text.Combine(List.Transform([ListaProdutos], (k) => Record.Field([Grad = "Graduação", Pos = "Pós-graduação", Tec = "Técnico", Prof = "Profissionalizante"], k)), ", "), type text),
				    C5a = Table.AddColumn(C4, "Modalidades da Ação", each Text.Combine(List.Transform([ListaModalidades], (k) => Record.Field([Pres = "Presencial", Semi = "Semipresencial", EAD = "EAD"], k)), ", "), type text),
				    // quem cadastrou: pelo e-mail (API) ou pelo nome (exportação), comparado com o consultor e o coordenador gravados na ação
				    Igual = (a as nullable text, b as nullable text) as logical => a <> null and b <> null and Text.Trim(a) <> "" and Text.Lower(Text.Trim(a)) = Text.Lower(Text.Trim(b)),
				    C5b = Table.AddColumn(C5a, "Cadastrado por", each
				        if [CriadoPorEmail] = "" and [CriadoPorNome] = "" then "Não informado"
				        else if Igual([CriadoPorEmail], [EmailConsultor]) or Igual([CriadoPorNome], [Consultor]) then "Consultor"
				        else if Igual([CriadoPorEmail], [EmailCoordenador]) or Igual([CriadoPorNome], [Coordenador]) then "Coordenador"
				        else "Outra pessoa", type text),
				    // rito: a ação deve ser cadastrada até o dia de início
				    C5 = Table.AddColumn(C5b, "Prazo do Cadastro", each if [Criado] = null then "Sem data" else if [Criado] <= [DataInicio] then "No prazo" else "Após o início", type text),
				    C6 = Table.AddColumn(C5, "Objetivo da Ação", each
				        let o = Text.Lower([Objetivo]) in if Text.Contains(o, "convers") or Text.Contains(o, "matr") then "Conversão (matrículas)"
				        else if Text.Contains(o, "capta") or Text.Contains(o, "inscr") then "Captação (inscritos)" else "Não informado", type text),
				    Final = Table.SelectColumns(C6, {"IdAcao", "IdSemana", "NumAcao", "Titulo", "Tipo", "Alavanca", "Local", "Como", "StatusN", "Dias Programados", "Nº Dias Programados",
				        "Produtos da Ação", "Modalidades da Ação", "MetaInscritos", "MetaMatriculas", "RealInscritos", "RealMatriculas", "CustoPrevisto", "CustoRealizado",
				        "Objetivo da Ação", "Cadastrado por", "CriadoPorNome", "Prazo do Cadastro", "TemFechamento",
				        "DataInicio", "Fim", "Observacoes", "Criado"}),
				    Nomes2 = Table.RenameColumns(Final, {{"IdAcao", "IdAção"}, {"NumAcao", "Nº Ação"}, {"Titulo", "Título"}, {"Como", "Como Será Feita"}, {"StatusN", "Status"},
				        {"MetaInscritos", "Meta INS"}, {"MetaMatriculas", "Meta MAT"}, {"RealInscritos", "Real INS"}, {"RealMatriculas", "Real MAT"},
				        {"CustoPrevisto", "Custo Previsto"}, {"CustoRealizado", "Custo Realizado"}, {"CriadoPorNome", "Criado por"}, {"TemFechamento", "Tem Fechamento"}, {"DataInicio", "Data Início"}, {"Fim", "Data Fim"}, {"Observacoes", "Observações"}, {"Criado", "Criado em"}}),
				    ComDiasUteis = Table.AddColumn(Nomes2, "Dias Válidos", each List.Max({1, [Nº Dias Programados]}), Int64.Type),
				    Tipos = Table.TransformColumnTypes(ComDiasUteis, {{"IdAção", Int64.Type}, {"IdSemana", Int64.Type}, {"Nº Ação", Int64.Type}, {"Meta INS", type number},
				        {"Meta MAT", type number}, {"Real INS", type number}, {"Real MAT", type number}, {"Custo Previsto", type number}, {"Custo Realizado", type number},
				        {"Tem Fechamento", type logical}, {"Data Início", type date}, {"Data Fim", type date}, {"Criado em", type date}, {"Dias Válidos", Int64.Type}})
				in
				    Tipos

	annotation PBI_ResultType = Table

