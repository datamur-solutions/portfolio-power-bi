	partition Consultores = m
		mode: import
		source =
				let
				    C = #"Consultores Base",
				    Final = Table.SelectColumns(C, {"Chave", "Matricula", "Nome", "EmailConsultor", "Funcao", "Situacao", "Unidade", "Filial", "Regional", "Coordenador", "EmailCoordenador",
				        "Gerente", "EmailGerente", "Ativo"}),
				    Nomes = Table.RenameColumns(Final, {{"Matricula", "Matrícula"}, {"Nome", "Consultor (cadastro)"}, {"EmailConsultor", "Email Consultor"}, {"Funcao", "Função (cadastro)"},
				        {"Situacao", "Situação (cadastro)"}, {"Unidade", "Unidade atual"}, {"Filial", "Filial atual"}, {"Regional", "Regional atual"}, {"Coordenador", "Coordenador atual"},
				        {"EmailCoordenador", "Email Coordenador"}, {"Gerente", "Gerente atual"}, {"EmailGerente", "Email Gerente"}, {"Ativo", "Ativo"}}),
				    Minusculas = Table.TransformColumns(Nomes, {{"Email Consultor", Text.Lower, type text}, {"Email Coordenador", Text.Lower, type text}, {"Email Gerente", Text.Lower, type text}}),
				    Tipos = Table.TransformColumnTypes(Minusculas, {{"Ativo", type logical}})
				in
				    Tipos

	annotation PBI_ResultType = Table

