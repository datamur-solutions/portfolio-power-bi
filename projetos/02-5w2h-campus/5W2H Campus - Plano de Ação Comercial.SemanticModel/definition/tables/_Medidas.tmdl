			RETURN IF ( NOT ISBLANK ( fim ), COUNTROWS ( F ) + 0 )
		formatString: #,0
		displayFolder: 0b · Projeção e realizado
		lineageTag: 1a4eb774-3601-52a0-bd1c-70f01e9dc897

	/// Meta de matrículas das ações com objetivo de conversão.
	measure 'Projeção MAT Conversão' =
			VAR i = [Data Início]
			VAR fim = [Data Fim Período]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Início] >= i && 'Ações'[Data Início] <= fim && ( 'Ações'[Objetivo da Ação] = "Conversão (matrículas)" ) )
			VAR ids = SELECTCOLUMNS ( F, "id", 'Ações'[IdAção] )
			RETURN IF ( NOT ISBLANK ( fim ),
			    SWITCH ( TRUE (),
			        ISFILTERED ( dProduto ), CALCULATE ( SUM ( MatProduto[Meta MAT] ), TREATAS ( ids, MatProduto[IdAção] ) ),
			        ISFILTERED ( dModalidade ), CALCULATE ( SUM ( MatModalidade[Meta MAT] ), TREATAS ( ids, MatModalidade[IdAção] ) ),
			        SUMX ( F, 'Ações'[Meta MAT] ) ) )
		formatString: #,0
		displayFolder: 0b · Projeção e realizado
		lineageTag: 9922562a-6a19-574c-bb08-d1c039049a28

	measure 'Realizado MAT Conversão' =
