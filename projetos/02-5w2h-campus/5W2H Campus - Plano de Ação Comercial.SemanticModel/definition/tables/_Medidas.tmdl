	/// Realizado ÷ projeção de inscritos das ações finalizadas.
	measure 'Atingimento INS' = DIVIDE ( [Realizado INS], [Projeção INS Fechadas] )
		formatString: 0%
		displayFolder: 0b · Projeção e realizado
		lineageTag: f9dea18b-f1ac-5168-a512-f924acd9bb4a

	/// Projeção de matrículas: soma da meta de matrículas cadastrada nas ações do período.
	measure 'Projeção MAT' =
			
			VAR i = [Data Início]
			VAR fim = [Data Fim Período]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Início] >= i && 'Ações'[Data Início] <= fim )
			RETURN SUMX ( F, MIN ( COALESCE ( 'Ações'[Meta MAT], 0 ), COALESCE ( 'Ações'[Meta INS], 0 ) ) )
		formatString: #,0
		displayFolder: 0b · Projeção e realizado
		lineageTag: e2ced165-b7ad-5d3c-8b1a-ca2918fc0e66

