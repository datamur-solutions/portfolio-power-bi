	/// Custo previsto das ações do período.
	measure 'Custo Previsto' =
			VAR i = [Data Início]
			VAR fim = [Data Fim Período]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Início] >= i && 'Ações'[Data Início] <= fim && ( TRUE () ) )
			RETURN IF ( NOT ISBLANK ( fim ), SUMX ( F, 'Ações'[Custo Previsto] ) )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
