	/// Matrículas realizadas ÷ inscritos realizados.
	measure 'Conversão Realizada' =
			
			VAR i = [Data Início]
			VAR fim = [Data Fim Período]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Início] >= i && 'Ações'[Data Início] <= fim )
			RETURN DIVIDE ( SUMX ( F, MIN ( COALESCE ( 'Ações'[Real MAT], 0 ), COALESCE ( 'Ações'[Real INS], 0 ) ) ), SUMX ( F, 'Ações'[Real INS] ) )
		formatString: 0.0%
