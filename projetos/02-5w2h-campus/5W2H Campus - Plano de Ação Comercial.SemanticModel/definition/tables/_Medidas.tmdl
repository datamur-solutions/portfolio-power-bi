	/// Consultores ativos no cadastro (Consultores 5W2H) na seleção.
	measure 'HC Ativo' = CALCULATE ( DISTINCTCOUNT ( Semanas[Chave Consultor] ), Semanas[Ativo] = TRUE () )
		formatString: #,0
		displayFolder: 4 · Plano e execução
		lineageTag: 932eb700-602f-5ca4-a499-f268be536416

	/// Consultores ativos com pelo menos uma ação já iniciada no período (Início até a data de corte e Fim a partir do início do período).
	measure 'Consultores em Ação' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR f = [Data Fim Período]
			VAR t = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( Semanas[Chave Consultor] ), Semanas[Ativo] = TRUE () ),
			    "@ini", CALCULATE ( COUNTROWS ( 'Ações' ), 'Ações'[Data Início] <= c, 'Ações'[Data Fim] >= i ) + 0,
			    "@fut", CALCULATE ( COUNTROWS ( 'Ações' ), 'Ações'[Data Início] > c, 'Ações'[Data Início] <= f ) + 0 )
			RETURN IF ( NOT ISBLANK ( c ), COUNTROWS ( FILTER ( t, [@ini] > 0 ) ) + 0 )
		formatString: #,0
		displayFolder: 4b · Equipe em ação
		lineageTag: 23f6c005-7ce6-582e-ae40-00fe06acfaf2

	/// Consultores ativos sem ação iniciada, mas com ação cadastrada para depois da data de corte, dentro do período.
	measure 'Consultores só com Ação Futura' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR f = [Data Fim Período]
			VAR t = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( Semanas[Chave Consultor] ), Semanas[Ativo] = TRUE () ),
			    "@ini", CALCULATE ( COUNTROWS ( 'Ações' ), 'Ações'[Data Início] <= c, 'Ações'[Data Fim] >= i ) + 0,
			    "@fut", CALCULATE ( COUNTROWS ( 'Ações' ), 'Ações'[Data Início] > c, 'Ações'[Data Início] <= f ) + 0 )
			RETURN IF ( NOT ISBLANK ( c ), COUNTROWS ( FILTER ( t, [@ini] = 0 && [@fut] > 0 ) ) + 0 )
		formatString: #,0
		displayFolder: 4b · Equipe em ação
		lineageTag: 0d0e573f-34ac-526a-be97-87b9cc4af93b

	/// Consultores ativos sem nenhuma ação no período (nem iniciada, nem programada).
	measure 'Consultores sem Ação' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR f = [Data Fim Período]
			VAR t = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( Semanas[Chave Consultor] ), Semanas[Ativo] = TRUE () ),
			    "@ini", CALCULATE ( COUNTROWS ( 'Ações' ), 'Ações'[Data Início] <= c, 'Ações'[Data Fim] >= i ) + 0,
			    "@fut", CALCULATE ( COUNTROWS ( 'Ações' ), 'Ações'[Data Início] > c, 'Ações'[Data Início] <= f ) + 0 )
			RETURN IF ( NOT ISBLANK ( c ), COUNTROWS ( FILTER ( t, [@ini] = 0 && [@fut] = 0 ) ) + 0 )
		formatString: #,0
		displayFolder: 4b · Equipe em ação
		lineageTag: 192d8306-79ac-52b1-900e-927bfd8815e9

	/// Consultores ativos com ação iniciada ÷ consultores ativos. Referência 90%.
	measure '% Equipe em Ação' = DIVIDE ( [Consultores em Ação], [HC Ativo] )
