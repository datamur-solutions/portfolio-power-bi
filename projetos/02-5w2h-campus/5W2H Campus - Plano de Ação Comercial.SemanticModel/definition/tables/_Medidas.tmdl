	measure 'Projeção Simulada' =
			VAR p = [Pace INS]
			RETURN IF ( NOT ISBLANK ( p ), COALESCE ( [INS Realizado], 0 ) + MAX ( 0, [Meta INS Período] - [INS Ideal] ) * p * ( 1 + [Ganho de Ritmo] ) )
		formatString: #,0
		displayFolder: 5 · Simulador
		lineageTag: ebf8be01-44f6-5828-96c3-d4d5b5c7bf69

	measure 'Projeção Simulada % Meta' = DIVIDE ( [Projeção Simulada], [Meta INS Período] )
		formatString: 0%
		displayFolder: 5 · Simulador
		lineageTag: 388c3d97-4662-5fb1-b0be-f78f13601ea6

	measure 'Diferença Simulada' = [Projeção Simulada] - [Meta INS Período]
		formatString: +#,0;-#,0;0
		displayFolder: 5 · Simulador
		lineageTag: d859e157-98df-59ff-8cb8-3e419f9e2027

	/// Quanto o ritmo dos dias restantes precisa subir para fechar 100% da meta.
	measure 'Ganho Necessário' =
			VAR resto = MAX ( 0, [Meta INS Período] - [INS Ideal] ) * [Pace INS]
			RETURN IF ( resto > 0, DIVIDE ( [Meta INS Período] - COALESCE ( [INS Realizado], 0 ), resto ) - 1 )
		formatString: +0%;-0%;0%
		displayFolder: 5 · Simulador
		lineageTag: d6ffdede-48ac-5efb-9984-85c2cc005be5

	measure 'INS Realizado Acumulado' =
			VAR d = MAX ( dCalendario[Data] )
			VAR i = [Data Início]
			VAR c = [Data Corte]
			RETURN IF ( NOT ISBLANK ( c ) && d >= i && d <= c,
			    CALCULATE ( SUM ( Dias[INS] ), REMOVEFILTERS ( dCalendario ), Dias[Data] >= i, Dias[Data] <= d ) + 0 )
		formatString: #,0
		displayFolder: 6 · Curva diária
		lineageTag: 976276e8-6af3-5ef5-8131-acd51bbdeb76

	measure 'Pace Ideal Acumulado' =
			VAR d = MAX ( dCalendario[Data] )
			VAR i = [Data Início]
			VAR f = [Data Fim Período]
			RETURN IF ( d >= i && d <= f, CALCULATE ( SUM ( Dias[Meta INS Dia] ), REMOVEFILTERS ( dCalendario ), Dias[Data] >= i, Dias[Data] <= d ) )
		formatString: #,0
		displayFolder: 6 · Curva diária
		lineageTag: 5c88f877-0888-5ea9-971a-c6979c4776c9

	measure 'Projeção Acumulada' =
			VAR d = MAX ( dCalendario[Data] )
			VAR c = [Data Corte]
			VAR f = [Data Fim Período]
			VAR p = CALCULATE ( [Pace INS], ALLSELECTED ( dCalendario ) )
			VAR realC = CALCULATE ( [INS Realizado], ALLSELECTED ( dCalendario ) )
			VAR idealC = CALCULATE ( [INS Ideal], ALLSELECTED ( dCalendario ) )
			RETURN IF ( NOT ISBLANK ( p ) && d >= c && d <= f, realC + ( [Pace Ideal Acumulado] - idealC ) * p )
		formatString: #,0
		displayFolder: 6 · Curva diária
		lineageTag: 07a43548-b418-5c75-a7be-5505c1844b00

	measure 'Meta (linha)' =
			VAR d = MAX ( dCalendario[Data] )
			RETURN IF ( d >= [Data Início] && d <= [Data Fim Período], CALCULATE ( [Meta INS Período], ALLSELECTED ( dCalendario ) ) )
		formatString: #,0
		displayFolder: 6 · Curva diária
		lineageTag: 9ef0d409-edb1-56b1-a55c-f956eb689888

	measure 'INS no Dia' =
			VAR d = MAX ( dCalendario[Data] )
			RETURN IF ( d <= [Data Corte], SUM ( Dias[INS] ) + 0 )
		formatString: #,0
		displayFolder: 6 · Curva diária
		lineageTag: 5345bd9e-d4c4-5274-8fd1-db17eaae12f0

	measure 'Pace do Dia' = SUM ( Dias[Meta INS Dia] )
