	measure 'Situação na Equipe' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR f = [Data Fim Período]
			VAR ativo = CALCULATE ( COUNTROWS ( Semanas ), Semanas[Ativo] = TRUE () ) > 0
			VAR ini = CALCULATE ( COUNTROWS ( 'Ações' ), 'Ações'[Data Início] <= c, 'Ações'[Data Fim] >= i ) + 0
			VAR fut = CALCULATE ( COUNTROWS ( 'Ações' ), 'Ações'[Data Início] > c, 'Ações'[Data Início] <= f ) + 0
			RETURN IF ( NOT ISBLANK ( c ) && HASONEVALUE ( Semanas[Chave Consultor] ) && ativo,
			    SWITCH ( TRUE (), ini > 0, "Em ação", fut > 0, "Só ação futura", "Sem ação no período" ) )
		displayFolder: 4b · Equipe em ação
		lineageTag: f2a4efd3-a75f-5465-81b2-363c493c8434

	/// Situação só dos consultores ativos que ainda não estão em ação (vazio para os demais).
	measure 'Pendência na Equipe' =
			VAR s = [Situação na Equipe]
			RETURN IF ( NOT ISBLANK ( s ) && s <> "Em ação", s )
		displayFolder: 4b · Equipe em ação
		lineageTag: 721992b1-4c43-51bf-b1d0-487a14443516

	measure 'Próxima Ação' =
			VAR c = [Data Corte]
			RETURN IF ( NOT ISBLANK ( [Pendência na Equipe] ), CALCULATE ( MIN ( 'Ações'[Data Início] ), 'Ações'[Data Início] > c ) )
		formatString: dd/MM/yyyy
		displayFolder: 4b · Equipe em ação
		lineageTag: 939ce9ca-daf2-599a-9967-a8215a1d8492

	measure 'Ações Futuras Pendentes' =
			VAR c = [Data Corte]
			RETURN IF ( NOT ISBLANK ( [Pendência na Equipe] ), CALCULATE ( COUNTROWS ( 'Ações' ), 'Ações'[Data Início] > c ) + 0 )
		formatString: #,0
		displayFolder: 4b · Equipe em ação
		lineageTag: 508df70c-824d-5c40-b8ed-fd30baa433ba

	measure 'Cor Situação na Equipe' = SWITCH ( [Situação na Equipe], "Em ação", "#157A45", "Só ação futura", "#A86E00", "Sem ação no período", "#B8322B" )
		displayFolder: 4b · Equipe em ação
		lineageTag: 6137af0f-32dd-5e9e-8a87-32e7ee5390a3

	/// Semanas já iniciadas de consultores ativos sem ação cadastrada.
	measure 'Semanas sem Ação' = CALCULATE ( COUNTROWS ( Semanas ), Semanas[Tem Ação] = FALSE (), Semanas[Ativo] = TRUE (), Semanas[Data Início] <= [Data Corte] ) + 0
