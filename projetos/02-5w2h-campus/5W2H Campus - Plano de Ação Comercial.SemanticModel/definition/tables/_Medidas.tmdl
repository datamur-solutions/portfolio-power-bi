table _Medidas
	lineageTag: 8993fbf2-78c0-5e35-bbf8-ccdc4ac10cf9

	/// Primeiro dia do período analisado: início do mês filtrado ou a data inicial escolhida.
	measure 'Data Início' =
			VAR meses = CALCULATETABLE ( VALUES ( Semanas[Mês] ), ALLSELECTED () )
			VAR semMin = CALCULATE ( MIN ( Semanas[Data Início] ), REMOVEFILTERS (), TREATAS ( meses, Semanas[Mês] ) )
			VAR selMin = CALCULATE ( MIN ( dCalendario[Data] ), ALLSELECTED ( dCalendario ) )
			RETURN MAX ( semMin, selMin )
		formatString: dd/MM/yyyy
		displayFolder: 0 · Janela de datas
		lineageTag: 91b8828c-a550-5190-be7f-1b4431fbf232

	/// Último dia útil (seg a sáb) do mês filtrado.
	measure 'Data Fim Período' =
			VAR meses = CALCULATETABLE ( VALUES ( Semanas[Mês] ), ALLSELECTED () )
			RETURN CALCULATE ( MAX ( Semanas[Data Fim] ), REMOVEFILTERS (), TREATAS ( meses, Semanas[Mês] ) )
		formatString: dd/MM/yyyy
		displayFolder: 0 · Janela de datas
		lineageTag: ef951758-c43f-5b5a-a2a3-fc46ffe3588d

	/// Hoje (horário de São Paulo) ou a DataReferencia, limitada à data final do período filtrado. Ações com Data Fim anterior a ela estão vencidas.
	measure 'Data Corte' =
			VAR i = [Data Início]
			VAR f = [Data Fim Período]
			// data de referência do parâmetro DataReferencia (fixa em 23/10/2026 no portfólio)
			VAR hoje = COALESCE ( MAX ( Config[Data de Referência] ), DATE ( 2026, 10, 23 ) )
			VAR selMax = CALCULATE ( MAX ( dCalendario[Data] ), ALLSELECTED ( dCalendario ) )
			VAR lim = MIN ( MIN ( selMax, f ), hoje )
			RETURN CALCULATE ( MAX ( dCalendario[Data] ), REMOVEFILTERS ( dCalendario ), dCalendario[Data] >= i, dCalendario[Data] <= lim )
		formatString: dd/MM/yyyy
		displayFolder: 0 · Janela de datas
		lineageTag: 576229da-7272-5620-8792-94b8f1f91112

	measure 'Dias Corridos' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			RETURN IF ( ISBLANK ( c ), 0, COUNTROWS ( FILTER ( ALL ( dCalendario[Data] ), dCalendario[Data] >= i && dCalendario[Data] <= c ) ) )
		formatString: 0
		displayFolder: 0 · Janela de datas
		lineageTag: d40a262c-611b-5f2e-b00b-6c5192a13813

	measure 'Dias Restantes' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR f = [Data Fim Período]
			RETURN COUNTROWS ( FILTER ( ALL ( dCalendario[Data] ), dCalendario[Data] >= i && dCalendario[Data] <= f && ( ISBLANK ( c ) || dCalendario[Data] > c ) ) ) + 0
		formatString: 0
		displayFolder: 0 · Janela de datas
		lineageTag: 9f788164-2d02-5b4c-81a2-e0d89c43c008

	/// Inscritos registrados do início do período até a data de corte.
	measure 'INS Realizado' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			RETURN
			    IF ( NOT ISBLANK ( c ), CALCULATE ( SUM ( Dias[INS] ), KEEPFILTERS ( Dias[Data] >= i ), KEEPFILTERS ( Dias[Data] <= c ) ) )
		formatString: #,0
		displayFolder: 1 · INS e pace
		lineageTag: 5bffc3fa-d53c-5f17-845a-5cb0292bc636

	/// Meta de INS das semanas, proporcional aos dias do período.
	measure 'Meta INS Período' =
			VAR i = [Data Início]
			VAR f = [Data Fim Período]
			RETURN CALCULATE ( SUM ( Dias[Meta INS Dia] ), REMOVEFILTERS ( dCalendario ), Dias[Data] >= i, Dias[Data] <= f )
		formatString: #,0
		displayFolder: 1 · INS e pace
		lineageTag: ebb66ae9-e972-55de-a273-ace183f0829f

	/// Pace ideal: meta semanal distribuída por dia (seg a sáb), acumulada até a data de corte.
	measure 'INS Ideal' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			RETURN
			    IF ( NOT ISBLANK ( c ), CALCULATE ( SUM ( Dias[Meta INS Dia] ), KEEPFILTERS ( Dias[Data] >= i ), KEEPFILTERS ( Dias[Data] <= c ) ) )
		formatString: #,0
		displayFolder: 1 · INS e pace
		lineageTag: da990719-db29-50a2-b91d-9746200f7cf8

	/// Razão pace real ÷ pace ideal, usada só para a cor e o status (≥100% no ritmo; 85–99% atenção; <85% crítico). Nos visuais o pace aparece em número.
	measure 'Pace INS' = DIVIDE ( [INS Realizado], [INS Ideal] )
		formatString: 0%
		displayFolder: 1 · INS e pace
		lineageTag: d8b899c8-73b1-52af-9273-3f3a6fdc7120

	/// Realizado − pace ideal. Negativo = atraso.
	measure 'Gap INS' = IF ( [INS Ideal] > 0, COALESCE ( [INS Realizado], 0 ) - [INS Ideal] )
		formatString: +#,0;-#,0;0
		displayFolder: 1 · INS e pace
		lineageTag: 86765f12-28fe-57df-a2bd-02605dae7713

	/// Pace real ÷ pace ideal − 1. Apoio para a leitura; o pace é mostrado em número.
	measure 'Variação Pace INS' = IF ( NOT ISBLANK ( [Pace INS] ), [Pace INS] - 1 )
		formatString: +0%;-0%;0%
		displayFolder: 1 · INS e pace
		lineageTag: 05e14290-86f7-5ea4-aaf8-e4ada08a5e8d

	/// Onde o período fecha mantendo o ritmo atual.
	measure 'Tendência INS' = [Pace INS] * [Meta INS Período]
		formatString: #,0
		displayFolder: 1 · INS e pace
		lineageTag: a389f2fb-3930-5967-91a3-5009fabc1a5d

	measure 'Projeção % Meta' = DIVIDE ( [Tendência INS], [Meta INS Período] )
		formatString: 0%
		displayFolder: 1 · INS e pace
		lineageTag: 0b1fdad9-2a34-5e26-95fe-667196d30bd4

	measure 'Falta INS' = MAX ( 0, [Meta INS Período] - COALESCE ( [INS Realizado], 0 ) )
		formatString: #,0
		displayFolder: 1 · INS e pace
		lineageTag: d685d81d-9771-5636-9ddf-267cee375680

	/// INS por dia corrido.
	measure 'Ritmo Atual' = DIVIDE ( [INS Realizado], [Dias Corridos] )
		formatString: #,0.0
		displayFolder: 1 · INS e pace
		lineageTag: 44cf7a81-403b-54d9-824a-a791e26e42a7

	/// (Meta − realizado) ÷ dias restantes.
	measure 'INS por Dia Necessário' = DIVIDE ( [Falta INS], [Dias Restantes] )
		formatString: #,0.0
		displayFolder: 1 · INS e pace
		lineageTag: 3ed55310-1d2f-580b-9b13-760cbff3d1a3

	measure 'Aceleração Necessária' = IF ( [Ritmo Atual] > 0, DIVIDE ( [INS por Dia Necessário], [Ritmo Atual] ) - 1 )
		formatString: +0%;-0%;0%
		displayFolder: 1 · INS e pace
		lineageTag: 4745fb55-3f65-5adf-bc3c-1e40b9267104

	measure Consultores = DISTINCTCOUNT ( Semanas[Chave Consultor] )
		formatString: #,0
		displayFolder: 1 · INS e pace
		lineageTag: 0e23eb9a-a741-55b0-aa75-4be93ec7d3a9

	/// INS por dia que cada consultor precisa fazer nos dias restantes.
	measure 'Necessário por Consultor' = DIVIDE ( [INS por Dia Necessário], [Consultores] )
		formatString: #,0.00
		displayFolder: 1 · INS e pace
		lineageTag: e1f27a4c-86c0-5da1-ae4b-fcb063b7dedc

	measure 'INS Médio por Consultor' = DIVIDE ( [INS Realizado], [Consultores] )
		formatString: #,0.0
		displayFolder: 1 · INS e pace
		lineageTag: 3c2a5503-3432-5387-9f77-b22f0c33e45e

	measure 'Meta MAT Período' =
			VAR i = [Data Início]
			VAR f = [Data Fim Período]
			RETURN
			    IF ( NOT ISBLANK ( f ),
			        SWITCH ( TRUE (),
			            ISFILTERED ( dProduto ), SUMX ( MatProduto,
			            MatProduto[Meta MAT]
			                * DIVIDE ( MAX ( 0, NETWORKDAYS ( MAX ( MatProduto[Data Início], i ), MIN ( MatProduto[Data Fim], f ), 11 ) ), MatProduto[Dias Válidos] ) ),
			            ISFILTERED ( dModalidade ), SUMX ( MatModalidade,
			            MatModalidade[Meta MAT]
			                * DIVIDE ( MAX ( 0, NETWORKDAYS ( MAX ( MatModalidade[Data Início], i ), MIN ( MatModalidade[Data Fim], f ), 11 ) ), MatModalidade[Dias Válidos] ) ),
			            SUMX ( 'Ações',
			            'Ações'[Meta MAT]
			                * DIVIDE ( MAX ( 0, NETWORKDAYS ( MAX ( 'Ações'[Data Início], i ), MIN ( 'Ações'[Data Fim], f ), 11 ) ), 'Ações'[Dias Válidos] ) ) ) )
		formatString: #,0
		displayFolder: 2 · MAT
		lineageTag: 62f866a6-165d-554c-9138-353a7cc8fd9f

	measure 'MAT Ideal' =
			VAR i = [Data Início]
			VAR f = [Data Corte]
			RETURN
			    IF ( NOT ISBLANK ( f ),
			        SWITCH ( TRUE (),
			            ISFILTERED ( dProduto ), SUMX ( MatProduto,
			            MatProduto[Meta MAT]
			                * DIVIDE ( MAX ( 0, NETWORKDAYS ( MAX ( MatProduto[Data Início], i ), MIN ( MatProduto[Data Fim], f ), 11 ) ), MatProduto[Dias Válidos] ) ),
			            ISFILTERED ( dModalidade ), SUMX ( MatModalidade,
			            MatModalidade[Meta MAT]
			                * DIVIDE ( MAX ( 0, NETWORKDAYS ( MAX ( MatModalidade[Data Início], i ), MIN ( MatModalidade[Data Fim], f ), 11 ) ), MatModalidade[Dias Válidos] ) ),
			            SUMX ( 'Ações',
			            'Ações'[Meta MAT]
			                * DIVIDE ( MAX ( 0, NETWORKDAYS ( MAX ( 'Ações'[Data Início], i ), MIN ( 'Ações'[Data Fim], f ), 11 ) ), 'Ações'[Dias Válidos] ) ) ) )
		formatString: #,0
		displayFolder: 2 · MAT
		lineageTag: e935e2e2-e118-5f5c-b5a1-e9924057ccef

	/// Matrículas realizadas das ações já iniciadas até a data de corte. Sem filtro de produto/modalidade usa o total da ação; com filtro, a abertura.
	measure 'MAT Realizado' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			RETURN
			    IF ( NOT ISBLANK ( c ),
			        SWITCH ( TRUE (),
			            ISFILTERED ( dProduto ), SUMX ( FILTER ( MatProduto, MatProduto[Data Início] <= c && MatProduto[Data Fim] >= i ), MatProduto[Real MAT] ),
			            ISFILTERED ( dModalidade ), SUMX ( FILTER ( MatModalidade, MatModalidade[Data Início] <= c && MatModalidade[Data Fim] >= i ), MatModalidade[Real MAT] ),
			            SUMX ( FILTER ( 'Ações', 'Ações'[Data Início] <= c && 'Ações'[Data Fim] >= i ), 'Ações'[Real MAT] ) ) )
		formatString: #,0
		displayFolder: 2 · MAT
		lineageTag: 036d60fe-3fea-5dfa-9cd0-4001f9cd540b

	measure 'Pace MAT' = DIVIDE ( [MAT Realizado], [MAT Ideal] )
		formatString: 0%
		displayFolder: 2 · MAT
		lineageTag: 0a832693-291b-52be-9ea9-e96b56c91c2f

	measure 'Gap MAT' = IF ( [MAT Ideal] > 0, COALESCE ( [MAT Realizado], 0 ) - [MAT Ideal] )
		formatString: +#,0;-#,0;0
		displayFolder: 2 · MAT
		lineageTag: 19c156cc-f385-5776-8ff9-17e9990c8398

	measure 'Tendência MAT' = [Pace MAT] * [Meta MAT Período]
		formatString: #,0
		displayFolder: 2 · MAT
		lineageTag: ba8fc056-9211-57ab-b17f-b42ddd223f53

	measure 'Projeção % Meta MAT' = DIVIDE ( [Tendência MAT], [Meta MAT Período] )
		formatString: 0%
		displayFolder: 2 · MAT
		lineageTag: cae27ad2-b6ca-51db-bd45-cc97d6bdd16a

	/// Para gráficos por semana.
	measure 'Meta MAT Semana' = SWITCH ( TRUE (), ISFILTERED ( dProduto ), SUM ( MatProduto[Meta MAT] ), ISFILTERED ( dModalidade ), SUM ( MatModalidade[Meta MAT] ), SUM ( 'Ações'[Meta MAT] ) )
		formatString: #,0
		displayFolder: 2 · MAT
		lineageTag: e179af5e-eee3-5313-80eb-c3b83cf3d900

	/// Para gráficos por semana.
	measure 'MAT Realizado Semana' = SWITCH ( TRUE (), ISFILTERED ( dProduto ), SUM ( MatProduto[Real MAT] ), ISFILTERED ( dModalidade ), SUM ( MatModalidade[Real MAT] ), SUM ( 'Ações'[Real MAT] ) )
		formatString: #,0
		displayFolder: 2 · MAT
		lineageTag: 195d7d28-47a1-5d05-88e5-1fe93f010125

	/// Conversão de inscritos em matrículas.
	measure 'MAT a cada 100 INS' = DIVIDE ( [MAT Realizado], [INS Realizado] ) * 100
		formatString: #,0.0
		displayFolder: 3 · Funil e conversão
		lineageTag: 469ab94f-c0e1-5436-83c9-93b9a9401ed3

	/// Curva de Pareto: use com Semanas[Consultor] ordenado por INS.
	measure '% Acumulado INS' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR cur = [INS Realizado] + 0
			VAR t = ADDCOLUMNS ( ALLSELECTED ( Semanas[Consultor] ), "@i", CALCULATE ( SUM ( Dias[INS] ), Dias[Data] >= i, Dias[Data] <= c ) + 0 )
			VAR tot = SUMX ( t, [@i] )
			RETURN IF ( NOT ISBLANK ( c ), DIVIDE ( SUMX ( FILTER ( t, [@i] >= cur ), [@i] ), tot ) )
		formatString: 0%
		displayFolder: 3 · Funil e conversão
		lineageTag: a40cfa5f-8b49-5416-add7-5348dd6bc6f0

	/// Parcela dos INS gerada pelos 20% de consultores mais produtivos.
	measure 'Participação Top 20%' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR t = ADDCOLUMNS ( VALUES ( Semanas[Consultor] ), "@i", CALCULATE ( SUM ( Dias[INS] ), Dias[Data] >= i, Dias[Data] <= c ) + 0 )
			VAR k = MAX ( 1, ROUND ( COUNTROWS ( t ) * 0.2, 0 ) )
			RETURN DIVIDE ( SUMX ( TOPN ( k, t, [@i], DESC ), [@i] ), SUMX ( t, [@i] ) )
		formatString: 0%
		displayFolder: 3 · Funil e conversão
		lineageTag: 8f8c077e-7bd1-5493-afbe-3beb5977e2a6

	measure 'Consultores sem INS' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR t = ADDCOLUMNS ( VALUES ( Semanas[Consultor] ), "@i", CALCULATE ( SUM ( Dias[INS] ), Dias[Data] >= i, Dias[Data] <= c ) + 0 )
			RETURN IF ( NOT ISBLANK ( c ), COUNTROWS ( FILTER ( t, [@i] = 0 ) ) + 0 )
		formatString: #,0
		displayFolder: 3 · Funil e conversão
		lineageTag: e4b469d9-2bbc-5c5d-8501-5dc1d656b0fe

	measure 'Total Semanas' = COUNTROWS ( Semanas )
		formatString: #,0
		displayFolder: 4 · Plano e execução
		lineageTag: e08b4650-d582-5067-8ae1-772944348fb1

	measure 'Semanas com Ação' = CALCULATE ( COUNTROWS ( Semanas ), Semanas[Tem Ação] = TRUE () )
		formatString: #,0
		displayFolder: 4 · Plano e execução
		lineageTag: 8c119f36-a039-5143-8408-6996f681eaec

	/// Plano preenchido: unidades com pelo menos uma ação cadastrada no período ÷ unidades com consultor ativo. Referência 90%.
	measure 'Plano Preenchido' = DIVIDE ( [Unidades com Plano], [Unidades Ativas] )
		formatString: 0%
		displayFolder: 4 · Plano e execução
		lineageTag: 082a005c-97b2-5624-a77e-acc0f796d6e3

	/// Ações cadastradas no app (todas, qualquer status).
	measure 'Ações Planejadas' = COUNTROWS ( 'Ações' )
		formatString: #,0
		displayFolder: 4 · Plano e execução
		lineageTag: 28e0b4c2-bff7-5117-9c8d-459d1dabb1d8

	/// Ações cuja semana já começou até a data de corte.
	measure 'Ações Iniciadas' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Início] <= c && 'Ações'[Data Fim] >= i )
			RETURN IF ( NOT ISBLANK ( c ), COUNTROWS ( F ) )
		formatString: #,0
		displayFolder: 4 · Plano e execução
		lineageTag: 0eb61f25-b910-59de-a3da-7e1a62b1f44d

	/// Ações cujo Fim é anterior à data de corte.
	measure 'Ações Vencidas' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Fim] < c && 'Ações'[Data Fim] >= i )
			RETURN IF ( NOT ISBLANK ( c ), COUNTROWS ( F ) )
		formatString: #,0
		displayFolder: 4 · Plano e execução
		lineageTag: 51c68db5-618a-56e8-b339-3a22156cf838

	/// Ações já iniciadas com status de fechamento (Realizada, Realizada parcialmente ou Não realizada).
	measure 'Ações Concluídas' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Início] <= c && 'Ações'[Data Fim] >= i && 'Ações'[Status] <> "Planejada" )
			RETURN IF ( NOT ISBLANK ( c ), COUNTROWS ( F ) )
		formatString: #,0
		displayFolder: 4 · Plano e execução
		lineageTag: e1b50b16-6e93-59f7-88a0-05d5a165705a

	measure 'Ações Realizadas' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Início] <= c && 'Ações'[Data Fim] >= i && 'Ações'[Status] = "Realizada" )
			RETURN IF ( NOT ISBLANK ( c ), COUNTROWS ( F ) )
		formatString: #,0
		displayFolder: 4 · Plano e execução
		lineageTag: d8a7a0e1-05b9-5d84-bf71-baf25fd45642

	measure 'Ações Realizadas Parcialmente' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Início] <= c && 'Ações'[Data Fim] >= i && 'Ações'[Status] = "Realizada parcialmente" )
			RETURN IF ( NOT ISBLANK ( c ), COUNTROWS ( F ) )
		formatString: #,0
		displayFolder: 4 · Plano e execução
		lineageTag: 5744333f-3825-5f7e-9fc7-f433eaa188ef

	measure 'Ações Não Realizadas' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Início] <= c && 'Ações'[Data Fim] >= i && 'Ações'[Status] = "Não realizada" )
			RETURN IF ( NOT ISBLANK ( c ), COUNTROWS ( F ) )
		formatString: #,0
		displayFolder: 4 · Plano e execução
		lineageTag: 812bfdd3-7f4b-5d10-9da4-e44fb90e62d4

	/// Das ações fechadas: (Realizada + ½ Realizada parcialmente) ÷ ações fechadas.
	measure 'Taxa de Realização' = DIVIDE ( COALESCE ( [Ações Realizadas], 0 ) + 0.5 * COALESCE ( [Ações Realizadas Parcialmente], 0 ), [Ações Concluídas] )
		formatString: 0%
		displayFolder: 4 · Plano e execução
		lineageTag: f9f8381d-edd7-5a3a-962c-cf110847ed32

	/// Ações vencidas que continuam com status Planejada (sem fechamento).
	measure 'Ações Atrasadas' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Fim] < c && 'Ações'[Data Fim] >= i && 'Ações'[Status] = "Planejada" )
			RETURN IF ( NOT ISBLANK ( c ), COUNTROWS ( F ) )
		formatString: #,0
		displayFolder: 4 · Plano e execução
		lineageTag: 0d57ed2f-1999-5ac8-a937-bd0e43f920bb

	/// Ações já iniciadas com algum realizado lançado ou status diferente de Planejada.
	measure 'Ações com Fechamento' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Início] <= c && 'Ações'[Data Fim] >= i && 'Ações'[Tem Fechamento] )
			RETURN IF ( NOT ISBLANK ( c ), COUNTROWS ( F ) )
		formatString: #,0
		displayFolder: 4 · Plano e execução
		lineageTag: 5c2d91f8-4eee-51d1-acae-a4fc1b924a69

	/// Conclusão das ações: ações já iniciadas com fechamento (Realizada, Realizada parcialmente ou Não realizada) ÷ ações já iniciadas. Referência 85%.
	measure Execução = DIVIDE ( [Ações Concluídas], [Ações Iniciadas] )
		formatString: 0%
		displayFolder: 4 · Plano e execução
		lineageTag: b582a60e-a0ed-5eb0-b02a-96ddd38bd802

	/// Fechamento lançado: ações já iniciadas com algum realizado (INS, MAT ou leads) ou status diferente de Planejada ÷ ações já iniciadas. Referência 85%.
	measure 'Disciplina de Registro' = DIVIDE ( [Ações com Fechamento], [Ações Iniciadas] )
		formatString: 0%
		displayFolder: 4 · Plano e execução
		lineageTag: c9eef49f-e935-5581-a043-9b61a92e9dc1

	/// Ações vencidas com status de fechamento.
	measure 'Vencidas Fechadas' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Fim] < c && 'Ações'[Data Fim] >= i && 'Ações'[Status] <> "Planejada" )
			RETURN IF ( NOT ISBLANK ( c ), COUNTROWS ( F ) )
		formatString: #,0
		displayFolder: 4d · Ações vencidas
		lineageTag: acd5623a-6d0b-5dc8-8cd8-78c68cf0d936

	/// Ações vencidas fechadas ÷ ações vencidas.
	measure '% Vencidas Fechadas' = DIVIDE ( [Vencidas Fechadas], [Ações Vencidas] )
		formatString: 0%
		displayFolder: 4d · Ações vencidas
		lineageTag: 2367322c-a578-5e7e-9e56-c3ffcb72cd02

	/// Dias, em média, desde o Fim das ações vencidas que continuam como Planejada.
	measure 'Atraso Médio (dias)' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Fim] < c && 'Ações'[Data Fim] >= i && 'Ações'[Status] = "Planejada" )
			RETURN IF ( NOT ISBLANK ( c ), AVERAGEX ( F, INT ( c - 'Ações'[Data Fim] ) ) )
		formatString: #,0.0
		displayFolder: 4d · Ações vencidas
		lineageTag: 1aebd0c6-daea-5d3a-82d4-0bc92f19766c

	/// Dias desde o Fim (só ações vencidas sem fechamento).
	measure 'Dias em Atraso' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Fim] < c && 'Ações'[Data Fim] >= i && 'Ações'[Status] = "Planejada" )
			RETURN IF ( NOT ISBLANK ( c ), MAXX ( F, INT ( c - 'Ações'[Data Fim] ) ) )
		formatString: #,0
		displayFolder: 4d · Ações vencidas
		lineageTag: 50c2c894-2e82-5620-9f13-e02780d3a27b

	/// Meta de INS das ações vencidas sem fechamento: resultado que ainda não foi informado.
	measure 'Meta INS em Atraso' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Fim] < c && 'Ações'[Data Fim] >= i && 'Ações'[Status] = "Planejada" )
			RETURN IF ( NOT ISBLANK ( c ), SUMX ( F, 'Ações'[Meta INS] ) + 0 )
		formatString: #,0
		displayFolder: 4d · Ações vencidas
		lineageTag: 332125df-cbd5-5109-96ac-7794c8f829a4

	measure 'INS das Vencidas' =
			VAR i = [Data Início]
			VAR c = [Data Corte]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Fim] < c && 'Ações'[Data Fim] >= i )
			RETURN IF ( NOT ISBLANK ( c ), SUMX ( F, 'Ações'[Real INS] ) )
		formatString: #,0
		displayFolder: 4d · Ações vencidas
		lineageTag: 9f70754d-6791-5a52-a2af-d713639814f8

	measure 'Leitura Vencidas' =
			VAR v = [Ações Vencidas]
			VAR a = [Ações Atrasadas] + 0
			RETURN IF ( ISBLANK ( v ) || v = 0, "Nenhuma ação vencida até a DT BASE: todas as ações do período ainda estão dentro do prazo.",
			    FORMAT ( v, "#,0" ) & " ações já passaram do Fim. " & FORMAT ( v - a, "#,0" ) & " foram fechadas (" & FORMAT ( DIVIDE ( v - a, v ), "0%" ) & ") e "
			        & FORMAT ( a, "#,0" ) & " seguem como Planejada" & IF ( a > 0, ", com " & FORMAT ( [Meta INS em Atraso], "#,0" ) & " INS de meta sem resultado informado e atraso médio de " & FORMAT ( [Atraso Médio (dias)], "#,0" ) & " dias.", "." ) )
		displayFolder: 4d · Ações vencidas
		lineageTag: fbae9f22-d0d3-55f4-a103-54600296c809

