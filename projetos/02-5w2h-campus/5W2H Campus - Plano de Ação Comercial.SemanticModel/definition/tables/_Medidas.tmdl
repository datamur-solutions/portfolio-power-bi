	/// Custo previsto só das ações que já têm custo realizado (base de comparação).
	measure 'Custo Previsto das Fechadas' =
			VAR i = [Data Início]
			VAR fim = [Data Fim Período]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Início] >= i && 'Ações'[Data Início] <= fim && ( NOT ISBLANK ( 'Ações'[Custo Realizado] ) ) )
			RETURN IF ( NOT ISBLANK ( fim ), SUMX ( F, 'Ações'[Custo Previsto] ) )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 0c · Custo
		lineageTag: fbece1c9-4175-557e-8135-df5d27cd84cb

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Custo realizado − custo previsto das mesmas ações. Positivo = gastou mais que o previsto.
	measure 'Estouro de Custo' = IF ( NOT ISBLANK ( [Custo Realizado] ), [Custo Realizado] - COALESCE ( [Custo Previsto das Fechadas], 0 ) )
		displayFolder: 0c · Custo
