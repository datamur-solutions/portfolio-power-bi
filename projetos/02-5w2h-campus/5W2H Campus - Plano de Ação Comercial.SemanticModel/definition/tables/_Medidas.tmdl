	/// Ações cadastradas no período (Início dentro do período), qualquer status.
	measure 'Ações Cadastradas' =
			VAR i = [Data Início]
			VAR fim = [Data Fim Período]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Início] >= i && 'Ações'[Data Início] <= fim && ( TRUE () ) )
			RETURN IF ( NOT ISBLANK ( fim ), COUNTROWS ( F ) + 0 )
		formatString: #,0
		displayFolder: 0b · Projeção e realizado
		lineageTag: a2423c59-6fde-5a57-b035-eed5b0ee9d95

	/// Projeção de inscritos: soma da meta de inscritos cadastrada nas ações do período.
	measure 'Projeção INS' =
			VAR i = [Data Início]
			VAR fim = [Data Fim Período]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Início] >= i && 'Ações'[Data Início] <= fim && ( TRUE () ) )
			VAR ids = SELECTCOLUMNS ( F, "id", 'Ações'[IdAção] )
			RETURN IF ( NOT ISBLANK ( fim ),
			    SWITCH ( TRUE (),
			        ISFILTERED ( dProduto ), CALCULATE ( SUM ( MatProduto[Meta INS] ), TREATAS ( ids, MatProduto[IdAção] ) ),
			        ISFILTERED ( dModalidade ), CALCULATE ( SUM ( MatModalidade[Meta INS] ), TREATAS ( ids, MatModalidade[IdAção] ) ),
			        SUMX ( F, 'Ações'[Meta INS] ) ) )
		formatString: #,0
		displayFolder: 0b · Projeção e realizado
		lineageTag: c5af81d5-74ff-506d-b40c-92c050dd7d64

	/// Inscritos realizados lançados no fechamento das ações do período.
	measure 'Realizado INS' =
			VAR i = [Data Início]
			VAR fim = [Data Fim Período]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Início] >= i && 'Ações'[Data Início] <= fim && ( TRUE () ) )
			VAR ids = SELECTCOLUMNS ( F, "id", 'Ações'[IdAção] )
			RETURN IF ( NOT ISBLANK ( fim ),
			    SWITCH ( TRUE (),
			        ISFILTERED ( dProduto ), CALCULATE ( SUM ( MatProduto[Real INS] ), TREATAS ( ids, MatProduto[IdAção] ) ),
			        ISFILTERED ( dModalidade ), CALCULATE ( SUM ( MatModalidade[Real INS] ), TREATAS ( ids, MatModalidade[IdAção] ) ),
			        SUMX ( F, 'Ações'[Real INS] ) ) )
		formatString: #,0
		displayFolder: 0b · Projeção e realizado
		lineageTag: cba696af-aa39-5ca6-a8d7-89dedd9395d2

	/// Projeção de inscritos só das ações já finalizadas (com resultado).
	measure 'Projeção INS Fechadas' =
			VAR i = [Data Início]
			VAR fim = [Data Fim Período]
			VAR F = FILTER ( 'Ações', 'Ações'[Data Início] >= i && 'Ações'[Data Início] <= fim && ( 'Ações'[Tem Fechamento] ) )
			VAR ids = SELECTCOLUMNS ( F, "id", 'Ações'[IdAção] )
			RETURN IF ( NOT ISBLANK ( fim ),
			    SWITCH ( TRUE (),
			        ISFILTERED ( dProduto ), CALCULATE ( SUM ( MatProduto[Meta INS] ), TREATAS ( ids, MatProduto[IdAção] ) ),
			        ISFILTERED ( dModalidade ), CALCULATE ( SUM ( MatModalidade[Meta INS] ), TREATAS ( ids, MatModalidade[IdAção] ) ),
