	measure Escopo =
			SWITCH ( TRUE (),
			    ISFILTERED ( Semanas[Consultor] ) && HASONEVALUE ( Semanas[Consultor] ), VALUES ( Semanas[Consultor] ),
			    ISFILTERED ( Semanas[Coordenador] ) && HASONEVALUE ( Semanas[Coordenador] ), VALUES ( Semanas[Coordenador] ),
			    ISFILTERED ( Semanas[Unidade] ) && HASONEVALUE ( Semanas[Unidade] ), VALUES ( Semanas[Unidade] ),
			    ISFILTERED ( Semanas[Regional] ) && HASONEVALUE ( Semanas[Regional] ), "Regional " & VALUES ( Semanas[Regional] ),
			    "O Campus" )
		displayFolder: 8 · Textos e recomendações
		lineageTag: 09ff0cc7-f481-58cc-8253-094427a50128

	measure 'Leitura do Período' =
			VAR p = [Pace INS]
			VAR c = [Data Corte]
			VAR txtRitmo = IF ( [Dias Restantes] > 0, " Para bater a meta são necessários " & FORMAT ( [INS por Dia Necessário], "#,0.0" ) & " INS por dia nos " & [Dias Restantes] & " dias restantes; hoje a média é " & FORMAT ( [Ritmo Atual], "#,0.0" ) & ".", "" )
			RETURN
			    IF ( ISBLANK ( p ),
			        [Escopo] & " tem " & FORMAT ( [Meta INS Período], "#,0" ) & " INS de meta no período. O pace aparece a partir do primeiro dia com meta.",
			        [Escopo] & ": pace real de " & FORMAT ( [INS Realizado] + 0, "#,0" ) & " INS contra pace ideal de " & FORMAT ( [INS Ideal], "#,0" ) & " até " & FORMAT ( c, "dd/MM" )
			            & " (gap " & FORMAT ( [Gap INS], "+#,0;-#,0;0" ) & "). Mantido o ritmo, fecha com " & FORMAT ( [Tendência INS], "#,0" ) & " de " & FORMAT ( [Meta INS Período], "#,0" )
			            & " INS. MAT: " & FORMAT ( [MAT Realizado] + 0, "#,0" ) & " de " & FORMAT ( [MAT Ideal], "#,0" ) & " esperadas." & txtRitmo )
		displayFolder: 8 · Textos e recomendações
		lineageTag: 05462b26-5d0a-5a1d-b786-56377c4bbaf4

	measure 'Pior Regional' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( Semanas[Regional] ), "@p", [Pace INS] ), NOT ISBLANK ( [@p] ) )
			RETURN MAXX ( TOPN ( 1, t, [@p], ASC ), Semanas[Regional] & " · " & FORMAT ( CALCULATE ( [INS Realizado] + 0 ), "#,0" ) & " de " & FORMAT ( CALCULATE ( [INS Ideal] ), "#,0" ) & " INS do pace ideal" )
		displayFolder: 8 · Textos e recomendações
		lineageTag: 56563e3d-2fd3-5e3f-9967-83390fd8f86a

	measure 'Maior Gap Coordenador' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( Semanas[Coordenador] ), "@g", [Gap INS] ), NOT ISBLANK ( [@g] ) && [@g] < 0 )
			RETURN MAXX ( TOPN ( 1, t, [@g], ASC ), Semanas[Coordenador] & " · " & FORMAT ( [@g], "+#,0;-#,0" ) & " INS" )
		displayFolder: 8 · Textos e recomendações
		lineageTag: 34a87560-a00c-5cf3-bd88-005c8931d0f2

	measure 'Ação Mais Eficiente' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( 'Ações'[Tipo] ), "@v", [INS por Ação], "@n", [Ações Iniciadas] ), 'Ações'[Tipo] <> "(tipo não informado)" && [@n] >= 2 && NOT ISBLANK ( [@v] ) )
			RETURN MAXX ( TOPN ( 1, t, [@v], DESC ), 'Ações'[Tipo] & " · " & FORMAT ( [@v], "#,0.0" ) & " INS por ação" )
		displayFolder: 8 · Textos e recomendações
		lineageTag: 9e1215b5-088b-5592-800a-f95bf39c7f30

	measure 'Resumo Pendências' =
			VAR a = [Ações Atrasadas]
			VAR v = [Ações Vencidas]
			RETURN IF ( ISBLANK ( v ) || v = 0, "Nenhuma ação vencida até a data de corte", FORMAT ( a + 0, "#,0" ) & " de " & FORMAT ( v, "#,0" ) & " ações vencidas sem conclusão" )
		displayFolder: 8 · Textos e recomendações
		lineageTag: f5a38885-cdd7-5bc3-acf4-9423d479a21f

	measure 'Alerta Plano' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( Semanas[Coordenador] ), "@p", [Plano Preenchido] ), NOT ISBLANK ( [@p] ) && [@p] < 0.9 )
			VAR n = COUNTROWS ( t )
			RETURN IF ( n > 0, n & " coordenador(es) com plano abaixo de 90% nas semanas já iniciadas. Menor: " & MAXX ( TOPN ( 1, t, [@p], ASC ), Semanas[Coordenador] & " (" & FORMAT ( [@p], "0%" ) & ")" ) & ". Cobrar o cadastro das ações da semana.", "Plano preenchido em todas as coordenações." )
		displayFolder: 8 · Textos e recomendações
		lineageTag: a2579752-996b-518e-8931-5d9d93a1bf91

	measure 'Alerta Registro' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( Semanas[Coordenador] ), "@d", [Disciplina de Registro], "@e", [Ações Iniciadas] ), [@e] >= 2 && [@d] < 0.8 )
			VAR n = COUNTROWS ( t )
			RETURN IF ( n > 0, n & " coordenador(es) com fechamento abaixo de 80% das ações iniciadas. Menor: " & MAXX ( TOPN ( 1, t, [@d], ASC ), Semanas[Coordenador] & " (" & FORMAT ( [@d], "0%" ) & ")" ) & ". Lançar o fechamento até segunda-feira.", "Fechamento das ações em dia." )
		displayFolder: 8 · Textos e recomendações
		lineageTag: eaa8ed37-90d1-5e71-b5ba-3d1ff7339251

	measure 'Alerta Conversão' =
			VAR media = DIVIDE ( [MAT Realizado], [INS Realizado] )
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( Semanas[Unidade] ), "@i", [INS Realizado], "@m", [MAT Realizado] ), [@i] >= 15 && DIVIDE ( [@m], [@i] ) < media * 0.7 )
			VAR ganho = SUMX ( t, [@i] * media - [@m] )
			RETURN IF ( COUNTROWS ( t ) > 0, COUNTROWS ( t ) & " unidade(s) convertem menos de 70% da média (" & FORMAT ( media * 100, "#,0.0" ) & " MAT/100 INS). Na média seriam +" & FORMAT ( ganho, "#,0" ) & " MAT. Acionar a régua de pós-inscrição.", "Nenhuma unidade com conversão INS → MAT muito abaixo da média." )
		displayFolder: 8 · Textos e recomendações
		lineageTag: 4ffa6a9c-00d2-58f7-8f81-1bfcb9e9007e

	measure 'Alerta Ação' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( 'Ações'[Tipo] ), "@v", [INS por Ação], "@n", [Ações Iniciadas] ), 'Ações'[Tipo] <> "(tipo não informado)" && [@n] >= 2 && NOT ISBLANK ( [@v] ) )
			VAR melhor = TOPN ( 1, t, [@v], DESC )
			VAR pior = TOPN ( 1, t, [@v], ASC )
			VAR vm = MAXX ( melhor, [@v] )
			VAR vp = MAXX ( pior, [@v] )
			RETURN IF ( COUNTROWS ( t ) >= 2 && vm > vp * 1.3, "Escalar " & MAXX ( melhor, 'Ações'[Tipo] ) & " (" & FORMAT ( vm, "#,0.0" ) & " INS por ação) e rever " & MAXX ( pior, 'Ações'[Tipo] ) & " (" & FORMAT ( vp, "#,0.0" ) & ").", "Sem diferença relevante de eficiência entre os tipos de ação (ou poucas ações iniciadas)." )
		displayFolder: 8 · Textos e recomendações
		lineageTag: 121fc512-19fd-5efb-97dc-651a5008b999

	measure 'Alerta Equipe' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( Semanas[Coordenador] ), "@s", [Consultores sem Ação] + [Consultores só com Ação Futura], "@h", [HC Ativo] ), [@s] > 0 )
			VAR n = SUMX ( t, [@s] )
			VAR h = [HC Ativo]
			RETURN IF ( ISBLANK ( [Data Corte] ), BLANK (), IF ( n > 0, FORMAT ( n, "#,0" ) & " de " & FORMAT ( h, "#,0" ) & " consultores ativos ainda sem ação em execução. Maior concentração: "
			    & MAXX ( TOPN ( 1, t, [@s], DESC ), Semanas[Coordenador] & " (" & [@s] & " de " & [@h] & ")" ) & ".", "Toda a equipe ativa tem ação em execução." ) )
		displayFolder: 8 · Textos e recomendações
		lineageTag: 6560229f-5369-544c-8721-ec7fd3471c11

