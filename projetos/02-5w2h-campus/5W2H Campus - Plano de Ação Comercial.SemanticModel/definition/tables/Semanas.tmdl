	column Observações
		dataType: string
		lineageTag: 38951cee-98d6-587e-a26b-b6660139dda6
		summarizeBy: none
		sourceColumn: Observações

		annotation SummarizationSetBy = Automatic

	partition Semanas = m
		mode: import
		source =
				let
				    S = #"Semanas Base",
				    Estados = [AC = "Acre", AL = "Alagoas", AP = "Amapá", AM = "Amazonas", BA = "Bahia", CE = "Ceará", DF = "Distrito Federal", ES = "Espírito Santo", GO = "Goiás", MA = "Maranhão", MT = "Mato Grosso", MS = "Mato Grosso do Sul", MG = "Minas Gerais", PA = "Pará", PB = "Paraíba", PR = "Paraná", PE = "Pernambuco", PI = "Piauí", RJ = "Rio de Janeiro", RN = "Rio Grande do Norte", RS = "Rio Grande do Sul", RO = "Rondônia", RR = "Roraima", SC = "Santa Catarina", SP = "São Paulo", SE = "Sergipe", TO = "Tocantins"],
				    Soma = (t as table, c as text) as number => List.Sum({0} & List.RemoveNulls(Table.Column(t, c))),
				    Nomes = (chaves as list, nomes as record) as text => Text.Combine(List.Transform(chaves, (k) => Record.Field(nomes, k)), ", "),
				    C1 = Table.AddColumn(S, "Nº Ações", each Table.RowCount([Acoes]), Int64.Type),
				    C2 = Table.AddColumn(C1, "Tem Ação", each [Nº Ações] > 0, type logical),
				    C3 = Table.AddColumn(C2, "Ações da Semana", each Text.Combine(List.Distinct(List.Select([Acoes][TipoAcao], each _ <> "")), " + "), type text),
				    C4 = Table.AddColumn(C3, "Status do Plano", each
				        let st = [Acoes][StatusN] in
				        if List.IsEmpty(st) then "Sem plano" else if List.AllTrue(List.Transform(st, each _ <> "Planejada")) then "Fechada"
				        else if List.AnyTrue(List.Transform(st, each _ <> "Planejada")) then "Em andamento" else "Planejada", type text),
				    C5 = Table.AddColumn(C4, "Meta INS", each Soma([Acoes], "MetaInscritos"), type number),
				    C6 = Table.AddColumn(C5, "INS Ações", each Soma([Acoes], "RealInscritos"), type number),
				    C7 = Table.AddColumn(C6, "Custo Previsto Semana", each Soma([Acoes], "CustoPrevisto"), type number),
				    C8 = Table.AddColumn(C7, "Custo Realizado Semana", each Soma([Acoes], "CustoRealizado"), type number),
				    C9 = Table.AddColumn(C8, "Produtos da Semana", each Nomes(List.Distinct(List.Combine([Acoes][ListaProdutos])), [Grad = "Graduação", Pos = "Pós-graduação", Tec = "Técnico", Prof = "Profissionalizante"]), type text),
				    C10 = Table.AddColumn(C9, "Modalidades da Semana", each Nomes(List.Distinct(List.Combine([Acoes][ListaModalidades])), [Pres = "Presencial", Semi = "Semipresencial", EAD = "EAD"]), type text),
				    C11 = Table.AddColumn(C10, "Mês", each MesTexto([MesData]), type text),
				    C12 = Table.AddColumn(C11, "Semana", each "S" & Text.From([SemanaN]), type text),
				    C13 = Table.AddColumn(C12, "Período", each if [N] = 1 then Date.ToText([Inicio], [Format = "dd/MM"]) else Date.ToText([Inicio], [Format = "dd/MM"]) & " a " & Date.ToText([Fim], [Format = "dd/MM"]), type text),
				    Locais = Table.Buffer(Table.AddColumn(Table.Distinct(Table.SelectColumns(C13, {"Unidade", "Filial"})), "Loc", each Localizar([Unidade], [Filial]))),
				    Loc = Table.NestedJoin(C13, {"Unidade", "Filial"}, Locais, {"Unidade", "Filial"}, "JL", JoinKind.LeftOuter),
				    C14 = Table.ExpandRecordColumn(Table.ExpandTableColumn(Loc, "JL", {"Loc"}), "Loc", {"UF", "Estado", "Cidade", "Origem"}, {"UF", "Estado", "Cidade", "Origem UF"}),
				    C15 = Table.AddColumn(Table.AddColumn(C14, "Local Estado", each if [UF] = "" then "" else [Estado] & ", Brasil", type text),
				        "Local Cidade", each if [Cidade] = "" then "" else [Cidade] & ", " & [UF] & ", Brasil", type text),
				    C16 = Table.AddColumn(C15, "Observações", each Text.Combine(List.Select([Acoes][Observacoes], each _ <> ""), " | "), type text),
				    Final = Table.SelectColumns(C16, {"IdSemana", "Chave", "Matricula", "Consultor", "EmailConsultor", "Regional", "Gerente", "EmailGerente", "Unidade", "Filial", "UF", "Estado", "Cidade", "Origem UF", "Local Estado", "Local Cidade",
				        "Coordenador", "EmailCoordenador", "Funcao", "Situacao", "Ativo", "Mês", "MesData", "Semana", "Período", "Nº Ações", "Tem Ação", "Ações da Semana", "Status do Plano",
				        "Meta INS", "INS Ações", "Custo Previsto Semana", "Custo Realizado Semana", "Produtos da Semana", "Modalidades da Semana", "Inicio", "Fim", "N", "Observações"}),
				    Nomes2 = Table.RenameColumns(Final, {{"Chave", "Chave Consultor"}, {"Matricula", "Matrícula"}, {"EmailConsultor", "Email Consultor"}, {"EmailGerente", "Email Gerente"},
				        {"EmailCoordenador", "Email Coordenador"}, {"Funcao", "Função"}, {"Situacao", "Situação"}, {"MesData", "Mês (data)"}, {"Inicio", "Data Início"},
				        {"Fim", "Data Fim"}, {"N", "Dias Válidos"}}),
				    Tipos = Table.TransformColumnTypes(Nomes2, {{"IdSemana", Int64.Type}, {"Mês (data)", type date}, {"Data Início", type date}, {"Data Fim", type date},
				        {"Dias Válidos", Int64.Type}, {"Ativo", type logical}})
				in
				    Tipos

	annotation PBI_ResultType = Table

