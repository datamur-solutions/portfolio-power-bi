			    "ATENDIDOS", [FUNIL | ATENDIDOS],
			    "EFETIVOS", [FUNIL | EFETIVOS CONECTA+],
			    "VENDAS", [VENDAS],
			    "MATRICULAS", [MATRICULADOSCC],
			
			    "SPIN", [FUNIL | SPIN],
			    "% TRAB", [FUNIL | % TRAB CONECTA+],
			    "HITRATE", [FUNIL | ESF. P/ ATENDIDO],
			    "% ATENDIDO/BASE", [FUNIL | % ATENDIDO/BASE],
			    "% EFETIVO/BASE", [FUNIL | % EFETIVO/BASE],
			    "% CONV VENDA", [FUNIL | % CONV VENDA],
			    "% RET", [FUNIL | % RET],
			    "% CONV MAT", [FUNIL | % CONV MAT]
			)
		lineageTag: 12e53c10-fe8f-42bc-8ce0-90484f94594b

