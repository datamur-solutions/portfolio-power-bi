	measure 'ÍCONE PROD MAT EPS' =
			
			VAR EPS_Atual =
			    SELECTEDVALUE('TB CALL CENTER'[EPS])
			
			VAR Prod_Conecta =
			    ROUND(
			        CALCULATE(
			            [PROD MAT DIA ÚTIL / HC],
			            REMOVEFILTERS('TB CALL CENTER'[EPS]),
			            'TB CALL CENTER'[EPS] = "CONECTA+"
			        ),
			        1
			    )
			
			VAR Prod_Vox =
			    ROUND(
			        CALCULATE(
			            [PROD MAT DIA ÚTIL / HC],
			            REMOVEFILTERS('TB CALL CENTER'[EPS]),
			            'TB CALL CENTER'[EPS] = "VOXPRIME"
			        ),
			        1
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			
			        ISBLANK(EPS_Atual), BLANK(),
			        ISBLANK(Prod_Conecta), BLANK(),
			        ISBLANK(Prod_Vox), BLANK(),
			
			        EPS_Atual = "CONECTA+" && Prod_Conecta > Prod_Vox, 1,
			        EPS_Atual = "CONECTA+" && Prod_Conecta < Prod_Vox, -1,
			
			        EPS_Atual = "VOXPRIME" && Prod_Vox > Prod_Conecta, 1,
			        EPS_Atual = "VOXPRIME" && Prod_Vox < Prod_Conecta, -1,
			
			        EPS_Atual IN {"CONECTA+", "VOXPRIME"}
			            && Prod_Conecta = Prod_Vox, 0,
			
			        BLANK()
			    )
		formatString: 0
		lineageTag: 5debfc03-4247-4ac2-928a-0bdb6ce62c17

	measure 'ÍCONE %CONV EPS' =
			
			VAR EPS_Atual =
			    SELECTEDVALUE('TB CALL CENTER'[EPS])
			
			VAR Conv_Conecta =
			    ROUND(
			        CALCULATE(
			            [MAT/VENDA],
			            REMOVEFILTERS('TB CALL CENTER'[EPS]),
			            'TB CALL CENTER'[EPS] = "CONECTA+"
			        ),
			        4
			    )
			
			VAR Conv_Vox =
			    ROUND(
			        CALCULATE(
			            [MAT/VENDA],
			            REMOVEFILTERS('TB CALL CENTER'[EPS]),
			            'TB CALL CENTER'[EPS] = "VOXPRIME"
			        ),
			        4
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    ISBLANK(EPS_Atual), BLANK(),
			    ISBLANK(Conv_Conecta), BLANK(),
			    ISBLANK(Conv_Vox), BLANK(),
			
			    EPS_Atual = "CONECTA+" && Conv_Conecta > Conv_Vox, 1,
			    EPS_Atual = "CONECTA+" && Conv_Conecta < Conv_Vox, -1,
			
			    EPS_Atual = "VOXPRIME" && Conv_Vox > Conv_Conecta, 1,
			    EPS_Atual = "VOXPRIME" && Conv_Vox < Conv_Conecta, -1,
			
			    Conv_Conecta = Conv_Vox, 0,
			
			    BLANK()
			)
		formatString: 0
		lineageTag: 76325527-430a-430d-a5ad-46b501e8d4b3

	measure 'VENDAS ACUMULADAS DIA' =
			
			VAR DataInicio =
			    DATE(2026, 10, 1)
			
			VAR DataDoPonto =
			    MAX('Dim_Data2'[Date])
			
			RETURN
			IF(
			    DataDoPonto < DataInicio,
			    BLANK(),
			    CALCULATE(
			        [VENDAS],
			        FILTER(
			            ALL('Dim_Data2'[Date]),
			            'Dim_Data2'[Date] >= DataInicio
			                && 'Dim_Data2'[Date] <= DataDoPonto
			        )
			    )
			)
		formatString: #,0
		lineageTag: 481a5450-274e-41a0-8287-b1bc2d76206f

	measure 'MAT ACUMULADAS DIA' =
			
			VAR DataInicio =
			    DATE(2026, 10, 1)
			
			VAR DataDoPonto =
			    MAX('Dim_Data2'[Date])
			
			RETURN
			IF(
			    DataDoPonto < DataInicio,
			    BLANK(),
			    CALCULATE(
			        [MATRICULADOSCC],
			        FILTER(
			            ALL('Dim_Data2'[Date]),
			            'Dim_Data2'[Date] >= DataInicio
			                && 'Dim_Data2'[Date] <= DataDoPonto
			        )
			    )
			)
		formatString: #,0
		lineageTag: 43389e18-2530-4045-b93e-208211bdb57a

	measure 'INS ACUMULADAS DIA' =
			
			VAR DataInicio =
			    DATE(2026, 10, 1)
			
			VAR DataDoPonto =
			    MAX('Dim_Data'[Date])
			
			RETURN
			IF(
			    DataDoPonto < DataInicio,
			    BLANK(),
			    CALCULATE(
			        [FUNIL | MAILING TOTAL],
			        FILTER(
			            ALL('Dim_Data'[Date]),
			            'Dim_Data'[Date] >= DataInicio
			                && 'Dim_Data'[Date] <= DataDoPonto
			        )
			    )
			)
		formatString: #,0
		lineageTag: cd3c89b6-d11b-47b8-bb4e-e4a98743a1c6

	measure 'GAP ACUM' = [MAT ACUMULADAS DIA]-[MAT ACUM PLANEJADO]
		formatString: #,0
		lineageTag: b2ae17be-48c8-40d1-93c3-4ddb6944818c

	measure 'gap plan e real' = CALCULATE(DIVIDE([MATRICULADOSCC],[MAT PLANEJADO]))
