	measure 'VISUAL | TOP 5 INTERAÇÕES CHAVE' =
			
			VAR ChaveAtual =
			    SELECTEDVALUE('TB CALL CENTER'[CHAVE_INSCRICAO])
			
			VAR IdAtual =
			    SELECTEDVALUE('TB CALL CENTER'[ID_INTERACAO_CALLCENTER])
			
			VAR RankingInteracao =
			    RANKX(
			        FILTER(
			            ALLSELECTED('TB CALL CENTER'),
			            'TB CALL CENTER'[CHAVE_INSCRICAO] = ChaveAtual
			        ),
			        VAR Prioridade =
			            SWITCH(
			                TRUE(),
			                CALCULATE(MAX('TB CALL CENTER'[MAT_LIQ_ATRIBUIDA_CALLCENTER])) = 1, 1,
			                CALCULATE(MAX('TB CALL CENTER'[TABULACAO_HUMANA_2])) = "ACEITOU OFERTA", 2,
			                CALCULATE(MAX('TB CALL CENTER'[FLAG_EFETIVO])) = 1, 3,
			                CALCULATE(MAX('TB CALL CENTER'[FLAG_TRABALHADO])) = 1, 4,
			                5
			            )
			        VAR IdRank =
			            CALCULATE(MAX('TB CALL CENTER'[ID_INTERACAO_CALLCENTER]))
			        RETURN
			            Prioridade * 1000000000000 - IdRank,
			        ,
			        ASC,
			        DENSE
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(ChaveAtual)
			        && NOT ISBLANK(IdAtual)
			        && RankingInteracao <= 5,
			    1,
			    0
			)
		formatString: 0
		lineageTag: c9a13df8-e51f-47b3-b242-3313f6efe36d

	measure 'OPORT | ID LINHA ESCOLHIDA' =
			
			VAR ChaveAtual =
			    SELECTEDVALUE('TB CALL CENTER'[CHAVE_INSCRICAO])
			
			VAR CPFAtual =
			    SELECTEDVALUE('TB CALL CENTER'[CPF])
			
			VAR BaseChave =
			    FILTER(
			        ALLSELECTED('TB CALL CENTER'),
			        'TB CALL CENTER'[CHAVE_INSCRICAO] = ChaveAtual
			            && 'TB CALL CENTER'[CPF] = CPFAtual
			    )
			
			VAR LinhaEscolhida =
			    TOPN(
			        1,
			        BaseChave,
			        SWITCH(
			            TRUE(),
			            'TB CALL CENTER'[MAT_LIQ_ATRIBUIDA_CALLCENTER] = 1
			                && 'TB CALL CENTER'[TABULACAO_HUMANA_2] = "ACEITOU OFERTA", 1,
			            2
			        ), ASC,
			        'TB CALL CENTER'[DATA_REFERENCIA], DESC,
			        'TB CALL CENTER'[PUBLISH_TIME], DESC,
			        'TB CALL CENTER'[ID_INTERACAO_CALLCENTER], DESC
			    )
			
			RETURN
			MAXX(LinhaEscolhida, 'TB CALL CENTER'[ID_INTERACAO_CALLCENTER])
		formatString: 0
		lineageTag: e1194d47-2fbf-4b1f-a1ce-8c2841263513

