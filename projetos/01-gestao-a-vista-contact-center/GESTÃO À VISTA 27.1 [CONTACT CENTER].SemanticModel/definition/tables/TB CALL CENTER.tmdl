	measure 'FUNIL | TRABALHADOS CONECTA+' =
			
			VAR MailingConecta =
			    CALCULATETABLE(
			        FILTER(
			            VALUES('TB CALL CENTER'[CHAVE_INSCRICAO]),
			            NOT ISBLANK('TB CALL CENTER'[CHAVE_INSCRICAO])
			        ),
			        KEEPFILTERS(
			            'TB CALL CENTER'[EPS] = "CONECTA+"
			        ),
			        REMOVEFILTERS(
			            'TB CALL CENTER'[TABULACAO_HUMANA_2]
			        )
			    )
			
			VAR ChavesTrabalhadas =
			    CALCULATETABLE(
			        FILTER(
			            VALUES('TB CALL CENTER'[CHAVE_INSCRICAO]),
			            NOT ISBLANK('TB CALL CENTER'[CHAVE_INSCRICAO])
			        ),
			        KEEPFILTERS(
			            'TB CALL CENTER'[EPS] = "CONECTA+"
			        ),
			        'TB CALL CENTER'[TABULACAO_HUMANA_2] IN {
			            "ACEITOU OFERTA",
			            "EM NEGOCIAÇÃO",
			            "PAROU DE INTERAGIR",
			            "PESSOAL",
			            "RECUSOU OFERTA",
			            "CONTATO NÃO REALIZADO",
			            "SISTEMA"
			        }
			    )
			
			RETURN
			COUNTROWS(
			    INTERSECT(
			        MailingConecta,
			        ChavesTrabalhadas
			    )
			)
		formatString: #,0
		lineageTag: 1d34ee92-a3af-448a-bdb1-b0be2ab53404

	measure 'FUNIL | % TRAB CONECTA+' =
			
