				    #"Personalização Adicionada1" = Table.AddColumn(#"Personalização Adicionada", "Personalizar", each let
				    SuperCanal = Text.Upper(Text.Trim(Text.From([SUPER_CANAL]))),
				    Canal = Text.Upper(Text.Trim(Text.From([CANAL])))
				in
				    if SuperCanal = "HUNTER" and Canal = "CAMPUS" then
				        "Hunter Campus"

				    else if SuperCanal = "HUNTER" and Canal = "POLO" then
				        "Hunter Polo"

				    else if SuperCanal = "HUNTER" then
				        "Hunter"

				    else if SuperCanal = "MIDIA" or SuperCanal = "MÍDIA" then
				        "MIDIA"

				    else if List.Contains(
				        {
				            "EMPRESA",
				            "MARKETPLACE",
				            "VOCE INDICA",
				            "VOCÊ INDICA",
				            "DISTRIBUIDORES",
				            "CONSULTORIA EDUCACAO",
				            "CONSULTORIA EDUCAÇÃO"
				        },
				        SuperCanal
				    ) then
				        "Novos Canais"

				    else if SuperCanal = "OUTROS" then
				        "Outros"

				    else
				        SuperCanal),
				    #"Colunas Renomeadas1" = Table.RenameColumns(#"Personalização Adicionada1",{{"Personalizar", "SUPER_CANAL_DE_PARA"}})
				in
