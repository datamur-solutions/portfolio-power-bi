			    CALCULATE(
			        [INSCRITOS],
			        'TB CALL CENTER'[EPS] = "VOXPRIME"
			    )
			RETURN
			DIVIDE(
			    [FUNIL | TRABALHADOS VOXPRIME],
			    InscritosVox
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3f919219-5bc2-4c71-9f61-4ea2186f51e5

	measure 'FUNIL | TRABALHADOS TOTAL' =
			
			VAR ChavesMailing =
			    CALCULATETABLE(
			        FILTER(
			            VALUES('TB CALL CENTER'[CHAVE_INSCRICAO]),
			            NOT ISBLANK('TB CALL CENTER'[CHAVE_INSCRICAO])
			        ),
			        REMOVEFILTERS('TB CALL CENTER'[TABULACAO_HUMANA_2])
			    )
			
			RETURN
			SUMX(
			    ChavesMailing,
			
			    VAR MelhorStatusDaChave =
			        CALCULATE(
			            MAXX(
			                'TB CALL CENTER',
			                SWITCH(
			                    'TB CALL CENTER'[TABULACAO_HUMANA_2],
			
			                    // Melhores status
			                    "ACEITOU OFERTA", 27,
			                    "EM NEGOCIAÇÃO", 26,
			                    "FINANCEIRO", 25,
			                    "ACADÊMICO", 24,
			                    "CUMPRIMENTO", 23,
			                    "PESSOAL", 22,
			                    "PAROU DE INTERAGIR", 21,
			                    "JÁ RECEBEU ATENDIMENTO", 20,
			                    "RECUSOU OFERTA", 19,
			
			                    // Contatos e tentativas
			                    "CONTATO COM TERCEIRO", 18,
			                    "CONTATO NÃO REALIZADO", 17,
			                    "NÃO RESPONDE", 16,
			                    "NÃO ATENDE", 15,
			                    "CHAMADA OCUPADA", 14,
			                    "CAIU A LINHA", 13,
			                    "QUEDA DE LIGAÇÃO", 12,
			                    "LINHA MUDA", 11,
			                    "CAIXA POSTAL", 10,
			
			                    // Problemas cadastrais ou telefônicos
			                    "TELEFONE ERRADO", 9,
			                    "NÚMERO ERRADO", 8,
			                    "ERRO OPERADORA", 7,
			                    "FORA DE ÁREA", 6,
			                    "ENGANO", 5,
			                    "FALECIDO", 4,
			
			                    // Sistema, URA e fila
			                    "SISTEMA", 3,
			                    "URA - ABANDONO FILA", 2,
			                    "ABANDONO FILA", 1,
			
			                    0
			                )
			            ),
			            REMOVEFILTERS('TB CALL CENTER'[TABULACAO_HUMANA_2])
			        )
			
			    RETURN
			        IF(
			            MelhorStatusDaChave > 0,
			            1,
			            0
			        )
			)
		formatString: #,0
		lineageTag: 0f1e92e4-80e2-406f-a811-e46c203d9fb5

	measure 'FUNIL | % TRAB TOTAL' =
			
			DIVIDE(
			    [FUNIL | TRABALHADOS TOTAL],
			    [FUNIL | MAILING TOTAL]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8e3b136f-c6e7-4cad-aaf2-de13209435f5

	measure 'FUNIL | EFETIVOS VOXPRIME' =
			
			VAR EfetivosVox =
			    CALCULATE(
			        DISTINCTCOUNT('TB CALL CENTER'[CHAVE_INSCRICAO]),
			        'TB CALL CENTER'[EPS] = "VOXPRIME",
			        FILTER(
			            'TB CALL CENTER',
			            'TB CALL CENTER'[TABULACAO_HUMANA_4] = "EFETIVO"
			            ||
			            (
			                'TB CALL CENTER'[TABULACAO_HUMANA_1] = "QUEBRA INTERAÇÃO"
			                &&
			                'TB CALL CENTER'[TABULACAO_HUMANA_3] <> "APRESENTAÇÃO INICIAL"
			            )
			        ),
			        NOT ISBLANK('TB CALL CENTER'[CHAVE_INSCRICAO])
			    )
			
			VAR AtendidosVox =
			    CALCULATE(
			        [FUNIL | ATENDIDOS],
			        'TB CALL CENTER'[EPS] = "VOXPRIME"
			    )
			
			RETURN
			    MIN(
			        EfetivosVox,
			        AtendidosVox
			    )
		formatString: 0
		lineageTag: 0db8fc47-9984-48a2-8269-c0c4bb3a2728

	measure 'FUNIL | EFETIVOS TOTAL' =
			
			VAR EPSSelecionada =
			    SELECTEDVALUE('TB CALL CENTER'[EPS])
			
			VAR EfetivoConecta =
			    [FUNIL | EFETIVOS CONECTA+]
			
			VAR EfetivoVox =
			    [FUNIL | EFETIVOS VOXPRIME]
			
			VAR Resultado =
			    SWITCH(
			        TRUE(),
			
			        EPSSelecionada = "CONECTA+",
			            EfetivoConecta,
			
			        EPSSelecionada = "VOXPRIME",
			            EfetivoVox,
			
			        ISBLANK(EfetivoConecta) &&
			        ISBLANK(EfetivoVox),
			            BLANK(),
			
			        COALESCE(EfetivoConecta, 0)
			            + COALESCE(EfetivoVox, 0)
			    )
			
			RETURN
			IF(
			    Resultado = 0,
			    BLANK(),
			    Resultado
			)
		formatString: #,0
		lineageTag: 93272350-e119-46f2-8849-2d31af9cd405

	measure 'FUNIL | % EFETIVO BASE TOTAL' =
			
			DIVIDE(
			    [FUNIL | EFETIVOS TOTAL],
			    [FUNIL | MAILING TOTAL]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c1071f3c-a40c-4c7b-a316-eb0a1c3989f9

	measure 'FUNIL | VALOR TOTAL' =
			
			SWITCH(
			    SELECTEDVALUE(Dim_Funil[Etapa]),
			
			    "MAILING", [FUNIL | MAILING TOTAL],
			    "TRABALHADOS", [FUNIL | TRABALHADOS TOTAL],
			    "TENTATIVAS", [FUNIL | TENTATIVAS],
			    "ATENDIDOS", [FUNIL | ATENDIDOS],
			    "EFETIVOS", [FUNIL | EFETIVOS TOTAL],
			    "VENDAS", [VENDAS],
			    "MATRICULAS", [MATRICULADOSCC],
			
			    "SPIN", [FUNIL | SPIN],
			    "% TRAB", [FUNIL | % TRAB TOTAL],
			    "HITRATE", [FUNIL | ESF. P/ ATENDIDO],
			    "% ATENDIDO/BASE", [FUNIL | % ATENDIDO/BASE],
			    "% EFETIVO/BASE", [FUNIL | % EFETIVO BASE TOTAL],
			    "% CONV VENDA", [FUNIL | % CONV VENDA],
			    "% RET", [FUNIL | % RET],
			    "% CONV MAT", [FUNIL | % CONV MAT]
			)
		lineageTag: b36c28ae-3215-43c1-8421-a038aea389de

		formatStringDefinition =
