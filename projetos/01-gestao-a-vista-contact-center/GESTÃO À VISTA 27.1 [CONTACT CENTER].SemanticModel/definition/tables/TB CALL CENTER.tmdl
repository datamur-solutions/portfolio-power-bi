table 'TB CALL CENTER'
	lineageTag: 0e6700f8-3faa-4ad2-b966-40ded0ff84a6

	measure PAGAMENTOS =
			
			CALCULATE(
			    DISTINCTCOUNT('TB CALL CENTER'[CHAVE_INSCRICAO]),
			    NOT(ISBLANK('TB CALL CENTER'[DATA_PAGAMENTO]))
			)
		formatString: #,0
		lineageTag: 7ee3bf27-c824-4f6a-b959-d934cffc1d97

	measure INSCRITOS =
			
			VAR TabulacaoSelecionada =
			    SELECTEDVALUE('TB CALL CENTER'[TABULACAO_HUMANA_2])
			RETURN
			IF(
			    TabulacaoSelecionada = "ACEITOU OFERTA",
			    SUM('TB CALL CENTER'[INS_LIQ_ACEITOU_OFERTA]),
			    SUM('TB CALL CENTER'[INS_LIQ])
			)
		formatString: #,0
		lineageTag: 1617cd93-6552-4536-9700-e4003b244e0d

