	measure 'FUNIL | ATENDIDOS' = ```
			
			CALCULATE(
			    DISTINCTCOUNT('TB CALL CENTER'[CHAVE_INSCRICAO]),
			
			    'TB CALL CENTER'[TABULACAO_HUMANA_2] IN {
