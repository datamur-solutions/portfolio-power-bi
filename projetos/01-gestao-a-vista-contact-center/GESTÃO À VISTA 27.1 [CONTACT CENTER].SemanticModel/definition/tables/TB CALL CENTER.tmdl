	measure 'FUNIL | EFETIVOS' =
			
			COALESCE([FUNIL | EFETIVOS VOXPRIME], 0)
			    + COALESCE([FUNIL | EFETIVOS CONECTA+], 0)
		formatString: 0
		lineageTag: 22aece88-d022-462f-bad1-d3ef58177f4b

	measure INTERAÇÕES = SUM('TB CALL CENTER'[RN_INTERACAO_INSCRICAO])
		formatString: #,0
		lineageTag: 3333f91a-6d1c-4c4e-bfa9-b688b73828e7

	measure 'COHORT | VOLUME' =
			
			VAR CohortSelecionado =
			    SELECTEDVALUE(Dim_Cohort[COHORT])
			
			VAR OrdemCohort =
			    SELECTEDVALUE(Dim_Cohort[ORDEM])
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    CohortSelecionado = "D0",
			        SUMX(
			            VALUES(Dim_Data[Date]),
			            CALCULATE(
			                SUM('TB CALL CENTER'[INS_LIQ]),
			                FILTER(
			                    ALL('TB CALL CENTER'),
			                    DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = Dim_Data[Date]
			                )
			            )
			        ),
			
			    CohortSelecionado = "D15+",
			        SUMX(
			            VALUES(Dim_Data[Date]),
			            CALCULATE(
			                SUM('TB CALL CENTER'[FLAG_TENTATIVA]),
			                FILTER(
			                    ALL('TB CALL CENTER'),
			                    DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = Dim_Data[Date]
			                        && 'TB CALL CENTER'[AGING_DIAS] > 15
			                )
			            )
			        ),
			
			    OrdemCohort >= 1 && OrdemCohort <= 15,
			        SUMX(
			            VALUES(Dim_Data[Date]),
			            CALCULATE(
			                SUM('TB CALL CENTER'[FLAG_TENTATIVA]),
			                FILTER(
			                    ALL('TB CALL CENTER'),
			                    DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = Dim_Data[Date]
			                        && 'TB CALL CENTER'[AGING_DIAS] = OrdemCohort
			                )
			            )
			        )
			)
		formatString: #,0
		lineageTag: 47c0bbe2-3d63-4f56-a6c8-c5a49de4abfb

	measure 'COHORT | SAFRA' =
			
			VAR DatasSelecionadas =
			    VALUES(Dim_Data[Date])
			
			VAR ChavesMailing =
			    CALCULATETABLE(
			        VALUES('TB CALL CENTER'[CHAVE_INSCRICAO]),
			
			        REMOVEFILTERS('TB CALL CENTER'[DATA_INSCRICAO]),
			        REMOVEFILTERS('TB CALL CENTER'[TABULACAO_HUMANA_2]),
			
			        FILTER(
			            ALLSELECTED('TB CALL CENTER'),
			            DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO])
			                IN DatasSelecionadas
			                &&
			            NOT ISBLANK('TB CALL CENTER'[CHAVE_INSCRICAO])
			        )
			    )
			
			RETURN
			COUNTROWS(ChavesMailing)
		formatString: #,0
		lineageTag: 7cb49d25-de08-4d91-8f04-ddc6450f33ec

	measure 'COHORT | MAILING' =
			
			COALESCE(
			    SUMX(
			        VALUES(Dim_Data[Date]),
			        CALCULATE(
			            SUM('TB CALL CENTER'[INS_LIQ]),
			            FILTER(
			                ALL('TB CALL CENTER'),
			                DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = Dim_Data[Date]
			            )
			        )
			    ),
			    0
			)
		formatString: 0
		lineageTag: 9424a04d-6870-4e2f-83ac-487fcb38c099

	measure 'FUNIL | VALOR' =
			
			SWITCH(
			    SELECTEDVALUE(Dim_Funil[Etapa]),
			
			    "MAILING", [INSCRITOS],
			    "TRABALHADOS", [FUNIL | TRABALHADOS VOXPRIME],
			    "TENTATIVAS", [FUNIL | TENTATIVAS],
			    "ATENDIDOS", [FUNIL | ATENDIDOS],
			    "EFETIVOS", [FUNIL | EFETIVOS VOXPRIME],
			    "VENDAS", [VENDAS],
			    "MATRICULAS", [MATRICULADOSCC],
			
			    "SPIN", [FUNIL | SPIN],
			    "% TRAB", [FUNIL | % TRAB VOXPRIME],
			    "HITRATE", [FUNIL | ESF. P/ ATENDIDO],
			    "% ATENDIDO/BASE", [FUNIL | % ATENDIDO/BASE],
			    "% EFETIVO/BASE", [FUNIL | % EFETIVO BASE TOTAL],
			    "% CONV VENDA", [FUNIL | % CONV VENDA],
			    "% RET", [FUNIL | % RET],
			    "% CONV MAT", [FUNIL | % CONV MAT]
			)
		lineageTag: d17f5c9b-4263-44b8-9971-50d126cb019e

