			    CALCULATE(
			        [FUNIL | MAILING ÚNICO CONECTA+],
			        'TB CALL CENTER'[EPS] = "CONECTA+"
			    )
			RETURN
			DIVIDE(
			    [FUNIL | TRABALHADOS CONECTA+],
			    InscritosConecta
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 597dce88-f6c5-427d-a2b0-9dbc8b70e72b

