		lineageTag: f2e3ecea-6a0a-488d-a723-76145695e2cc

	measure 'PROD/ POR HC FIXO' = CALCULATE(DIVIDE([MATRICULADOSCC],[HC OPERADORES]))
		lineageTag: 0132891c-d485-4ac2-b904-c34ff49aa44d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'FUNIL | MAILING ÚNICO CONECTA+' =
			
			CALCULATE(
			    DISTINCTCOUNT('TB CALL CENTER'[CHAVE_INSCRICAO]),
			    KEEPFILTERS(
			        'TB CALL CENTER'[EPS] = "CONECTA+"
			    ),
			    REMOVEFILTERS(
			        'TB CALL CENTER'[TABULACAO_HUMANA_2]
			    ),
			    'TB CALL CENTER'[CHAVE_INSCRICAO] <> BLANK()
			)
		formatString: 0
		lineageTag: 2bfb4e4a-b59f-4319-a753-0d38c5ff63d0

	measure 'FUNIL | MAILING TOTAL' =
			
			VAR ChavesMailing =
			    CALCULATETABLE(
			        FILTER(
			            VALUES('TB CALL CENTER'[CHAVE_INSCRICAO]),
			            NOT ISBLANK('TB CALL CENTER'[CHAVE_INSCRICAO])
			        ),
			        REMOVEFILTERS('TB CALL CENTER'[TABULACAO_HUMANA_2])
			    )
			
			RETURN
			COUNTROWS(ChavesMailing)
		formatString: 0
		lineageTag: 2bef8fb7-f765-42d6-a052-2cb38760afe0

	measure 'QTD TABULAÇÕES' =
			
			COUNTROWS(
			    'TB CALL CENTER'
			)
		formatString: #,0
		lineageTag: 341975b6-fe1d-4b56-b810-cd0184a7e183

	measure '% REPRESENTATIVIDADE TABULAÇÕES' =
			
			VAR _QTD =
			    [QTD TABULAÇÕES]
			
			VAR _TOTAL =
			    SWITCH(
			        TRUE(),
			
			        -- Quando estiver no SUBMOTIVO
			        ISINSCOPE('TB CALL CENTER'[TABULACAO_HUMANA_3]),
			            CALCULATE(
			                [QTD TABULAÇÕES],
			                REMOVEFILTERS('TB CALL CENTER'[TABULACAO_HUMANA_3])
			            ),
			
			        -- Quando estiver na CLASSIFICAÇÃO
			        ISINSCOPE('TB CALL CENTER'[TABULACAO_HUMANA_2]),
			            CALCULATE(
			                [QTD TABULAÇÕES],
			                REMOVEFILTERS('TB CALL CENTER'[TABULACAO_HUMANA_2])
			            ),
			
			        -- Total geral
			        [QTD TABULAÇÕES]
			    )
			
			RETURN
			    DIVIDE(
			        _QTD,
			        _TOTAL,
			        0
			    )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4d879cbc-99f7-4674-8ffb-ab08faced3f7

