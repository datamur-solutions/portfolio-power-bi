	measure 'FUNIL | TRABALHADOS' =
			
			CALCULATE(
			    DISTINCTCOUNT('TB CALL CENTER'[CHAVE_INSCRICAO]),
			    'TB CALL CENTER'[FLAG_TRABALHADO] = 1
			)
		formatString: #,0
