	measure 'COHORT | ATENDIDOS' =
			
			VAR CohortSelecionado =
			    SELECTEDVALUE(Dim_Cohort[COHORT])
			
			VAR OrdemCohort =
			    SELECTEDVALUE(Dim_Cohort[ORDEM])
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    CohortSelecionado = "D0",
			        SUMX(
			            VALUES(Dim_Data[Date]),
			            CALCULATE(
			                DISTINCTCOUNT('TB CALL CENTER'[CHAVE_INSCRICAO]),
			                FILTER(
			                    ALL('TB CALL CENTER'),
			                    DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = Dim_Data[Date]
			                        && 'TB CALL CENTER'[AGING_DIAS] = 0
			                        && 'TB CALL CENTER'[TABULACAO_HUMANA_1] IN {
			                            "CONTATO EFETIVO",
			                            "EM NEGOCIAÇÃO",
			                            "VENDA"
			                        }
			                )
			            )
			        ),
			
			    CohortSelecionado = "D15+",
			        SUMX(
			            VALUES(Dim_Data[Date]),
			            CALCULATE(
			                DISTINCTCOUNT('TB CALL CENTER'[CHAVE_INSCRICAO]),
			                FILTER(
			                    ALL('TB CALL CENTER'),
			                    DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = Dim_Data[Date]
			                        && 'TB CALL CENTER'[AGING_DIAS] > 15
			                        && 'TB CALL CENTER'[TABULACAO_HUMANA_1] IN {
			                            "CONTATO EFETIVO",
			                            "EM NEGOCIAÇÃO",
			                            "VENDA"
			                        }
			                )
			            )
			        ),
			
			    OrdemCohort >= 1 && OrdemCohort <= 15,
			        SUMX(
			            VALUES(Dim_Data[Date]),
			            CALCULATE(
			                DISTINCTCOUNT('TB CALL CENTER'[CHAVE_INSCRICAO]),
			                FILTER(
			                    ALL('TB CALL CENTER'),
			                    DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = Dim_Data[Date]
			                        && 'TB CALL CENTER'[AGING_DIAS] = OrdemCohort
			                        && 'TB CALL CENTER'[TABULACAO_HUMANA_1] IN {
			                            "CONTATO EFETIVO",
			                            "EM NEGOCIAÇÃO",
			                            "VENDA"
			                        }
			                )
			            )
			        )
			)
		formatString: 0
		lineageTag: 18a71af0-05b3-4152-bd41-08145173d8e3

	measure 'COHORT | % ALO' =
			
			VAR CohortSelecionado =
			    SELECTEDVALUE(Dim_Cohort[COHORT])
			
			VAR OrdemCohort =
			    SELECTEDVALUE(Dim_Cohort[ORDEM])
			
			VAR ALO =
			    [COHORT | ATENDIDOS]
			
			VAR BASE_D0 =
			    SUMX(
			        VALUES(Dim_Data[Date]),
			        CALCULATE(
			            SUM('TB CALL CENTER'[INS_LIQ]),
			            FILTER(
			                ALL('TB CALL CENTER'),
			                DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = Dim_Data[Date]
			            )
			        )
			    )
			
			VAR BASE_DIAS =
			    SWITCH(
			        TRUE(),
			
			        CohortSelecionado = "D15+",
			            SUMX(
			                VALUES(Dim_Data[Date]),
			                CALCULATE(
			                    SUM('TB CALL CENTER'[FLAG_TENTATIVA]),
			                    FILTER(
			                        ALL('TB CALL CENTER'),
			                        DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = Dim_Data[Date]
			                            && 'TB CALL CENTER'[AGING_DIAS] > 15
			                    )
			                )
			            ),
			
			        OrdemCohort >= 1 && OrdemCohort <= 15,
			            SUMX(
			                VALUES(Dim_Data[Date]),
			                CALCULATE(
			                    SUM('TB CALL CENTER'[FLAG_TENTATIVA]),
			                    FILTER(
			                        ALL('TB CALL CENTER'),
			                        DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = Dim_Data[Date]
			                            && 'TB CALL CENTER'[AGING_DIAS] = OrdemCohort
			                    )
			                )
			            )
			    )
			
			RETURN
			IF(
			    CohortSelecionado = "D0",
			    DIVIDE(ALO, BASE_D0),
			    DIVIDE(ALO, BASE_DIAS)
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 64b7f934-ee6b-421f-9f96-9eadd35f5285

	measure 'COHORT | MATRICULAS' =
			
			VAR CohortSelecionado =
			    SELECTEDVALUE(Dim_Cohort[COHORT])
			
			VAR OrdemCohort =
			    SELECTEDVALUE(Dim_Cohort[ORDEM])
			
			RETURN
			SUMX(
			    VALUES(Dim_Data[Date]),
			    VAR DataSafra = Dim_Data[Date]
			    RETURN
			        SWITCH(
			            TRUE(),
			
			            CohortSelecionado = "D0",
			                CALCULATE(
			                    SUM('TB CALL CENTER'[MAT_LIQ_ATRIBUIDA_CALLCENTER]),
			                    REMOVEFILTERS(Dim_Data),
			                    FILTER(
			                        ALL('TB CALL CENTER'[DATA_INSCRICAO], 'TB CALL CENTER'[DATA_MATRICULA]),
			                        DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = DataSafra
			                            && DATEDIFF(
			                                DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]),
			                                DATEVALUE('TB CALL CENTER'[DATA_MATRICULA]),
			                                DAY
			                            ) = 0
			                    )
			                ),
			
			            CohortSelecionado = "D15+",
			                CALCULATE(
			                    SUM('TB CALL CENTER'[MAT_LIQ_ATRIBUIDA_CALLCENTER]),
			                    REMOVEFILTERS(Dim_Data),
			                    FILTER(
			                        ALL('TB CALL CENTER'[DATA_INSCRICAO], 'TB CALL CENTER'[DATA_MATRICULA]),
			                        DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = DataSafra
			                            && DATEDIFF(
			                                DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]),
			                                DATEVALUE('TB CALL CENTER'[DATA_MATRICULA]),
			                                DAY
			                            ) > 15
			                    )
			                ),
			
			            OrdemCohort >= 1 && OrdemCohort <= 15,
			                CALCULATE(
			                    SUM('TB CALL CENTER'[MAT_LIQ_ATRIBUIDA_CALLCENTER]),
			                    REMOVEFILTERS(Dim_Data),
			                    FILTER(
			                        ALL('TB CALL CENTER'[DATA_INSCRICAO], 'TB CALL CENTER'[DATA_MATRICULA]),
			                        DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = DataSafra
			                            && DATEDIFF(
			                                DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]),
			                                DATEVALUE('TB CALL CENTER'[DATA_MATRICULA]),
			                                DAY
			                            ) = OrdemCohort
			                    )
			                )
			        )
			)
		formatString: 0
		lineageTag: e9245a90-bb3d-4ee5-b36d-a8cec653a3fa

	measure 'COHORT | % CONV MATRICULA' =
			
			VAR MatriculasCohort =
			    [COHORT | MATRICULAS]
			
			VAR MailingSafra =
			    SUMX(
			        VALUES(Dim_Data[Date]),
			        VAR DataSafra = Dim_Data[Date]
			        RETURN
			            CALCULATE(
			                SUM('TB CALL CENTER'[INS_LIQ]),
			                REMOVEFILTERS(Dim_Data),
			                FILTER(
			                    ALL('TB CALL CENTER'[DATA_INSCRICAO]),
			                    DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = DataSafra
			                )
			            )
			    )
			
			RETURN
			DIVIDE(MatriculasCohort, MailingSafra)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1920b62d-f45c-49ca-95de-13b5dcff39ed

	measure 'HC OPERADORES' =
			
			SUMX(
			    SUMMARIZE(
			        'TB CALL CENTER',
			        Dim_Data[Ano],
			        Dim_Data[Mês],
			        'TB CALL CENTER'[EPS]
			    ),
			    VAR AnoAtual = Dim_Data[Ano]
			    VAR MesAtual = Dim_Data[Mês]
			    VAR EPSAtual = 'TB CALL CENTER'[EPS]
			    RETURN
			        SWITCH(
			            TRUE(),
			            AnoAtual = 2026 && MesAtual = 10 && EPSAtual = "CONECTA+", 22,
			            AnoAtual = 2026 && MesAtual = 10 && EPSAtual = "VOXPRIME", 16,
			
			            AnoAtual = 2026 && MesAtual = 11 && EPSAtual = "CONECTA+", 24,
			            AnoAtual = 2026 && MesAtual = 11 && EPSAtual = "VOXPRIME", 18,
			
			            AnoAtual = 2026 && MesAtual = 12 && EPSAtual = "CONECTA+", 18,
			            AnoAtual = 2026 && MesAtual = 12 && EPSAtual = "VOXPRIME", 14,
			
			            BLANK()
			        )
			)
		formatString: 0
		lineageTag: 14bbadb0-3022-4e12-85a3-0d9e9ae9be08

	measure 'DIAS ÚTEIS' =
			
			CALCULATE(
			    COUNTROWS(Dim_Data),
			    Dim_Data[É Dia Útil] = 1
			)
		formatString: 0
		lineageTag: e87b825e-3957-40ba-925c-f1dc9303ff12

	measure 'PROD MAT DIA ÚTIL / HC' =
			
			DIVIDE(
			    [MATRICULADOSCC],
			    [HC x DIAS ÚTEIS]
			)
		formatString: 0.0
		lineageTag: f9599364-1570-4e0f-a885-8f35de3a4efa

	measure 'PROD VENDAS DIA ÚTIL / HC' =
			
			DIVIDE(
			    [VENDAS],
			    [DIAS ÚTEIS] * [HC OPERADORES]
			)
		lineageTag: fade53eb-8764-43fb-8ea1-4e9982e66496

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'HC x DIAS ÚTEIS' =
			
			SUMX(
			    SUMMARIZE(
			        'TB CALL CENTER',
			        Dim_Data[Ano],
			        Dim_Data[Mês],
			        'TB CALL CENTER'[EPS]
			    ),
			    VAR AnoAtual = Dim_Data[Ano]
			    VAR MesAtual = Dim_Data[Mês]
			    VAR EPSAtual = 'TB CALL CENTER'[EPS]
			
			    VAR HC =
			        SWITCH(
			            TRUE(),
			
			            AnoAtual = 2026 && MesAtual = 10 && EPSAtual = "CONECTA+", 22,
			            AnoAtual = 2026 && MesAtual = 10 && EPSAtual = "VOXPRIME", 16,
			
			            AnoAtual = 2026 && MesAtual = 11 && EPSAtual = "CONECTA+", 24,
			            AnoAtual = 2026 && MesAtual = 11 && EPSAtual = "VOXPRIME", 18,
			
			            AnoAtual = 2026 && MesAtual = 12 && EPSAtual = "CONECTA+", 18,
			            AnoAtual = 2026 && MesAtual = 12 && EPSAtual = "VOXPRIME", 14,
			
			            BLANK()
			        )
			
			    VAR DiasUteis =
			        CALCULATE(
			            COUNTROWS(Dim_Data),
			            FILTER(
			                ALLSELECTED(Dim_Data),
			                Dim_Data[É Dia Útil] = 1
			                    && Dim_Data[Ano] = AnoAtual
			                    && Dim_Data[Mês] = MesAtual
			            )
			        )
			
			    RETURN
			        HC * DiasUteis
			)
		formatString: 0
		lineageTag: a33511ad-66c7-42d8-afe7-9fe524aa09b3

	measure 'COHORT | EFETIVOS' =
			
			VAR CohortSelecionado =
			    SELECTEDVALUE(Dim_Cohort[COHORT])
			
			VAR OrdemCohort =
			    SELECTEDVALUE(Dim_Cohort[ORDEM])
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    CohortSelecionado = "D0",
			        SUMX(
			            VALUES(Dim_Data[Date]),
			            VAR DataSafra = Dim_Data[Date]
			            RETURN
			                CALCULATE(
			                    DISTINCTCOUNT('TB CALL CENTER'[CHAVE_INSCRICAO]),
			                    FILTER(
			                        ALLSELECTED('TB CALL CENTER'),
			                        DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = DataSafra
			                            && 'TB CALL CENTER'[AGING_DIAS] = 0
			                            && 'TB CALL CENTER'[FLAG_EFETIVO] = 1
			                    )
			                )
			        ),
			
			    CohortSelecionado = "D15+",
			        SUMX(
			            VALUES(Dim_Data[Date]),
			            VAR DataSafra = Dim_Data[Date]
			            RETURN
			                CALCULATE(
			                    DISTINCTCOUNT('TB CALL CENTER'[CHAVE_INSCRICAO]),
			                    FILTER(
			                        ALLSELECTED('TB CALL CENTER'),
			                        DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = DataSafra
			                            && 'TB CALL CENTER'[AGING_DIAS] > 15
			                            && 'TB CALL CENTER'[FLAG_EFETIVO] = 1
			                    )
			                )
			        ),
			
			    OrdemCohort >= 1 && OrdemCohort <= 15,
			        SUMX(
			            VALUES(Dim_Data[Date]),
			            VAR DataSafra = Dim_Data[Date]
			            RETURN
			                CALCULATE(
			                    DISTINCTCOUNT('TB CALL CENTER'[CHAVE_INSCRICAO]),
			                    FILTER(
			                        ALLSELECTED('TB CALL CENTER'),
			                        DATEVALUE('TB CALL CENTER'[DATA_INSCRICAO]) = DataSafra
			                            && 'TB CALL CENTER'[AGING_DIAS] = OrdemCohort
			                            && 'TB CALL CENTER'[FLAG_EFETIVO] = 1
			                    )
			                )
			        )
			)
		formatString: #,0
		lineageTag: 6863aa80-39ef-47c9-a799-3c24e1fe8b7c

