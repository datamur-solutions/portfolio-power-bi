	measure 'FUNIL | EFETIVOS CONECTA+' =
			
			VAR EfetivosBrutosConecta =
			    CALCULATE(
			        DISTINCTCOUNT('TB CALL CENTER'[CHAVE_INSCRICAO]),
			        'TB CALL CENTER'[EPS] = "CONECTA+",
			        FILTER(
			            'TB CALL CENTER',
			            'TB CALL CENTER'[TABULACAO_HUMANA_4] = "EFETIVO"
			                ||
			            'TB CALL CENTER'[TABULACAO_HUMANA_5] = "P"
			        ),
			        NOT ISBLANK('TB CALL CENTER'[CHAVE_INSCRICAO])
			    )
			
			VAR AtendidosConecta =
			    CALCULATE(
			        [FUNIL | ATENDIDOS],
			        'TB CALL CENTER'[EPS] = "CONECTA+"
			    )
			
			VAR MailingConecta =
			    CALCULATE(
			        [FUNIL | MAILING TOTAL],
			        'TB CALL CENTER'[EPS] = "CONECTA+"
			    )
			
			RETURN
			MIN(
			    EfetivosBrutosConecta,
			    MIN(
			        AtendidosConecta,
			        MailingConecta
			    )
			)
		formatString: 0
		lineageTag: 5b697206-994c-475f-bc4f-311383260988

