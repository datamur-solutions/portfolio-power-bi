table 'VISÃO DATA'
	lineageTag: 727c1b65-a018-4d4b-9b75-d5455158f49a

	calculationGroup

		calculationItem 'Data Inscrição' = SELECTEDMEASURE()

		calculationItem 'Data Matrícula' =
				
				CALCULATE(
				    SELECTEDMEASURE(),
				    CROSSFILTER(
				        Dim_Data[Date],
				        'TB CALL CENTER'[DATA_INSCRICAO],
				        NONE
				    ),
				    USERELATIONSHIP(
				        Dim_Data[Date],
				        'TB CALL CENTER'[DATA_MATRICULA]
				    )
				)

