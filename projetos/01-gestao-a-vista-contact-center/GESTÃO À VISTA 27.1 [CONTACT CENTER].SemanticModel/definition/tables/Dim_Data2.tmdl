table Dim_Data2
	lineageTag: bd4e4542-b21c-4dc0-82f0-55038c8d21fe

	measure 'DIAS ÚTEIS TRABALHADOS' =
			
			VAR DataInicio =
			    [DATA INÍCIO SELEÇÃO]
			
			VAR DataFim =
			    [DATA FIM SELEÇÃO]
			
			VAR DataBase =
			    [DATA BASE REALIZADO]
			
			VAR DataCorte =
			    MIN(
			        DataFim,
			        DataBase
			    )
			
			RETURN
			IF(
			    ISBLANK(DataInicio)
			        || ISBLANK(DataFim)
			        || ISBLANK(DataBase)
			        || DataCorte < DataInicio,
			    0,
			    NETWORKDAYS(
			        DataInicio,
			        DataCorte,
			        1
			    )
			)
		formatString: 0
		lineageTag: 009e7257-aea8-41be-9a48-4887d69f35cc

	measure 'PACE REALIZADO' =
			
			DIVIDE(
			    [MATRICULADOSCC],
			    [DIAS ÚTEIS TRABALHADOS]
			)
		formatString: #,0.0
		lineageTag: 98a4dcc2-e6d9-46ba-858f-b7cd6745338b

	measure 'DIAS ÚTEIS RESTANTES' =
			
			VAR DataBase =
			    [DATA BASE REALIZADO]
			
			VAR DataFim =
			    [DATA FIM PACE]
			
			VAR InicioRestante =
			    DataBase + 1
			
			RETURN
			IF(
			    ISBLANK(DataBase)
			        || ISBLANK(DataFim)
			        || DataFim <= DataBase,
			    0,
			    NETWORKDAYS(
			        InicioRestante,
			        DataFim,
			        1
			    )
			)
		formatString: 0
		lineageTag: a73a21f5-920a-4811-b766-abd37efd6122

	measure 'MAT RESTANTE PARA META' =
			
			VAR MetaSelecionada =
			    [MAT PLANEJADO]
			
			VAR RealizadoSelecionado =
			    [MATRICULADOSCC]
			
			RETURN
			IF(
			    ISBLANK(MetaSelecionada),
			    BLANK(),
			    MAX(
			        MetaSelecionada - RealizadoSelecionado,
			        0
			    )
			)
		lineageTag: 70ceea61-1d3c-46ae-96f6-1cbb784670d9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PACE IDEAL' =
			
			VAR MetaSelecionada =
			    [MAT PLANEJADO]
			
			VAR RealizadoSelecionado =
			    [MATRICULADOSCC]
			
			VAR FaltaParaMeta =
			    MAX(
			        MetaSelecionada - RealizadoSelecionado,
			        0
			    )
			
			VAR DiasRestantes =
			    [DIAS ÚTEIS RESTANTES]
			
			VAR DataBase =
			    [DATA BASE REALIZADO]
			
			VAR DataFim =
			    [DATA FIM PACE]
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    ISBLANK(MetaSelecionada), BLANK(),
			
			    -- Mês retroativo já encerrado
			    DataFim < DataBase, 0,
			
			    -- Meta atingida
			    FaltaParaMeta = 0, 0,
			
			    -- Sem dias úteis restantes
			    DiasRestantes = 0, 0,
			
			    DIVIDE(
			        FaltaParaMeta,
			        DiasRestantes
			    )
			)
		formatString: #,0.0
		lineageTag: a4a1edb7-0af8-4f38-a211-48e1cec58ac7

	measure 'STATUS PACE' =
			
			VAR PaceRealizado =
			    [PACE REALIZADO]
			
			VAR PaceIdeal =
			    [PACE IDEAL]
			
			RETURN
			SWITCH(
			    TRUE(),
			    [MAT RESTANTE PARA META] = 0, "Meta atingida",
			    PaceRealizado >= PaceIdeal, "Ritmo suficiente",
			    PaceRealizado < PaceIdeal, "Aceleração necessária",
			    BLANK()
			)
		lineageTag: ca86394e-61ac-4fa5-9b56-d5a574c523a9

	measure 'ÍNDICE PACE' =
			
			DIVIDE(
			    [PACE REALIZADO],
			    [PACE IDEAL],
			    0
			)
		lineageTag: 9703fd15-4c74-4a4b-993d-6ecd7f0a78b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'HC OPERADORES gerencial' =
			
			SUMX(
			    SUMMARIZE(
			        'TB CALL CENTER',
			        Dim_Data2[Ano],
			        Dim_Data2[Mês],
			        'TB CALL CENTER'[EPS]
			    ),
			    VAR AnoAtual = Dim_Data2[Ano]
			    VAR MesAtual = Dim_Data2[Mês]
			    VAR EPSAtual = 'TB CALL CENTER'[EPS]
			    RETURN
			        SWITCH(
			            TRUE(),
			            AnoAtual = 2026 && MesAtual = 10 && EPSAtual = "CONECTA+", 22,
			            AnoAtual = 2026 && MesAtual = 10 && EPSAtual = "VOXPRIME", 16,
			
			            AnoAtual = 2026 && MesAtual = 11 && EPSAtual = "CONECTA+", 24,
			            AnoAtual = 2026 && MesAtual = 11 && EPSAtual = "VOXPRIME", 18,
			
			            AnoAtual = 2026 && MesAtual = 12 && EPSAtual = "CONECTA+", 18,
			            AnoAtual = 2026 && MesAtual = 12 && EPSAtual = "VOXPRIME", 14,
			
			            BLANK()
			        )
			)
		formatString: 0
		lineageTag: 14c9fb85-95b5-4d71-bc5d-c20ef650eee4

	measure 'ÚLTIMA DATA REALIZADA' =
			
			CALCULATE(
			    MAX('TB CALL CENTER'[DATA_MATRICULA]),
			    REMOVEFILTERS('Dim_Data2')
			)
		formatString: General Date
		lineageTag: 04eab19b-5b06-41b8-931f-3c092c5a2957

	measure 'DIAS ÚTEIS TRABALHADOS CICLO' =
			
			VAR DataInicio =
			    DATE(2026, 10, 1)
			
			VAR DataCorte =
			    [ÚLTIMA DATA REALIZADA]
			
			RETURN
			CALCULATE(
			    COUNTROWS('Dim_Data2'),
			    FILTER(
			        ALL('Dim_Data2'),
			        'Dim_Data2'[Date] >= DataInicio
			            && 'Dim_Data2'[Date] <= DataCorte
			            && 'Dim_Data2'[É Dia Útil] = 1
			    )
			)
		formatString: 0
		lineageTag: 758e57a2-cbd0-4ef9-bd60-ad4ea8d57f88

	measure 'MAT REALIZADO CICLO' =
			
			VAR DataInicio =
			    DATE(2026, 10, 1)
			
			VAR DataCorte =
			    [ÚLTIMA DATA REALIZADA]
			
			RETURN
			CALCULATE(
			    [MATRICULADOSCC],
			    FILTER(
			        ALL('Dim_Data2'),
			        'Dim_Data2'[Date] >= DataInicio
			            && 'Dim_Data2'[Date] <= DataCorte
			    )
			)
		formatString: 0
		lineageTag: 42a9c730-4f5b-4385-8bd4-6a26b015d184

	measure 'PACE REALIZADO CICLO' =
			
			DIVIDE(
			    [MAT REALIZADO CICLO],
			    [DIAS ÚTEIS TRABALHADOS CICLO]
			)
		formatString: #,0
		lineageTag: c0fb3119-e2c2-4465-ae06-c20dcda205db

	measure 'ÚLTIMA DATA COM META' =
			
			CALCULATE(
			    MAX('PLANEJADO'[Data]),
			    REMOVEFILTERS('Dim_Data2'),
			    'PLANEJADO'[Matricula] > 0
			)
		formatString: General Date
		lineageTag: c8b6b3c6-4821-4040-8574-be40d3159162

	measure 'DIAS ÚTEIS RESTANTES CICLO' =
			
			VAR DataCorte =
			    [ÚLTIMA DATA REALIZADA]
			
			VAR DataFinalMeta =
			    [ÚLTIMA DATA COM META]
			
			VAR PrimeiroDiaFuturo =
			    DataCorte + 1
			
			RETURN
			IF(
			    ISBLANK(DataCorte)
			        || ISBLANK(DataFinalMeta)
			        || PrimeiroDiaFuturo > DataFinalMeta,
			    0,
			    NETWORKDAYS(
			        PrimeiroDiaFuturo,
			        DataFinalMeta,
			        1
			    )
			)
		formatString: 0
		lineageTag: 87e0a610-efff-48fa-9e8b-21735758cf53

	measure 'META MAT CICLO' =
			
			VAR DataInicio =
			    DATE(2026, 10, 1)
			
			VAR DataFinalMeta =
			    [ÚLTIMA DATA COM META]
			
			RETURN
			CALCULATE(
			    [MAT PLANEJADO],
			    REMOVEFILTERS('Dim_Data2'),
			    FILTER(
			        ALL('PLANEJADO'[Data]),
			        'PLANEJADO'[Data] >= DataInicio
			            && 'PLANEJADO'[Data] <= DataFinalMeta
			    )
			)
		formatString: #,0
		lineageTag: 85f9e566-7590-480f-9ad7-f8a6a4c6b800

	measure 'MAT RESTANTE CICLO' =
			
			MAX(
			    [META MAT CICLO] - [MAT REALIZADO CICLO],
			    0
			)
		lineageTag: 01aa51ad-8133-470a-8e5f-e4e7153c0809

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PACE IDEAL CICLO' =
			
			VAR MatRestante =
			    [MAT RESTANTE CICLO]
			
			VAR DiasRestantes =
			    [DIAS ÚTEIS RESTANTES CICLO]
			
			RETURN
			SWITCH(
			    TRUE(),
			    MatRestante = 0, 0,
			    DiasRestantes = 0, BLANK(),
			    DIVIDE(
			        MatRestante,
			        DiasRestantes
			    )
			)
		formatString: #,0
		lineageTag: ba9b29a9-3870-4c01-86b4-c5409dad77b8

	measure 'ATINGIMENTO META MÊS %' =
			
			VAR DataReferencia =
			    MAX('Dim_Data2'[Date])
			
			VAR InicioMes =
			    DATE(
			        YEAR(DataReferencia),
			        MONTH(DataReferencia),
			        1
			    )
			
			VAR FimMes =
			    EOMONTH(DataReferencia, 0)
			
			VAR MetaMes =
			    CALCULATE(
			        [MAT PLANEJADO],
			        FILTER(
			            ALL('Dim_Data2'),
			            'Dim_Data2'[Date] >= InicioMes
			                && 'Dim_Data2'[Date] <= FimMes
			        )
			    )
			
			VAR RealizadoMes =
			    CALCULATE(
			        [MATRICULADOSCC],
			        FILTER(
			            ALL('Dim_Data2'),
			            'Dim_Data2'[Date] >= InicioMes
			                && 'Dim_Data2'[Date] <= FimMes
			        )
			    )
			
			RETURN
			DIVIDE(
			    RealizadoMes,
			    MetaMes,
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e582d46d-a954-407d-8bfa-0a195513daea

	measure 'CUSTO EPS' =
			
			-- Custo mensal da operação (HC x custo por posição), rateado pelos dias do mês no contexto
			SUMX(
			    SUMMARIZE(
			        'TB CALL CENTER',
			        Dim_Data2[Ano],
			        Dim_Data2[Mês],
			        'TB CALL CENTER'[EPS]
			    ),
			    VAR AnoAtual = Dim_Data2[Ano]
			    VAR MesAtual = Dim_Data2[Mês]
			    VAR EPSAtual = 'TB CALL CENTER'[EPS]
			
			    VAR CustoMes =
			        SWITCH(
			            TRUE(),
			
			            -- OUTUBRO/2026
			            AnoAtual = 2026
			                && MesAtual = 10
			                && EPSAtual = "CONECTA+", 118800,
			
			            AnoAtual = 2026
			                && MesAtual = 10
			                && EPSAtual = "VOXPRIME", 92800,
			
			            -- NOVEMBRO/2026
			            AnoAtual = 2026
			                && MesAtual = 11
			                && EPSAtual = "CONECTA+", 129600,
			
			            AnoAtual = 2026
			                && MesAtual = 11
			                && EPSAtual = "VOXPRIME", 104400,
			
			            -- DEZEMBRO/2026
			            AnoAtual = 2026
			                && MesAtual = 12
			                && EPSAtual = "CONECTA+", 97200,
			
			            AnoAtual = 2026
			                && MesAtual = 12
			                && EPSAtual = "VOXPRIME", 81200,
			
			            BLANK()
			        )
			
			    VAR DiasNoContexto =
			        CALCULATE(
			            COUNTROWS(Dim_Data2),
			            Dim_Data2[Ano] = AnoAtual,
			            Dim_Data2[Mês] = MesAtual
			        )
			
			    VAR DiasDoMes =
			        DAY(EOMONTH(DATE(AnoAtual, MesAtual, 1), 0))
			
			    RETURN
			        CustoMes * DIVIDE(DiasNoContexto, DiasDoMes)
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 8f41b854-afdf-4381-9567-2c667be78d56

	measure CPMAT =
			
			DIVIDE(
			    [CUSTO EPS],
			    [MATRICULADOSCC],
			    BLANK()
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 04201768-099c-4211-a7a7-336cc5fdb31d

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'DATA BASE REALIZADO' =
			
			CALCULATE(
			    MAX('TB CALL CENTER'[DATA_MATRICULA]),
			    REMOVEFILTERS('Dim_Data2')
			)
		formatString: General Date
		lineageTag: 65902281-47a7-4aa4-a25c-d380dc021684

	measure 'DATA INÍCIO SELEÇÃO' =
			
			MINX(
			    ALLSELECTED('Dim_Data2'[Date]),
			    'Dim_Data2'[Date]
			)
		formatString: General Date
		lineageTag: d7402778-2d2e-43cd-b52c-3a146cb85cbe

	measure 'DATA FIM SELEÇÃO' =
			
			MAXX(
			    ALLSELECTED('Dim_Data2'[Date]),
			    'Dim_Data2'[Date]
			)
		formatString: General Date
		lineageTag: 2200a1fa-b606-442a-b7a3-d6360a3e5ef8

	measure 'DATA FIM PACE' =
			
			VAR DataSelecionada =
			    MAX('Dim_Data2'[Date])
			
			RETURN
			EOMONTH(
			    DataSelecionada,
			    0
			)
		formatString: General Date
		lineageTag: 1b4a29a5-00af-42ed-8e7e-15ddc92cd6b6

	measure 'CPMAT CONECTA+' =
			
			DIVIDE(
			    CALCULATE(
			        [CUSTO EPS],
			        DIM_EPS[EPS] = "CONECTA+"
			    ),
			    CALCULATE(
			        [MATRICULADOSCC],
			        DIM_EPS[EPS] = "CONECTA+"
			    ),
			    BLANK()
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 8eee7847-a7e8-432f-8b81-ee540c12ed2f

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'CPMAT VOXPRIME' =
			
			DIVIDE(
			    CALCULATE(
			        [CUSTO EPS],
			        DIM_EPS[EPS] = "VOXPRIME"
			    ),
			    CALCULATE(
			        [MATRICULADOSCC],
			        DIM_EPS[EPS] = "VOXPRIME"
			    ),
			    BLANK()
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: a08c84eb-d2fd-497f-b0de-0a0c6bf923a5

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'META MAT MÊS' =
			
			VAR EPSSelecionada =
			    SELECTEDVALUE('TB CALL CENTER'[EPS])
			
			VAR SuperCanalSelecionado =
			    SELECTEDVALUE('TB CALL CENTER'[SUPER_CANAL_DE_PARA])
			
			VAR MesesNoContexto =
			    SUMMARIZE(
			        Dim_Data2,
			        Dim_Data2[Ano],
			        Dim_Data2[Mês]
			    )
			
			RETURN
			SUMX(
			    MesesNoContexto,
			
			    VAR AnoAtual =
			        Dim_Data2[Ano]
			
			    VAR MesAtual =
			        Dim_Data2[Mês]
			
			    VAR MetaConecta =
			        SWITCH(
			            TRUE(),
			
			            /* OUTUBRO */
			            AnoAtual = 2026 && MesAtual = 10 && SuperCanalSelecionado = "Hunter Campus", 76,
			            AnoAtual = 2026 && MesAtual = 10 && SuperCanalSelecionado = "Hunter Polo", 50,
			            AnoAtual = 2026 && MesAtual = 10 && UPPER(SuperCanalSelecionado) = "MIDIA", 162,
			            AnoAtual = 2026 && MesAtual = 10 && SuperCanalSelecionado = "Novos Canais", 66,
			            AnoAtual = 2026 && MesAtual = 10 && SuperCanalSelecionado = "Outros", 14,
			            AnoAtual = 2026 && MesAtual = 10, 368,
			
			            BLANK()
			        )
			
			    VAR MetaVox =
			        SWITCH(
			            TRUE(),
			
			            /* OUTUBRO */
			            AnoAtual = 2026 && MesAtual = 10 && SuperCanalSelecionado = "Hunter Campus", 73,
			            AnoAtual = 2026 && MesAtual = 10 && SuperCanalSelecionado = "Hunter Polo", 37,
			            AnoAtual = 2026 && MesAtual = 10 && UPPER(SuperCanalSelecionado) = "MIDIA", 126,
			            AnoAtual = 2026 && MesAtual = 10 && SuperCanalSelecionado = "Novos Canais", 56,
			            AnoAtual = 2026 && MesAtual = 10 && SuperCanalSelecionado = "Outros", 11,
			            AnoAtual = 2026 && MesAtual = 10, 303,
			
			            BLANK()
			        )
			
			    RETURN
			        SWITCH(
			            TRUE(),
			            EPSSelecionada = "CONECTA+", MetaConecta,
			            EPSSelecionada = "VOXPRIME", MetaVox,
			            MetaConecta + MetaVox
			        )
			)
		lineageTag: 860c8d64-fc26-4115-b035-5c9ddc04389d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% ATING META MÊS' =
			
			DIVIDE(
			    [MATRICULADOSCC],
			    [META MAT MÊS],
			    BLANK()
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0185ed28-577d-450f-8524-75c2bc2c9ec9

