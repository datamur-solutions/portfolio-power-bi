	column 'NÚMERO SEMANA CICLO' =
			
			VAR DataInicioCiclo =
			    DATE(2026, 5, 17)
			
			VAR DataAtual =
			    'Dim_Data2'[Date]
			
			RETURN
			IF(
			    DataAtual < DataInicioCiclo,
			    BLANK(),
			    INT(
			        DIVIDE(
			            DataAtual - DataInicioCiclo,
			            7
			        )
			    ) + 1
			)
		formatString: 0
		lineageTag: 8dffbec9-b432-443e-9f65-df4763dcdd5d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'SEMANA CICLO' =
			
			VAR NumeroSemana =
			    'Dim_Data2'[NÚMERO SEMANA CICLO]
			
			RETURN
			IF(
			    ISBLANK(NumeroSemana),
			    BLANK(),
			    "Semana " & FORMAT(NumeroSemana, "00")
			)
		lineageTag: 6d3f4cdf-f5e6-418f-baa9-212aae30a26d
		summarizeBy: none
		sortByColumn: 'NÚMERO SEMANA CICLO'

		annotation SummarizationSetBy = Automatic

	column 'SEMANA CICLO PERÍODO' =
			
			VAR DataInicioCiclo =
			    DATE(2026, 5, 17)
			
			VAR NumeroSemana =
			    'Dim_Data2'[NÚMERO SEMANA CICLO]
			
			VAR InicioSemana =
			    DataInicioCiclo + ((NumeroSemana - 1) * 7)
			
			VAR FimSemana =
			    InicioSemana + 6
			
			RETURN
			IF(
			    ISBLANK(NumeroSemana),
			    BLANK(),
			    FORMAT(InicioSemana, "dd")
			        & " a "
			        & FORMAT(FimSemana, "dd/MM")
			)
		lineageTag: bedf599d-c3c6-4940-aa59-cdf872d97d1f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'É Feriado'
		formatString: 0
		lineageTag: 5326a878-8165-4aea-bd70-d1d55f653c3e
		summarizeBy: sum
		isNameInferred
		sourceColumn: [É Feriado]

		annotation SummarizationSetBy = Automatic

	partition Dim_Data2 = calculated
		mode: import
		source =
				
				VAR FeriadosSP2026 =
				    UNION(
				        ROW("DataFeriado", DATE(2026, 1, 1)),   -- Confraternização Universal
				        ROW("DataFeriado", DATE(2026, 1, 25)),  -- Aniversário de São Paulo
				        ROW("DataFeriado", DATE(2026, 4, 3)),   -- Paixão de Cristo
				        ROW("DataFeriado", DATE(2026, 4, 21)),  -- Tiradentes
				        ROW("DataFeriado", DATE(2026, 5, 1)),   -- Dia do Trabalho
				        ROW("DataFeriado", DATE(2026, 6, 4)),   -- Corpus Christi
				        ROW("DataFeriado", DATE(2026, 7, 9)),   -- Data Magna do Estado de São Paulo
				        ROW("DataFeriado", DATE(2026, 9, 7)),   -- Independência do Brasil
				        ROW("DataFeriado", DATE(2026, 10, 12)), -- Nossa Senhora Aparecida
				        ROW("DataFeriado", DATE(2026, 11, 2)),  -- Finados
				        ROW("DataFeriado", DATE(2026, 11, 15)), -- Proclamação da República
				        ROW("DataFeriado", DATE(2026, 11, 20)), -- Consciência Negra
				        ROW("DataFeriado", DATE(2026, 12, 25))  -- Natal
				    )
				
				RETURN
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(2026, 10, 01),
				        DATE(2026, 10, 23)
				    ),
				
				    "Ano", YEAR([Date]),
				    "Mês", MONTH([Date]),
				    "Nome Mês", FORMAT([Date], "mmmm"),
				    "Ano-Mês", FORMAT([Date], "yyyy-MM"),
				    "Nome Mês-Ano", FORMAT([Date], "mmm yyyy"),
				    "Trimestre", "T" & FORMAT(QUARTER([Date]), "0"),
				
				    "Dia da Semana",
				        WEEKDAY([Date], 2),
				
				    "Nome Dia",
				        FORMAT([Date], "dddd"),
				
				    "É Dia Útil",
				        VAR DataAtual = [Date]
				
				        VAR EhFinalDeSemana =
				            WEEKDAY(DataAtual, 2) > 5
				
				        VAR EhFeriado =
				            COUNTROWS(
				                FILTER(
				                    FeriadosSP2026,
				                    [DataFeriado] = DataAtual
				                )
				            ) > 0
				
				        RETURN
				            IF(
				                EhFinalDeSemana || EhFeriado,
				                0,
				                1
				            ),
				
				    "É Feriado",
				        VAR DataAtualFeriado = [Date]
				        RETURN
				            IF(
				                COUNTROWS(
				                    FILTER(
				                        FeriadosSP2026,
				                        [DataFeriado] = DataAtualFeriado
				                    )
				                ) > 0,
				                1,
				                0
				            ),
				
				    "Dia/Mês",
				        FORMAT([Date], "dd/MM"),
				
				    "Ano Ciclo",
				        IF(
				            MONTH([Date]) >= 10,
				            YEAR([Date]),
				            YEAR([Date]) - 1
				        ),
				
				    "Ordem Ciclo",
				        SWITCH(
				            MONTH([Date]),
				            10, 1,
				            11, 2,
				            12, 3,
				            1, 4,
				            2, 5,
				            3, 6,
				            4, 7,
				            5, 8,
				            6, 9,
				            7, 10,
				            8, 11,
				            9, 12
				        ),
				
				    "Semana Mês",
				        SWITCH(
				            TRUE(),
				            DAY([Date]) <= 7, "1 a 7",
				            DAY([Date]) <= 14, "8 a 14",
				            DAY([Date]) <= 21, "15 a 21",
				            DAY([Date]) <= 28, "22 a 28",
				            "29 a 31"
				        ),
				
				    "Ordem Semana Mês",
				        SWITCH(
				            TRUE(),
				            DAY([Date]) <= 7, 1,
				            DAY([Date]) <= 14, 2,
				            DAY([Date]) <= 21, 3,
				            DAY([Date]) <= 28, 4,
				            5
				        )
				)

	annotation PBI_Id = 17b69e6f392042b3b45541d173aa4870

