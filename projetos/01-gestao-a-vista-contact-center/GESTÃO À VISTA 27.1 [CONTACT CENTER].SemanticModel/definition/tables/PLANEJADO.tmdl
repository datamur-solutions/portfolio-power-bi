table PLANEJADO
	lineageTag: 79ffc2d0-e218-419c-a91d-9cabc8e9703c

	measure 'MAT PLANEJADO' =
			
			SUM('PLANEJADO'[Matricula])
		formatString: #,0
		lineageTag: 1acc93a7-60bc-4780-a4ef-100a3f54d871

	measure 'VENDA PLANEJADO' =
			
			SUM('PLANEJADO'[Venda])
		formatString: 0
		lineageTag: a5174752-85b2-43cb-9be5-8c361847b60b

	measure 'MAT ACUM PLANEJADO' =
			
			VAR DataInicio =
			    DATE(2026, 10, 1)
			
			VAR DataDoPonto =
			    MAX('Dim_Data2'[Date])
			
			RETURN
			IF(
			    DataDoPonto < DataInicio,
			    BLANK(),
			    CALCULATE(
			        [MAT PLANEJADO],
			        FILTER(
			            ALL('Dim_Data2'[Date]),
			            'Dim_Data2'[Date] >= DataInicio
			                && 'Dim_Data2'[Date] <= DataDoPonto
			        )
			    )
			)
		formatString: #,0
		lineageTag: 5ed5466c-994b-4296-b31f-799c01bba585

	measure 'VENDA ACUM PLANEJADO' =
			
			VAR DataInicio =
			    DATE(2026, 10, 1)
			
			VAR DataDoPonto =
			    MAX('Dim_Data2'[Date])
			
			RETURN
			IF(
			    DataDoPonto < DataInicio,
			    BLANK(),
			    CALCULATE(
			        [VENDA PLANEJADO],
			        FILTER(
