	column Dia_Semana_Ordem =
			
			SWITCH(
			    'Dim_Data'[NOME DIA],
			    "Segunda-feira", 1,
			    "Terça-feira", 2,
			    "Quarta-feira", 3,
			    "Quinta-feira", 4,
			    "Sexta-feira", 5,
			    "Sábado", 6,
			    "Domingo", 7
			)
		formatString: 0
		lineageTag: 51246f68-0ad4-4495-b44e-4f9e4de0efea
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition Dim_Data = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR (DATE(2025,10,1), DATE(2026, 10, 23)),
				
				    "Ano", YEAR([Date]),
				    "Mês", MONTH([Date]),
				    "Nome Mês", FORMAT([Date], "mmmm"),
				    "Ano-Mês", FORMAT([Date], "yyyy-MM"),
				    "Nome Mês-Ano", FORMAT([Date], "mmm yyyy"),
				    "Trimestre", "T" & FORMAT(QUARTER([Date]), "0"),
				    "Dia da Semana", WEEKDAY([Date], 2),
				    "Nome Dia", FORMAT([Date], "dddd"),
				    "É Dia Útil", IF(WEEKDAY([Date], 2) <= 5, 1, 0),
				
				    -- NOVA COLUNA DIA/MÊS
				    "Dia/Mês", FORMAT([Date], "dd/MM"),
				
				    -- ANO DO CICLO
				    "Ano Ciclo",
				        IF(MONTH([Date]) >= 10, YEAR([Date]), YEAR([Date]) - 1),
				
				    -- ORDEM DO CICLO (OUTUBRO PRIMEIRO)
				    "Ordem Ciclo",
				        SWITCH(
				            MONTH([Date]),
				            10, 1,
				            11, 2,
				            12, 3,
				            1, 4,
				            2, 5,
				            3, 6,
				            4, 7,
				            5, 8,
				            6, 9,
				            7, 10,
				            8, 11,
				            9, 12
				        ),
				
				 "Semana Mês",
				SWITCH(
				    TRUE(),
				    DAY([Date]) <= 7, "1 a 7",
				    DAY([Date]) <= 14, "8 a 14",
				    DAY([Date]) <= 21, "15 a 21",
				    DAY([Date]) <= 28, "22 a 28",
				    "29 a 31"
				),
				
				"Ordem Semana Mês",
				SWITCH(
				    TRUE(),
				    DAY([Date]) <= 7, 1,
				    DAY([Date]) <= 14, 2,
				    DAY([Date]) <= 21, 3,
				    DAY([Date]) <= 28, 4,
				    5
				)
				)

	annotation PBI_Id = 8d3a9e8c978e4251b8c78a61fd50496f

