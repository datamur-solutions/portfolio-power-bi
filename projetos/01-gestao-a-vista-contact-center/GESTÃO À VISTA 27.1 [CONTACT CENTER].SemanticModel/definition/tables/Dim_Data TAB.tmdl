	partition 'Dim_Data TAB' = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR (DATE(2026,10,1), DATE(2026, 10, 23)),
				
				    "Ano", YEAR([Date]),
				    "Mês", MONTH([Date]),
				    "Nome Mês", FORMAT([Date], "mmmm"),
				    "Ano-Mês", FORMAT([Date], "yyyy-MM"),
				    "Nome Mês-Ano", FORMAT([Date], "mmm yyyy"),
				    "Trimestre", "T" & FORMAT(QUARTER([Date]), "0"),
				    "Dia da Semana", WEEKDAY([Date], 2),
				    "Nome Dia", FORMAT([Date], "dddd"),
				    "É Dia Útil", IF(WEEKDAY([Date], 2) <= 5, 1, 0),
				
				    -- NOVA COLUNA DIA/MÊS
				    "Dia/Mês", FORMAT([Date], "dd/MM"),
				
				    -- ANO DO CICLO
				    "Ano Ciclo",
				        IF(MONTH([Date]) >= 10, YEAR([Date]), YEAR([Date]) - 1),
				
				    -- ORDEM DO CICLO (OUTUBRO PRIMEIRO)
				    "Ordem Ciclo",
				        SWITCH(
				            MONTH([Date]),
				            10, 1,
				            11, 2,
				            12, 3,
				            1, 4,
				            2, 5,
				            3, 6,
				            4, 7,
				            5, 8,
				            6, 9,
				            7, 10,
				            8, 11,
				            9, 12
				        ),
				
				 "Semana Mês",
				SWITCH(
				    TRUE(),
				    DAY([Date]) <= 7, "1 a 7",
				    DAY([Date]) <= 14, "8 a 14",
				    DAY([Date]) <= 21, "15 a 21",
				    DAY([Date]) <= 28, "22 a 28",
				    "29 a 31"
				),
				
				"Ordem Semana Mês",
				SWITCH(
				    TRUE(),
				    DAY([Date]) <= 7, 1,
				    DAY([Date]) <= 14, 2,
				    DAY([Date]) <= 21, 3,
				    DAY([Date]) <= 28, 4,
				    5
				)
				)

	annotation PBI_Id = 4a6bff2c947a4f359c4b983dabc794c4

