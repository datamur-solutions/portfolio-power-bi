	partition 'DICIONARIO GESTAO A VISTA' = calculated
		mode: import
		source =
				
				DATATABLE(
				    "ORDEM_PAGINA", INTEGER,
				    "PAGINA", STRING,
				    "ORDEM_BLOCO", INTEGER,
				    "BLOCO", STRING,
				    "ORDEM_INDICADOR", INTEGER,
				    "INDICADOR_KPI", STRING,
				    "DESCRICAO", STRING,
				    "FORMULA_LEITURA", STRING,
				    "REGRA_NEGOCIO", STRING,
				    "COMO_INTERPRETAR", STRING,
				    {
				        /* =====================================================
				           1. CONCEITOS GERAIS
				           ===================================================== */
				
				        {
				            0,
				            "CONCEITOS GERAIS",
				            1,
				            "PAINEL",
				            1,
				            "DATA BASE",
				            "Data da última atualização válida das informações apresentadas no painel.",
				            "Maior data disponível na base carregada.",
				            "A data base não representa necessariamente a data do último contato. Ela identifica a atualização considerada pelo painel.",
				            "Utilize a data base para confirmar se a visão está atualizada antes de realizar análises ou comparações."
				        },
				
				        {
				            0,
				            "CONCEITOS GERAIS",
				            1,
				            "PAINEL",
				            2,
				            "CICLO",
				            "Período comercial utilizado para acompanhamento da captação e conversão dos candidatos.",
				            "Classificação definida pela regra de período letivo.",
				            "Os indicadores devem ser comparados dentro do mesmo ciclo, respeitando datas de início, viradas de ciclo e regras específicas das operações.",
				            "Permite acompanhar a evolução comercial desde o início do período de captação."
				        },
				
				        {
				            0,
				            "CONCEITOS GERAIS",
				            1,
				            "PAINEL",
				            3,
				            "EPS",
				            "Empresa prestadora de serviço responsável pela atuação comercial do Contact Center.",
				            "Classificação obtida na coluna EPS da base do Call Center.",
				            "As principais operações consideradas são CONECTA+ e VOXPRIME.",
				            "Utilize este filtro para comparar cobertura, esforço, produtividade e conversão entre operações."
				        },
				
				        {
				            0,
				            "CONCEITOS GERAIS",
				            1,
				            "PAINEL",
				            4,
				            "SUPER CANAL",
				            "Agrupamento comercial que identifica a principal origem ou estratégia de captação da inscrição.",
				            "Classificação originada da base de captação comercial.",
				            "Exemplos: Mídia, Hunter, Distribuidores, Consultoria Educação, Empresa, Marketplace, Você Indica e Outros.",
				            "Permite identificar quais estratégias geram maior volume, contato, venda e matrícula."
				        },
				
				        {
				            0,
				            "CONCEITOS GERAIS",
				            2,
				            "FILTROS",
				            1,
				            "DATA INSCRIÇÃO",
				            "Filtra os candidatos pela data em que a inscrição foi criada.",
				            "Intervalo mínimo e máximo da coluna DATA_INSCRICAO.",
				            "É uma visão por safra de inscritos.",
				            "Ao selecionar um período, o painel acompanha o comportamento das inscrições originadas naquele intervalo."
				        },
				
				        {
				            0,
				            "CONCEITOS GERAIS",
				            2,
				            "FILTROS",
				            2,
				            "DATA MATRÍCULA",
				            "Filtra os candidatos pela data em que a matrícula foi registrada.",
				            "Intervalo mínimo e máximo da coluna DATA_MATRICULA.",
				            "É uma visão por safra de matrícula.",
				            "Utilize para análises de produção, pace, realizado e atingimento de meta."
				        },
				
				        {
				            0,
				            "CONCEITOS GERAIS",
				            2,
				            "FILTROS",
				            3,
				            "TOMBAMENTOS",
				            "Classificação que identifica registros originados de Tombamentos e Migrações.",
				            "Se ORIGEM_CALLCENTER for Tombamentos e Migrações, retorna COM TOMBAMENTOS; nos demais casos, retorna SEM TOMBAMENTOS.",
				            "Valores diferentes ou em branco são classificados como SEM TOMBAMENTOS.",
				            "Permite analisar o resultado orgânico da operação separadamente dos registros migrados."
				        },
				
				        {
				            0,
				            "CONCEITOS GERAIS",
				            2,
				            "FILTROS",
				            4,
				            "LIMPAR FILTROS",
				            "Botão utilizado para retornar os filtros da página ao estado padrão.",
				            "Ação configurada por marcador no Power BI.",
				            "O botão não altera os dados da base, apenas remove as seleções aplicadas na página.",
				            "Utilize antes de iniciar uma nova análise para evitar filtros residuais."
				        },
				
				        /* =====================================================
				           2. FUNIL CONTACT CENTER
				           ===================================================== */
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            1,
				            "CARDS SUPERIORES",
				            1,
				            "VENDAS",
				            "Quantidade de vendas registradas pela operação de Contact Center.",
				            "Soma de VENDAS_CALLCENTER.",
				            "A venda é identificada pela tabulação de aceite da oferta.",
				            "Representa o fechamento comercial realizado pela EPS."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            1,
				            "CARDS SUPERIORES",
				            2,
				            "APROVADOS",
				            "Quantidade de candidatos aprovados no processo de ingresso.",
				            "Soma de APR_LIQ.",
				            "Considera o indicador líquido de aprovação disponibilizado na base comercial.",
				            "É uma etapa intermediária entre inscrição e matrícula."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            1,
				            "CARDS SUPERIORES",
				            3,
				            "PAGAMENTOS",
				            "Quantidade de candidatos com pagamento identificado.",
				            "Contagem ou soma do indicador de pagamento, conforme a medida do painel.",
				            "O pagamento pode ser identificado pela DATA_PAGAMENTO ou pelo indicador PAGAMENTO_ACEITOU_OFERTA.",
				            "Mostra quantos candidatos avançaram financeiramente após a venda."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            1,
				            "CARDS SUPERIORES",
				            4,
				            "MATRÍCULAS",
				            "Quantidade de matrículas líquidas registradas.",
				            "Soma de MAT_LIQ ou da medida de matrículas atribuídas, conforme a visão.",
				            "A matrícula total pode ser diferente da matrícula atribuída ao Contact Center.",
				            "Representa o principal resultado final do funil."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            1,
				            "CARDS SUPERIORES",
				            5,
				            "ACEITE DO CONTRATO",
				            "Quantidade de candidatos que realizaram o aceite do contrato.",
				            "Soma de ACEITE_MAT_LIQ.",
				            "Para determinadas ofertas, especialmente presenciais, o aceite é necessário para reconhecimento da matrícula.",
				            "Mostra o avanço contratual após aprovação e pagamento."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            1,
				            "CARDS SUPERIORES",
				            6,
				            "MAT/VENDA",
				            "Percentual de vendas que foram convertidas em matrícula.",
				            "Matrículas divididas por Vendas.",
				            "O numerador deve utilizar a mesma regra de atribuição da venda para evitar deslocamento entre EPS.",
				            "Quanto maior o percentual, maior a conversão da promessa comercial em matrícula efetiva."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            2,
				            "ETAPAS DO FUNIL",
				            1,
				            "MAILING",
				            "Quantidade de inscrições disponíveis para atuação da operação.",
				            "Medida de INSCRITOS ou contagem distinta de CHAVE_INSCRICAO.",
				            "Representa o universo de oportunidades disponibilizado para o Contact Center.",
				            "É o topo do funil e a base para cálculo de cobertura."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            2,
				            "ETAPAS DO FUNIL",
				            2,
				            "TRABALHADOS",
				            "Quantidade de inscrições únicas que tiveram atuação válida da EPS.",
				            "Contagem distinta de CHAVE_INSCRICAO conforme os status considerados trabalhados para cada EPS.",
				            "CONECTA+ e VOXPRIME possuem listas específicas de status válidos.",
				            "Mede o volume de mailing que recebeu atuação."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            2,
				            "ETAPAS DO FUNIL",
				            3,
				            "TENTATIVAS",
				            "Quantidade total de interações realizadas pela operação.",
				            "Soma de FLAG_TENTATIVA.",
				            "Uma mesma inscrição pode ter várias tentativas.",
				            "Representa esforço operacional e não necessariamente contato com o candidato."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            2,
				            "ETAPAS DO FUNIL",
				            4,
				            "ATENDIDOS",
				            "Quantidade de inscrições em que houve atendimento.",
				            "Contagem distinta de CHAVE_INSCRICAO classificada como atendida.",
				            "Atendido significa que o contato superou a tentativa, mas não necessariamente gerou uma conversa comercial efetiva.",
				            "Mede a capacidade de transformar esforço em contato."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            2,
				            "ETAPAS DO FUNIL",
				            5,
				            "EFETIVOS",
				            "Quantidade de inscrições em que houve uma interação comercial válida com o candidato.",
				            "Contagem distinta de CHAVE_INSCRICAO conforme a regra de efetividade de cada EPS.",
				            "Na CONECTA+, considera TABULACAO_HUMANA_4 igual a EFETIVO. Na VOXPRIME, considera FLAG_EFETIVO e exceções de ACEITOU OFERTA.",
				            "Representa as conversas com real potencial de conversão."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            2,
				            "ETAPAS DO FUNIL",
				            6,
				            "ALÔ",
				            "Quantidade de contatos válidos com o candidato.",
				            "Total de registros válidos, excluindo contato não realizado, caixa postal, telefone errado, blacklist, teste e registros em branco.",
				            "Não deve haver retirada de duplicidade quando a visão medir volume de contatos. O Alô não deve ser menor que as recusas.",
				            "Mede o volume real de engajamentos gerados pela operação."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            3,
				            "INDICADORES RELATIVOS",
				            1,
				            "SPIN",
				            "Quantidade média de tentativas realizadas por inscrição trabalhada.",
				            "Tentativas divididas por Trabalhados.",
				            "A mesma inscrição pode possuir várias tentativas.",
				            "Quanto maior o Spin, maior o esforço aplicado em cada inscrição."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            3,
				            "INDICADORES RELATIVOS",
				            2,
				            "% TRAB",
				            "Percentual do mailing que foi trabalhado.",
				            "Trabalhados divididos por Mailing.",
				            "Deve considerar trabalhados únicos por CHAVE_INSCRICAO.",
				            "Mede a cobertura da base disponibilizada."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            3,
				            "INDICADORES RELATIVOS",
				            3,
				            "HITRATE",
				            "Indicador de aproveitamento das tentativas em atendimento.",
				            "Atendidos divididos por Tentativas, conforme a medida vigente do painel.",
				            "Em algumas leituras operacionais também pode ser apresentado como esforço por atendimento. Confirmar o sentido utilizado na medida.",
				            "Quanto maior o percentual, melhor o aproveitamento do esforço de contato."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            3,
				            "INDICADORES RELATIVOS",
				            4,
				            "% ATENDIDO/BASE",
				            "Percentual do mailing que chegou à etapa de atendimento.",
				            "Atendidos divididos por Mailing.",
				            "Considera inscrições únicas atendidas.",
				            "Mede a capacidade de transformar base em atendimento."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            3,
				            "INDICADORES RELATIVOS",
				            5,
				            "% EFETIVO/BASE",
				            "Percentual do mailing que gerou interação comercial efetiva.",
				            "Efetivos divididos por Mailing.",
				            "Segue a regra de efetividade específica de cada EPS.",
				            "Mede a qualidade da cobertura, e não apenas o volume trabalhado."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            3,
				            "INDICADORES RELATIVOS",
				            6,
				            "% CONV VENDA",
				            "Percentual de contatos efetivos que foram convertidos em venda.",
				            "Vendas divididas por Efetivos.",
				            "A venda deve estar atribuída à EPS responsável pela primeira venda.",
				            "Mede a eficiência comercial depois de estabelecido o contato efetivo."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            3,
				            "INDICADORES RELATIVOS",
				            7,
				            "% RET",
				            "Percentual de perda ou retenção entre vendas e matrículas, conforme a medida configurada.",
				            "Utiliza a medida FUNIL | % RET.",
				            "A interpretação final deve respeitar a fórmula DAX atualmente utilizada no modelo.",
				            "Utilize em conjunto com MAT/VENDA para avaliar perdas após a venda."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            3,
				            "INDICADORES RELATIVOS",
				            8,
				            "% CONV MAT",
				            "Percentual de vendas convertidas em matrículas.",
				            "Matrículas divididas por Vendas.",
				            "A matrícula atribuída deve permanecer na EPS responsável pela venda.",
				            "Mede a efetividade da conversão final do funil."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            4,
				            "VISÕES",
				            1,
				            "FUNIL CONECTA+",
				            "Apresenta o funil completo da operação CONECTA+.",
				            "Aplica os filtros da página e as regras específicas de trabalhado e efetivo da CONECTA+.",
				            "A classificação de efetivo utiliza principalmente TABULACAO_HUMANA_4.",
				            "Permite avaliar cobertura, esforço, contato e conversão da CONECTA+."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            4,
				            "VISÕES",
				            2,
				            "FUNIL VOXPRIME",
				            "Apresenta o funil completo da operação VOXPRIME.",
				            "Aplica os filtros da página e as regras específicas de trabalhado e efetivo da VOXPRIME.",
				            "A classificação considera FLAG_EFETIVO e exceções de ACEITOU OFERTA.",
				            "Permite comparar o desempenho da estratégia VOXPRIME com as demais operações."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            4,
				            "VISÕES",
				            3,
				            "FUNIL CALL CENTER TOTAL",
				            "Consolida CONECTA+ e VOXPRIME em uma única visão.",
				            "Soma as operações respeitando as regras específicas de cada EPS.",
				            "Trabalhados e efetivos devem ser calculados separadamente por EPS antes da consolidação.",
				            "Representa o desempenho geral do Contact Center."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            4,
				            "VISÕES",
				            4,
				            "FUNIL MÍDIA",
				            "Apresenta o funil das inscrições classificadas no Super Canal Mídia.",
				            "Aplica filtro de SUPER_CANAL igual a MÍDIA.",
				            "A visão pode conter atuações de mais de uma EPS.",
				            "Permite avaliar especificamente a eficiência da captação originada em mídia."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            4,
				            "VISÕES",
				            5,
				            "CONTATOS POR DIA DA SEMANA",
				            "Compara o volume de inscrições e a taxa ou volume de Alô por dia da semana.",
				            "Agrupamento pela data de interação ou inscrição, conforme a medida do gráfico.",
				            "Sábados e domingos devem ser analisados separadamente por possuírem menor operação.",
				            "Ajuda a identificar os dias com melhor aproveitamento de contato."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            4,
				            "VISÕES",
				            6,
				            "PRODUTIVIDADE POR EPS",
				            "Compara vendas, matrículas, produtividade e conversão por EPS, modalidade e super canal.",
				            "Produtividade de matrícula é Matrículas divididas por HC multiplicado pelos dias úteis.",
				            "O HC deve variar por EPS e por mês.",
				            "Permite identificar qual operação e qual origem possuem maior produtividade."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            4,
				            "VISÕES",
				            7,
				            "COHORT DE ALÔ",
				            "Distribui os contatos válidos conforme a quantidade de dias transcorridos desde a inscrição.",
				            "Diferença entre DATA_TABULACAO e DATA_INSCRICAO, classificada de D0 até D15+.",
				            "D0 representa o mesmo dia da inscrição. D15+ representa contatos realizados após quinze dias.",
				            "Mede a velocidade de atuação e o envelhecimento da base."
				        },
				
				        {
				            1,
				            "FUNIL CC 27.1",
				            4,
				            "VISÕES",
				            8,
				            "ACUMULADO PLANEJADO X REALIZADO",
				            "Compara o volume acumulado planejado com o volume acumulado realizado.",
				            "Soma acumulada diária ou mensal do planejamento e do realizado.",
				            "O realizado deve respeitar os filtros da página.",
				            "Mostra antecipadamente a abertura ou fechamento do gap em relação ao plano."
				        },
				
				        /* =====================================================
				           3. ACUMULADO DO CICLO
				           ===================================================== */
				
				        {
				            2,
				            "ACUMULADO CICLO",
				            1,
				            "CARDS",
				            1,
				            "PACE REAL",
				            "Média diária realizada até a data selecionada.",
				            "Realizado acumulado dividido pelos dias úteis trabalhados.",
				            "Deve considerar apenas dias úteis e os feriados definidos na regra do painel.",
				            "Mostra a velocidade atual de entrega."
				        },
				
				        {
				            2,
				            "ACUMULADO CICLO",
				            1,
				            "CARDS",
				            2,
				            "PACE IDEAL",
				            "Média diária necessária para alcançar o planejamento ou meta.",
				            "Volume planejado dividido pelos dias úteis do período.",
				            "O cálculo deve respeitar o período e os dias úteis restantes.",
				            "Compara a velocidade necessária com a velocidade atual."
				        },
				
				        {
				            2,
				            "ACUMULADO CICLO",
				            1,
				            "CARDS",
				            3,
				            "PRODUTIVIDADE",
				            "Quantidade média de matrículas produzidas por operador por dia útil.",
				            "Matrículas divididas por HC vezes dias úteis.",
				            "O HC deve ser calculado por EPS e por mês. Na seleção de vários meses, deve somar HC vezes dias úteis de cada mês.",
				            "Mede a eficiência da estrutura operacional."
				        },
				
				        {
				            2,
				            "ACUMULADO CICLO",
				            1,
				            "CARDS",
				            4,
				            "GAP MAT REAL X PLAN",
				            "Diferença entre matrículas realizadas e matrículas planejadas.",
				            "Matrículas realizadas menos Matrículas planejadas.",
				            "Valor negativo representa déficit. Valor positivo representa superação.",
				            "Mostra o volume ainda necessário para alcançar o planejamento."
				        },
				
				        {
				            2,
				            "ACUMULADO CICLO",
				            2,
				            "GRÁFICOS",
				            1,
				            "ACUMULADO VENDAS X MAT",
				            "Compara a evolução acumulada de vendas e matrículas.",
				            "Soma acumulada das medidas de vendas e matrículas ao longo do período.",
				            "As duas curvas podem possuir ritmos diferentes devido ao tempo de maturação entre venda e matrícula.",
				            "Ajuda a identificar represamento entre venda e matrícula."
				        },
				
				        {
				            2,
				            "ACUMULADO CICLO",
				            2,
