			    " pagamentos"
			)
		lineageTag: 180c59dd-b8c2-41ea-ac8a-d197b4a8e460

	measure 'Insight Executivo Texto' =
			
			VAR _ID =
			    SELECTEDVALUE(
			        'DIM_INSIGHTS_EXECUTIVOS'[ID]
			    )
			
			RETURN
			
			SWITCH(
			
			    _ID,
			
			    /* =========================================================
			       1. RITMO / PACE
			       ========================================================= */
			    1,
			        VAR _Pace =
			            [Pace Matrícula]
			
			        VAR _Variacao =
			            [Variação Pace 5DU %]
			
			        RETURN
			        SWITCH(
			            TRUE(),
			
			            ISBLANK(_Pace),
			                "Sem pace disponível no período",
			
			            _Variacao >= 0.05,
			                "🟢 Pace " &
			                FORMAT(_Pace, "0.0") &
			                " mat/DU | +" &
			                FORMAT(_Variacao, "0%") &
			                " vs 5 DU anteriores",
			
			            _Variacao <= -0.05,
			                "🔴 Pace " &
			                FORMAT(_Pace, "0.0") &
			                " mat/DU | " &
			                FORMAT(_Variacao, "0%") &
			                " vs 5 DU anteriores",
			
			            "🟠 Pace " &
			            FORMAT(_Pace, "0.0") &
			            " mat/DU | ritmo estável"
			        ),
			
			
			    /* =========================================================
			       2. ALÔ
			       ========================================================= */
			    2,
			        VAR _Alo =
			            [ATENDIDO/BASE]
			
			        VAR _Mailing =
			            [Mailing]
			
			        VAR _Atendidos =
			            [ATENDIDO]
			
			        VAR _NaoAtendidos =
			            MAX(
			                0,
			                _Mailing - _Atendidos
			            )
			
			        VAR _TemConsultor =
			            HASONEVALUE(
			                'DIM_CONSULTOR'[nm_consultor_recebimento]
			            )
			
			        VAR _AloOperacao =
			            CALCULATE(
			                [ATENDIDO],
			                REMOVEFILTERS(
			                    'DIM_CONSULTOR'[nm_consultor_recebimento]
			                )
			            )
			
			        VAR _Gap =
			            (_Alo - _AloOperacao) * 100
			
			        RETURN
			        IF(
			            ISBLANK(_Alo),
			
			            "Sem informação de Alô",
			
			            IF(
			                _TemConsultor,
			
			                IF(
			                    _Gap >= 0,
			
			                    "🟢 Alô " &
			                    FORMAT(_Alo, "0.0%") &
			                    " | +" &
			                    FORMAT(_Gap, "0.0") &
			                    " p.p. vs operação",
			
			                    "🟠 Alô " &
			                    FORMAT(_Alo, "0.0%") &
			                    " | " &
			                    FORMAT(_Gap, "0.0") &
			                    " p.p. vs operação | " &
			                    FORMAT(_NaoAtendidos, "#,0") &
			                    " sem atendimento"
			                ),
			
			                "Alô " &
			                FORMAT(_Alo, "0.0%") &
			                " | " &
			                FORMAT(_Atendidos, "#,0") &
			                " atendidos de " &
			                FORMAT(_Mailing, "#,0") &
			                " contatos"
			            )
			        ),
			
			
			    /* =========================================================
			       3. TMA
			       ========================================================= */
			    3,
			        VAR _TMA =
			            [TMA Atual Seg]
			
			        VAR _TMAFormatado =
			            [TMA Atual Formatado]
			
			        VAR _TemConsultor =
			            HASONEVALUE(
			                'DIM_CONSULTOR'[nm_consultor_recebimento]
			            )
			
			        VAR _TMAOperacao =
			            CALCULATE(
			                [TMA Atual Seg],
			                REMOVEFILTERS(
			                    'DIM_CONSULTOR'[nm_consultor_recebimento]
			                )
			            )
			
			        VAR _Variacao =
			            DIVIDE(
			                _TMA - _TMAOperacao,
			                _TMAOperacao,
			                0
			            )
			
			        RETURN
			        IF(
			            ISBLANK(_TMA),
			
			            "Sem informação de TMA",
			
			            IF(
			                _TemConsultor,
			
			                IF(
			                    _Variacao > 0.10,
			
			                    "🔴 TMA " &
			                    _TMAFormatado &
			                    " | +" &
			                    FORMAT(_Variacao, "0%") &
			                    " vs operação",
			
			                    IF(
			                        _Variacao < -0.10,
			
			                        "🟢 TMA " &
			                        _TMAFormatado &
			                        " | " &
			                        FORMAT(_Variacao, "0%") &
			                        " vs operação",
			
			                        "🟠 TMA " &
			                        _TMAFormatado &
			                        " | próximo da operação"
			                    )
			                ),
			
			                "TMA " &
			                _TMAFormatado &
			                " | capacidade sobre jornada de 8h/DU"
			            )
			        ),
			
			
			    /* =========================================================
			       4. TEMPO DE ESPERA
			       ========================================================= */
			    4,
			        VAR _Espera =
			            [Tempo Médio Espera Seg]
			
			        VAR _EsperaFormatada =
			            [Tempo Médio Espera]
			
			        VAR _TemConsultor =
			            HASONEVALUE(
			                'DIM_CONSULTOR'[nm_consultor_recebimento]
			            )
			
			        VAR _EsperaOperacao =
			            CALCULATE(
			                [Tempo Médio Espera Seg],
			                REMOVEFILTERS(
			                    'DIM_CONSULTOR'[nm_consultor_recebimento]
			                )
			            )
			
			        VAR _Variacao =
			            DIVIDE(
			                _Espera - _EsperaOperacao,
			                _EsperaOperacao,
			                0
			            )
			
			        RETURN
			        IF(
			            ISBLANK(_Espera),
			
			            "Sem informação de espera",
			
			            IF(
			                _TemConsultor,
			
			                IF(
			                    _Variacao >= 0.10,
			
			                    "🔴 Espera " &
			                    _EsperaFormatada &
			                    " | +" &
			                    FORMAT(_Variacao, "0%") &
			                    " vs operação",
			
			                    IF(
			                        _Variacao <= -0.10,
			
			                        "🟢 Espera " &
			                        _EsperaFormatada &
			                        " | " &
			                        FORMAT(_Variacao, "0%") &
			                        " vs operação",
			
			                        "🟠 Espera " &
			                        _EsperaFormatada &
			                        " | próxima da operação"
			                    )
			                ),
			
			                "Espera média " &
			                _EsperaFormatada
			            )
			        ),
			
			
			    /* =========================================================
			       5. MELHOR DIA
			       ========================================================= */
			    5,
			        VAR _Data =
			            [Melhor Dia]
			
			        VAR _Mat =
			            CALCULATE(
			                [MATRICULAS],
			                TREATAS(
			                    {_Data},
			                    'Dim_Data'[Date]
			                )
			            )
			
			        VAR _Pace =
			            [Pace Matrícula]
			
			        VAR _Variacao =
			            DIVIDE(
			                _Mat - _Pace,
			                _Pace,
			                0
			            )
			
			        VAR _AloDia =
			            CALCULATE(
			                [ATENDIDO/BASE],
			                TREATAS(
			                    {_Data},
			                    'Dim_Data'[Date]
			                )
			            )
			
			        VAR _EfetDia =
			            CALCULATE(
			                [EFETIVO/BASE],
			                TREATAS(
			                    {_Data},
			                    'Dim_Data'[Date]
			                )
			            )
			
			        VAR _AloAtual =
			            [ATENDIDO/BASE]
			
			        VAR _EfetAtual =
			            [EFETIVO/BASE]
			
			        VAR _GapAlo =
			            (_AloDia - _AloAtual) * 100
			
			        VAR _GapEfet =
			            (_EfetDia - _EfetAtual) * 100
			
			        VAR _Destaque =
			            SWITCH(
			                TRUE(),
			
			                _GapEfet > _GapAlo
			                    && _GapEfet > 0,
			                    " | efetividade +" &
			                    FORMAT(_GapEfet, "0.0") &
			                    " p.p.",
			
			                _GapAlo > 0,
			                    " | Alô +" &
			                    FORMAT(_GapAlo, "0.0") &
			                    " p.p.",
			
			                ""
			            )
			
			        RETURN
			        IF(
			            ISBLANK(_Data),
			
			            "Sem dia elegível no período",
			
			            "🟢 " &
			            FORMAT(_Data, "dd/MM") &
			            " | " &
			            FORMAT(_Mat, "#,0") &
			            " mat | " &
			            FORMAT(
			                _Variacao,
			                "+0%;-0%;0%"
			            ) &
			            " vs pace" &
			            _Destaque
			        ),
			
			
			    /* =========================================================
			       6. DIA CRÍTICO
			       ========================================================= */
			    6,
			        VAR _Data =
			            [Dia Crítico]
			
			        VAR _Mat =
			            CALCULATE(
			                [MATRICULAS],
			                TREATAS(
			                    {_Data},
			                    'Dim_Data'[Date]
			                )
			            )
			
			        VAR _Pace =
			            [Pace Matrícula]
			
			        VAR _Variacao =
			            DIVIDE(
			                _Mat - _Pace,
			                _Pace,
			                0
			            )
			
			        VAR _AloDia =
			            CALCULATE(
			                [ATENDIDO/BASE],
			                TREATAS(
			                    {_Data},
			                    'Dim_Data'[Date]
			                )
			            )
			
			        VAR _EfetDia =
			            CALCULATE(
			                [EFETIVO/BASE],
			                TREATAS(
			                    {_Data},
			                    'Dim_Data'[Date]
			                )
			            )
			
			        VAR _AloAtual =
			            [ATENDIDO/BASE]
			
			        VAR _EfetAtual =
			            [EFETIVO/BASE]
			
			        VAR _GapAlo =
			            (_AloDia - _AloAtual) * 100
			
			        VAR _GapEfet =
			            (_EfetDia - _EfetAtual) * 100
			
			        VAR _Causa =
			            SWITCH(
			                TRUE(),
			
			                _GapAlo < _GapEfet
			                    && _GapAlo < 0,
			                    " | Alô " &
			                    FORMAT(_GapAlo, "0.0") &
			                    " p.p.",
			
			                _GapEfet < 0,
			                    " | efetividade " &
			                    FORMAT(_GapEfet, "0.0") &
			                    " p.p.",
			
			                " | pressão concentrada na conversão"
			            )
			
			        RETURN
			        IF(
			            ISBLANK(_Data),
			
			            "Sem dia crítico elegível",
			
			            "🔴 " &
			            FORMAT(_Data, "dd/MM") &
			            " | " &
			            FORMAT(_Mat, "#,0") &
			            " mat | " &
			            FORMAT(
			                _Variacao,
			                "+0%;-0%;0%"
			            ) &
			            " vs pace" &
			            _Causa
			        ),
			
			
			    /* =========================================================
			       7. FECHAMENTO
			       ========================================================= */
			    7,
			        VAR _Mat =
			            [MATRICULAS]
			
			        VAR _Pgto =
			            [Pagamentos]
			
			        VAR _Gap =
			            _Mat - _Pgto
			
			        VAR _Realizacao =
			            DIVIDE(
			                _Pgto,
			                _Mat,
			                0
			            )
			
			        RETURN
			        SWITCH(
			            TRUE(),
			
			            _Mat = 0
			                && _Pgto = 0,
			                "Sem resultado comercial no período",
			
			            _Pgto > _Mat,
			                "🟠 " &
			                FORMAT(_Pgto, "#,0") &
			                " pgto vs " &
			                FORMAT(_Mat, "#,0") &
			                " mat | validar Cohort",
			
			            _Realizacao >= 0.80,
			                "🟢 Fechamento " &
			                FORMAT(_Realizacao, "0.0%") &
			                " | " &
			                FORMAT(_Gap, "#,0") &
			                " mat pendentes",
			
			            _Realizacao >= 0.65,
			                "🟠 Fechamento " &
			                FORMAT(_Realizacao, "0.0%") &
			                " | " &
			                FORMAT(_Gap, "#,0") &
			                " pendentes | reforçar follow-up",
			
			            "🔴 Fechamento " &
			            FORMAT(_Realizacao, "0.0%") &
			            " | " &
			            FORMAT(_Gap, "#,0") &
			            " pendentes | atuação prioritária"
			        ),
			
			
			    /* =========================================================
			       8. PRINCIPAL OPORTUNIDADE
			       ========================================================= */
			    8,
			        VAR _NaoAtendidos =
			            MAX(
			                0,
			                [Mailing] - [ATENDIDO]
			            )
			
			        VAR _NaoEfetivos =
			            MAX(
			                0,
			                [ATENDIDO] - [EFETIVO]
			            )
			
			        VAR _EfetivosSemMat =
			            MAX(
			                0,
			                [EFETIVO] - [MATRICULAS]
			            )
			
			        VAR _PotAlo =
			            ROUND(
			                _NaoAtendidos
			                    * [ATENDIDO/BASE]
			                    * [EFETIVO/BASE]
			                    * [Conv Efetivo Matrícula %],
			                0
			            )
			
			        VAR _PotEfetividade =
			            ROUND(
			                _NaoEfetivos
			                    * [EFETIVO/BASE]
			                    * [Conv Efetivo Matrícula %],
			                0
			            )
			
			        VAR _PotConversao =
			            ROUND(
			                _EfetivosSemMat
			                    * [Conv Efetivo Matrícula %],
			                0
			            )
			
			        VAR _PotBase =
			            ROUND(
			                [Não Trabalhados]
			                    * [RETORNO],
			                0
			            )
			
			        VAR _PotTMA =
			            COALESCE(
			                [Matrículas Potenciais TMA],
			                0
			            )
			
			        VAR _Maior =
			            MAX(
			                _PotAlo,
			                MAX(
			                    _PotEfetividade,
			                    MAX(
			                        _PotConversao,
			                        MAX(
			                            _PotBase,
			                            _PotTMA
			                        )
			                    )
			                )
			            )
			
			        RETURN
			        SWITCH(
			            TRUE(),
			
			            _Maior <= 0,
			                "🟢 Sem gap material | foco em sustentar o pace",
			
			            _Maior = _PotConversao,
			                "🟣 Efetivos concentram a maior oportunidade | +" &
			                FORMAT(_Maior, "#,0") &
			                " mat potenciais",
			
			            _Maior = _PotEfetividade,
			                "🟣 Efetividade é a principal alavanca | +" &
			                FORMAT(_Maior, "#,0") &
			                " mat potenciais",
			
			            _Maior = _PotAlo,
			                "🟣 Alô concentra a maior oportunidade | +" &
			                FORMAT(_Maior, "#,0") &
			                " mat potenciais",
			
			            _Maior = _PotBase,
			                "🟣 Base não trabalhada concentra a oportunidade | +" &
			                FORMAT(_Maior, "#,0") &
			                " mat potenciais",
			
			            "🟣 TMA é a maior alavanca de capacidade | +" &
			            FORMAT(_Maior, "#,0") &
			            " mat potenciais"
			        ),
			
			
			    /* =========================================================
			       9. PLANO DE RECUPERAÇÃO
			       ========================================================= */
			    9,
			        VAR _NaoAtendidos =
			            MAX(
			                0,
			                [Mailing] - [ATENDIDO]
			            )
			
			        VAR _NaoEfetivos =
			            MAX(
			                0,
			                [ATENDIDO] - [EFETIVO]
			            )
			
			        VAR _EfetivosSemMat =
			            MAX(
			                0,
			                [EFETIVO/BASE] - [MATRICULAS]
			            )
			
			        VAR _PotAlo =
			            ROUND(
			                _NaoAtendidos
			                    * [ATENDIDO/BASE]
			                    * [EFETIVO/BASE]
			                    * [Conv Efetivo Matrícula %],
			                0
			            )
			
			        VAR _PotEfetividade =
			            ROUND(
			                _NaoEfetivos
			                    * [EFETIVO/BASE]
			                    * [Conv Efetivo Matrícula %],
			                0
			            )
			
			        VAR _PotConversao =
			            ROUND(
			                _EfetivosSemMat
			                    * [Conv Efetivo Matrícula %],
			                0
			            )
			
			        VAR _PotBase =
			            ROUND(
			                [Não Trabalhados]
			                    * [RETORNO],
			                0
			            )
			
			        VAR _PotTMA =
			            COALESCE(
			                [Matrículas Potenciais TMA],
			                0
			            )
			
			        VAR _Maior =
			            MAX(
			                _PotAlo,
			                MAX(
			                    _PotEfetividade,
			                    MAX(
			                        _PotConversao,
			                        MAX(
			                            _PotBase,
			                            _PotTMA
			                        )
			                    )
			                )
			            )
			
			        RETURN
			        SWITCH(
			            TRUE(),
			
			            _Maior <= 0,
			                "🔵 Sustentar o ritmo atual e concentrar volume nas melhores janelas",
			
			            _Maior = _PotConversao,
			                "🔵 Priorizar efetivos sem matrícula | intensificar follow-up e fechamento",
			
			            _Maior = _PotEfetividade,
			                "🔵 Revisar abordagem e objeções | replicar prática dos melhores consultores",
			
			            _Maior = _PotAlo,
			                "🔵 Acelerar contato | priorizar D0/D1 e reforçar novas tentativas",
			
			            _Maior = _PotBase,
			                "🔵 Dar vazão ao estoque | redistribuir e priorizar base não trabalhada",
			
			            "🔵 Ganhar capacidade | reduzir TMA e tempo improdutivo sem perder qualidade"
			        ),
			
			    BLANK()
			)
		lineageTag: 6ac18cf7-ac11-4f71-be40-d6853379ad62

	measure 'Insight Eficiência' =
			
			VAR _Curso = [Curso Melhor Conv Mat]
			VAR _Conv = [Melhor Conv Mat %]
			
			RETURN
			IF(
			    NOT ISBLANK(_Curso),
			    "🟢 " &
			    _Curso &
			    ": melhor conversão Mat x Pag | " &
			    FORMAT(_Conv, "0.0%")
			)
		lineageTag: 3eb1fcaf-b367-4be2-ab0d-e5daff5a16ea

