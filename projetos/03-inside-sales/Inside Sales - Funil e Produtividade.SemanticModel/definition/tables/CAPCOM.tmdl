	measure 'Insight Oportunidade' =
			
			VAR _Curso =
			    [Curso Maior Oportunidade]
			
			VAR _NaoTrab =
			    CALCULATE(
			        [Não Trabalhados],
			        TREATAS(
			            {_Curso},
			            'DIM_CURSO'[ds_curso_ic]
			        )
			    )
			
			VAR _Conv =
			    CALCULATE(
			        [CONV PAG],
			        TREATAS(
			            {_Curso},
			            'DIM_CURSO'[ds_curso_ic]
			        )
			    )
			
			RETURN
			IF(
			    NOT(ISBLANK(_Curso)),
			
			    _Curso &
			    " concentra a principal oportunidade comercial, com " &
			    FORMAT(_NaoTrab, "#,0") &
			    " contatos ainda não trabalhados e conversão histórica para pagamento de " &
			    FORMAT(_Conv, "0.0%") &
			    "."
			)
		lineageTag: cda2a25f-a994-4b6e-97c2-b35f4c1deafc

	measure 'Status Comercial' =
			
			VAR _Realizacao =
			    [Realização Pgto %]
			
			VAR _NaoTrab =
			    [% Não Trabalhado]
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    _Realizacao >= 0.80 && _NaoTrab <= 0.10,
			        "🟢 Operação saudável",
			
			    _Realizacao >= 0.65,
			        "🟠 Atenção ao fechamento",
			
			    "🔴 Prioridade de atuação"
			)
		lineageTag: d87a1ca6-673c-4ccd-96ab-1a8dc0856449

