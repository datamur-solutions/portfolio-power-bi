	measure 'Insight Performance Consultor' =
			
			VAR _Consultor =
			    SELECTEDVALUE(
			        'DIM_CONSULTOR'[nm_consultor_recebimento]
			    )
			
			VAR _CursoMat =
			    [Curso Top Matrícula]
			
			VAR _QtdMat =
			    [Mat Curso Top]
			
			VAR _CursoPgto =
			    [Curso Top Pagamento]
			
			VAR _QtdPgto =
			    [Pgto Curso Top]
			
			VAR _CursoConv =
			    [Curso Melhor Conv Pgto]
			
			VAR _ConvPgto =
			    [Melhor Conv Pgto %]
			
			RETURN
			IF(
			    NOT ISBLANK(_Consultor),
			
			    _Consultor &
			    " concentra sua maior produção de matrículas em " &
			    _CursoMat &
			    ", com " &
			    FORMAT(_QtdMat, "#,0") &
			    " matrículas. Em pagamentos, o destaque é " &
			    _CursoPgto &
			    ", com " &
			    FORMAT(_QtdPgto, "#,0") &
			    ". Sua melhor eficiência para pagamento ocorre em " &
			    _CursoConv &
			    ", com conversão de " &
			    FORMAT(_ConvPgto, "0.0%") &
			    "."
			)
		lineageTag: 977907a0-1528-430a-95ab-a6a82d2d1f62

	measure 'Curso Melhor Conv Pgto' =
			
