	column COHORT =
			
			VAR Dias =
			    DATEDIFF(
			        'CAPCOM'[dt_inscricao_ic],
			        'CAPCOM'[dt_matricula_ic],
			        DAY
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK('CAPCOM'[dt_inscricao_ic]) || ISBLANK('CAPCOM'[dt_matricula]), BLANK(),
			        Dias < 0, BLANK(),
			        Dias >= 15, "D15+",
			        "D" & Dias
			    )
		lineageTag: 3d9a8553-7d2f-43d4-9d1f-2c5fb1081f09
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

