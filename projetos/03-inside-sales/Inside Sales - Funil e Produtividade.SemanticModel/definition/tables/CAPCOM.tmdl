table CAPCOM
	lineageTag: 36ca62c1-0825-4542-ac4a-97f1efc1acb9

	measure MATRICULAS = CALCULATE(SUM(CAPCOM[fl_mat_liq]))
		formatString: #,0
		lineageTag: 9b72a661-6d85-4f2f-8393-7df3c3f3eb82

	measure PAGAMENTOS =
			
			CALCULATE(
			    DISTINCTCOUNT('CAPCOM'[ds_bk_inscricao]),
			    'CAPCOM'[ksa_pagamento_status] = "PAGO"
			)
		formatString: #,0
		lineageTag: 71dd3403-5969-4e2e-b4da-64dcf3b550af

	measure 'DT BASE' =
			
			"DT BASE " &
			FORMAT(
			    CALCULATE(
			        MAX('CAPCOM'[dt_base]),
			        ALL('CAPCOM')
			    ),
			    "dd/mm/yyyy"
			)
		lineageTag: 128487a0-0e72-401b-9e77-2c89f035326b

	measure 'Realização Pagamento %' =
			
			DIVIDE(
			    [MATRICULAS],
			    [PAGAMENTOS],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4f8da5a6-2a7e-4cb4-9679-61eb1ab976c0

	measure 'Prod Pagamento' =
			
			DIVIDE(
			    [Pagamentos],
			    [Dias Úteis],
			    0
			)
		lineageTag: 5bfb2946-0c2b-4525-8226-4c485f47233e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Não Trabalhados' =
			
			[Mailing] - [TRABALHADO]
		formatString: #,0
		lineageTag: f3a8c7d5-0861-4251-af90-38cd34ecb37b

	measure 'Gap Mat x Pgto' =
			
			[PAGAMENTOS] - [MATRICULAS]
		formatString: 0
		lineageTag: 605c6527-a38c-4aa6-ad9e-2b0507f34126

	measure 'Mat Curso Top' =
			
			VAR _Cursos =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED('DIM_CURSO'[ds_curso_ic]),
			            "@Matriculas", [MATRICULAS]
			        ),
			        [@Matriculas] > 0
			    )
			
			RETURN
			    MAXX(
			        TOPN(
			            1,
			            _Cursos,
			            [@Matriculas], DESC
			        ),
			        [@Matriculas]
			    )
		formatString: 0
		lineageTag: 7009c733-d310-458b-8fb7-5b445a2c266b

	measure 'Curso Top Pagamento' =
			
			VAR _Cursos =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED('DIM_CURSO'[ds_curso_ic]),
			            "@Pagamentos", [Pagamentos]
			        ),
			        [@Pagamentos] > 0
			    )
			
			VAR _Top =
			    TOPN(
			        1,
			        _Cursos,
			        [@Pagamentos], DESC,
			        'DIM_CURSO'[ds_curso_ic], ASC
			    )
			
			RETURN
			    CONCATENATEX(
			        _Top,
			        'DIM_CURSO'[ds_curso_ic],
			        ", "
			    )
		lineageTag: 79e56f9e-26e1-4968-99db-7bc8b55ee591

