	measure 'Insight Gap Pagamento' =
			
			VAR _Mat =
			    [MATRICULAS]
			
			VAR _Pgto =
			    [Pagamentos]
			
			VAR _Gap =
			    _Mat - _Pgto
			
			VAR _Realizacao =
			    DIVIDE(
			        _Pgto,
			        _Mat,
			        0
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    _Mat = 0 && _Pgto = 0,
			        "Sem resultado comercial no período",
			
			    _Pgto > _Mat,
			        "🔴 Pgto supera mat em " &
			        FORMAT(ABS(_Gap), "#,0") &
			        " | revisar coorte/data",
			
			    _Gap > 0,
			        "🟠 " &
			        FORMAT(_Gap, "#,0") &
			        " matrículas sem pgto | " &
			        FORMAT(_Realizacao, "0.0%") &
			        " realização | reforçar follow-up",
			
			    "🟢 Matrículas convertidas em pagamento"
			)
		lineageTag: e9e1b7d2-54a7-41bc-9d2d-b25f5edbd315

	measure 'Realização Pgto %' =
			
			DIVIDE(
			    [MATRICULAS],
