table Dim_Data
	lineageTag: 9703208f-6697-4ae1-af5e-72de33217e48

	measure 'Dias Úteis' =
			
			CALCULATE(
			    COUNTROWS('Dim_Data'),
			    'Dim_Data'[É Dia Útil] = 1
			)
		formatString: 0
		lineageTag: 36ba02a4-7799-468a-b1d1-1e527f91fce3

	measure 'HC Ativo' =
			
			COUNTROWS(
			    FILTER(
			        VALUES('DIM_CONSULTOR'[nm_consultor_recebimento]),
			        CALCULATE([TRABALHADO]) > 0
			    )
			)
		formatString: 0
		lineageTag: bb6ae812-5350-42a8-87a1-f89b9aa923a9

	measure 'Produtividade Total' =
			
			DIVIDE(
			    [MATRICULAS],
			    [HC Ativo] * [Dias Úteis],
			    0
			)
		lineageTag: 292075cd-aacd-452d-9894-bf63a31ba753

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Produtividade Consultor' =
			
			DIVIDE(
			    [MATRICULAS],
			    [Dias Úteis],
			    0
			)
		lineageTag: 96e4c02b-6671-4527-9036-ea66a9348967

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PROD =
			
			VAR _Matriculas =
			    [MATRICULAS]
			
			VAR _DiasUteis =
			    [Dias Úteis]
			
			RETURN
			    DIVIDE(
			        _Matriculas,
			        _DiasUteis,
			        0
			    )
		formatString: 0.0
		lineageTag: 4b9d8753-532b-4df4-aa5e-7d72cc29cbcc

	column Date
