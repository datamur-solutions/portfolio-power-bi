	measure ATENDIDO/BASE = CALCULATE(DIVIDE([ATENDIDO],[MAILING]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e7f5a2b9-aa2c-434f-b5e9-8a6916b20735

	measure EFETIVO/BASE = CALCULATE(DIVIDE([EFETIVO],[MAILING]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6a0e3f59-0aad-4605-9365-96befd792077

	measure TRABALHADO/BASE = CALCULATE(DIVIDE([TRABALHADO],[MAILING]))
		lineageTag: 0b4def74-b5f9-4fdc-8fcc-3f52d719abdd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SPIN = CALCULATE(DIVIDE([TENTATIVA],[TRABALHADO]))
		formatString: 0.0
		lineageTag: 030ef290-3013-42dd-8555-6bc7be5edbb6

	measure HITRATE = CALCULATE(DIVIDE([ATENDIDO],[TENTATIVA]))
