			        _Tabela,
			        [@Volume]
			    )
		formatString: 0
		lineageTag: a1af72d4-64fb-4e16-8632-8db6ece6647f

	measure 'Insight Executivo Consultor' =
			
			VAR _Consultor =
			    SELECTEDVALUE(
			        'DIM_CONSULTOR'[nm_consultor_recebimento]
			    )
			
			VAR _CursoTop =
			    [Curso Top Matrícula]
			
			VAR _MatTop =
			    [Mat Curso Top]
			
			VAR _CursoPgto =
			    [Curso Top Pagamento]
			
			VAR _PgtoTop =
			    [Pgto Curso Top]
			
			VAR _CursoBaixo =
			    [Curso Menor Produção]
			
			VAR _CursoEficiente =
			    [Curso Melhor Conv Pgto]
			
			VAR _Conv =
			    [Melhor Conv Pgto %]
			
			RETURN
			IF(
			    NOT ISBLANK(_Consultor),
			
			    _Consultor &
			    " concentra seu maior volume de matrículas em " &
			    _CursoTop &
			    ", com " &
			    FORMAT(_MatTop, "#,0") &
			    " matrículas. Em pagamentos, o principal destaque é " &
			    _CursoPgto &
			    ", com " &
			    FORMAT(_PgtoTop, "#,0") &
			    ". O menor volume está em " &
			    _CursoBaixo &
			    ", enquanto sua maior eficiência para pagamento ocorre em " &
			    _CursoEficiente &
			    ", com conversão de " &
			    FORMAT(_Conv, "0.0%") &
			    "."
			)
		lineageTag: 7ba5cb8d-5463-47cd-8de1-9c55fdd76fcb

	measure 'Score Oportunidade Mat' =
			
			[Não Trabalhados] * [RETORNO]
		formatString: #,0
		lineageTag: 3df93234-48d2-4f14-8ee4-ac7ffa28276d

	measure 'Curso Unidade Maior Oportunidade' =
			
			VAR _Tabela =
			    FILTER(
			        ADDCOLUMNS(
			            CROSSJOIN(
			                ALLSELECTED('DIM_CURSO'[ds_curso_ic]),
			                ALLSELECTED('DIM_UNIDADE'[nome_siga_ic])
			            ),
			            "@Estoque", CALCULATE([Não Trabalhados]),
			            "@ConvPgto", CALCULATE([CONV PAG]),
			            "@Score", CALCULATE([Score Oportunidade Pgto])
			        ),
			        [@Estoque] >= 30
			            && [@ConvPgto] > 0
			    )
			
			VAR _Top =
			    TOPN(
			        1,
			        _Tabela,
			        [@Score], DESC,
			        [@Estoque], DESC
			    )
			
			RETURN
			    CONCATENATEX(
			        _Top,
			        'DIM_CURSO'[ds_curso_ic] &
			        " | " &
			        'DIM_UNIDADE'[nome_siga_ic],
			        ""
			    )
		lineageTag: 09ee533d-e4d6-4f7c-811c-1c946131821f

	measure 'Estoque Maior Oportunidade' =
			
			VAR _Tabela =
			    FILTER(
			        ADDCOLUMNS(
			            CROSSJOIN(
			                ALLSELECTED('DIM_CURSO'[ds_curso_ic]),
			                ALLSELECTED('DIM_UNIDADE'[nome_siga_ic])
			            ),
			            "@Estoque", CALCULATE([Não Trabalhados]),
			            "@Score", CALCULATE([Score Oportunidade Pgto])
			        ),
			        [@Estoque] > 0
			    )
			
			VAR _Top =
			    TOPN(
			        1,
			        _Tabela,
			        [@Score], DESC
			    )
			
			RETURN
			    MAXX(
			        _Top,
			        [@Estoque]
			    )
		formatString: 0
		lineageTag: cbf5a0f6-2512-4302-97d3-d03c1b53dff2

	measure 'Insight Alocação Mailing' =
			
			VAR _Curso =
			    [Curso Maior Estoque]
			
			VAR _Estoque =
			    [Maior Estoque Não Trabalhado]
			
			VAR _Consultor =
			    CALCULATE(
			        [Melhor Consultor Pgto],
			        TREATAS(
			            {_Curso},
			            'DIM_CURSO'[ds_curso_ic]
			        )
			    )
			
			VAR _Conv =
			    CALCULATE(
			        [Melhor Consultor Conv Pgto %],
			        TREATAS(
			            {_Curso},
			            'DIM_CURSO'[ds_curso_ic]
			        )
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(_Curso),
			
			    _Curso &
			    " possui " &
			    FORMAT(_Estoque, "#,0") &
			    " contatos ainda não trabalhados. " &
			    _Consultor &
			    " apresenta a melhor eficiência para pagamento neste curso, com conversão de " &
			    FORMAT(_Conv, "0.0%") &
			    ", indicando oportunidade de priorização de mailing."
			)
		lineageTag: fe9c16ca-f3c1-461d-9930-653d459c36e3

	measure 'Melhor Consultor Pgto' =
			
			VAR _Tabela =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED('DIM_CONSULTOR'[nm_consultor_recebimento]),
			            "@Mailing", [Mailing],
			            "@Conversao", [CONV PAG],
			            "@Pagamentos", [Pagamentos]
			        ),
			        [@Mailing] >= 30
			            && [@Pagamentos] > 0
			    )
			
			VAR _Top =
			    TOPN(
			        1,
			        _Tabela,
			        [@Conversao], DESC,
			        [@Pagamentos], DESC
			    )
			
			RETURN
			    CONCATENATEX(
			        _Top,
			        'DIM_CONSULTOR'[nm_consultor_recebimento],
			        ", "
			    )
		lineageTag: cd923a48-1296-4d6b-a47d-f1b68407e99e

	measure 'Melhor Consultor MAT' =
			
			VAR _Tabela =
			    FILTER(
			        ADDCOLUMNS(
