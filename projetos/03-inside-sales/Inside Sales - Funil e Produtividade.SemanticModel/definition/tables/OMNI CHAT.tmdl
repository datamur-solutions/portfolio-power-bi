		lineageTag: b27439fa-8f86-475f-9644-3b92d5ed3351

	measure 'Melhor Consultor Conv Pgto %' =
			
			VAR _Tabela =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED('DIM_CONSULTOR'[nm_consultor_recebimento]),
			            "@Mailing", [Mailing],
