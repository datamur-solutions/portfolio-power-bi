			VAR _MatPot =
			    [Matrículas Potenciais Alô]
			
			RETURN
			IF(
			    _Gap >= 0,
			
			    "🟢 Alô " &
			    FORMAT(_Alo, "0.0%") &
			    " | +" &
			    FORMAT(_Gap * 100, "0.0") &
			    " p.p. vs operação",
			
			    "🔴 Alô " &
			    FORMAT(_Alo, "0.0%") &
			    " | -" &
			    FORMAT(ABS(_Gap) * 100, "0.0") &
			    " p.p. vs operação | potencial +" &
			    FORMAT(_MatPot, "#,0") &
			    " mat"
			)
		lineageTag: 1c9d20e9-6d61-4b5e-a672-1d79a3cc4af0

