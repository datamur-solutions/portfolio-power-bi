	measure 'Melhor Dia' =
			
			VAR _BaseDias =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED('Dim_Data'[Date]),
			            "@Util",
			                CALCULATE(MAX('Dim_Data'[É Dia Útil])),
			            "@Mailing",
			                CALCULATE([Mailing]),
			            "@Mat",
			                COALESCE(CALCULATE([MATRICULAS]), 0),
			            "@Pgto",
			                COALESCE(CALCULATE([Pagamentos]), 0)
			        ),
			        [@Util] = 1
			            && [@Mailing] >= 30
			            && [@Mat] > 0
			    )
			
			VAR _Top =
			    TOPN(
			        1,
			        _BaseDias,
			        [@Mat], DESC,
			        [@Pgto], DESC
			    )
			
			RETURN
			MAXX(
			    _Top,
			    'Dim_Data'[Date]
			)
		formatString: General Date
		lineageTag: e87a78cf-1571-416a-aa9e-f80329af0fab

	measure 'Dia Crítico' =
			
			VAR _Dias =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED('Dim_Data'[Date]),
			            "@Util",
			                CALCULATE(MAX('Dim_Data'[É Dia Útil])),
			            "@Mailing",
			                CALCULATE([Mailing]),
			            "@Mat",
			                COALESCE(CALCULATE([MATRICULAS]), 0)
			        ),
			        [@Util] = 1
			    )
			
			VAR _MedianaMailing =
			    MEDIANX(
			        _Dias,
			        [@Mailing]
			    )
			
			VAR _BaseComparavel =
			    FILTER(
			        _Dias,
			        [@Mailing] >= MAX(30, _MedianaMailing * 0.5)
			    )
			
			VAR _Pior =
			    TOPN(
			        1,
			        _BaseComparavel,
			        [@Mat], ASC,
			        'Dim_Data'[Date], DESC
			    )
			
			RETURN
			MAXX(
			    _Pior,
			    'Dim_Data'[Date]
			)
		formatString: General Date
		lineageTag: bd5675a7-e7a2-4d65-9a2d-c5f29c50c6eb

	measure 'Insight Tabulação' =
			
			VAR _Tab =
			    [Top Tabulação Sem Venda]
			
			VAR _Qtd =
			    [Volume Top Tabulação]
			
			VAR _TabUpper =
			    UPPER(_Tab)
			
			VAR _Acao =
			    SWITCH(
			        TRUE(),
			
			        CONTAINSSTRING(_TabUpper, "DEVEDOR"),
			            "acionar régua financeira",
			
			        CONTAINSSTRING(_TabUpper, "QUEBRA"),
			            "priorizar repique",
			
			        CONTAINSSTRING(_TabUpper, "PROMESSA"),
			            "reforçar follow-up",
			
			        CONTAINSSTRING(_TabUpper, "PROXIMO"),
			            "manter régua de nutrição",
			
			        CONTAINSSTRING(_TabUpper, "ENCERRADO"),
			            "revisar elegibilidade para retomada",
			
			        "avaliar reengajamento"
			    )
			
			RETURN
			"🟠 " &
			_Tab &
			": " &
			FORMAT(_Qtd, "#,0") &
			" | " &
			_Acao
		lineageTag: a75fb5ec-23e8-457c-9af4-dcf47203fb6d

	measure 'Insight Melhor Dia' =
			
			VAR _Data = [Melhor Dia]
			
			VAR _Mat =
			    COALESCE(
			        CALCULATE(
			            [MATRICULAS],
			            FILTER(
			                ALL('Dim_Data'[Date]),
			                'Dim_Data'[Date] = _Data
			            )
			        ),
			        0
			    )
			
			VAR _Pgto =
			    COALESCE(
			        CALCULATE(
			            [Pagamentos],
			            FILTER(
			                ALL('Dim_Data'[Date]),
			                'Dim_Data'[Date] = _Data
			            )
			        ),
			        0
			    )
			
			VAR _Conv =
			    COALESCE(
			        CALCULATE(
			            [CONV PAG],
			            FILTER(
			                ALL('Dim_Data'[Date]),
			                'Dim_Data'[Date] = _Data
			            )
			        ),
			        0
			    )
			
			RETURN
			IF(
			    ISBLANK(_Data),
			    "Sem dia elegível no período",
			    "🟢 " &
			    FORMAT(_Data, "dd/MM") &
			    ": " &
			    FORMAT(_Mat, "#,0") &
			    " mat | " &
			    FORMAT(_Pgto, "#,0") &
			    " pgto | " &
			    FORMAT(_Conv, "0.0%") &
			    " conv."
			)
		lineageTag: 0bd73132-e734-4cdc-b1fe-8a64b525604f

	measure 'Insight Dia Crítico' =
			
			VAR _Data =
			    [Dia Crítico]
			
			VAR _Mat =
			    CALCULATE(
			        [MATRICULAS],
			        TREATAS({_Data}, 'Dim_Data'[Date])
			    )
			
			VAR _AloDia =
			    CALCULATE(
			        [ATENDIDO],
			        TREATAS({_Data}, 'Dim_Data'[Date])
			    )
			
			VAR _EfetDia =
			    CALCULATE(
			        [EFETIVO],
			        TREATAS({_Data}, 'Dim_Data'[Date])
			    )
			
			VAR _TMADia =
			    CALCULATE(
			        [TMA Atual Seg],
			        TREATAS({_Data}, 'Dim_Data'[Date])
			    )
			
			VAR _Pace =
			    [Pace Matrícula]
			
			VAR _VarMat =
			    DIVIDE(
			        _Mat - _Pace,
			        _Pace,
			        0
			    )
			
			VAR _GapAlo =
			    _AloDia - [ATENDIDO]
			
			VAR _GapEfet =
			    _EfetDia - [EFETIVO]
			
			VAR _GapTMA =
			    DIVIDE(
			        _TMADia - [TMA Atual Formatado],
			        [TMA Atual Formatado],
			        0
			    )
			
			VAR _Causa =
			    SWITCH(
			        TRUE(),
			
			        _GapAlo <= _GapEfet
			            && ABS(_GapAlo) >= ABS(_GapTMA),
			            "Alô caiu " &
			            FORMAT(ABS(_GapAlo) * 100, "0.0") &
			            " p.p.",
			
			        _GapEfet < _GapAlo
			            && ABS(_GapEfet) >= ABS(_GapTMA),
			            "Efetividade caiu " &
			            FORMAT(ABS(_GapEfet) * 100, "0.0") &
			            " p.p.",
			
			        "TMA ficou " &
			        FORMAT(ABS(_GapTMA), "0%") &
			        " acima da média"
			    )
			
			RETURN
			"🔴 " &
			FORMAT(_Data, "dd/MM") &
			" foi o dia crítico: " &
			FORMAT(_Mat, "#,0") &
			" mat | " &
			FORMAT(_VarMat, "0%") &
			" vs pace. " &
			_Causa &
			" foi o principal ponto de pressão."
		lineageTag: dbc0dd5c-8e71-480b-a999-5dcb2e78a080

