	measure 'CONV VENDA' = CALCULATE(DIVIDE([VENDA],[EFETIVO]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b9a38da2-76e7-4f54-89b4-ccd368ecdfa6

	measure RETORNO = CALCULATE(DIVIDE([MATRICULAS],[MAILING]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ff9f1e35-27c3-4ed1-863e-7a2ffd5111da

	measure 'FUNIL | VALOR TOTAL' =
			
			SWITCH(
			    SELECTEDVALUE(Dim_Funil[Etapa]),
			
			    "MAILING", [MAILING],
			    "TRABALHADOS", [TRABALHADO],
			    "TENTATIVAS", [TENTATIVA],
			    "ATENDIDOS", [ATENDIDO],
			    "EFETIVOS", [EFETIVO],
			    "VENDAS", [VENDA],
			    "PAGAMENTOS", [PAGAMENTOS],
			    "MATRICULAS", [MATRICULAS],
			
			    "SPIN", [SPIN],
			    "% TRAB", [TRABALHADO/BASE],
			    "HITRATE", [HITRATE],
			    "% ATENDIDO/BASE", [ATENDIDO/BASE],
			    "% EFETIVO/BASE", [EFETIVO/BASE],
			    "% CONV VENDA", [CONV VENDA],
			    "% RET", [RETORNO],
			    "% PAG", [CONV PAG],
			    "% CONV MAT", [CONV MAT]
			)
		lineageTag: b478a6de-56dc-48cb-9dc2-d92cfdc8f054

		formatStringDefinition =
				SWITCH(
				    SELECTEDVALUE(Dim_Funil[Etapa]),
				
				    "MAILLING", "#,##0",
				    "TRABALHADOS", "#,##0",
				    "TENTATIVAS", "#,##0",
				    "ATENDIDOS", "#,##0",
				    "EFETIVOS", "#,##0",
				    "VENDAS", "#,##0",
				    "PAGAMENTOS", "#,##0",
				    "MATRICULAS", "#,##0",
				
				    "SPIN", "0.0",
				
				    "% TRAB", "0.0%",
				    "HITRATE", "0.0%",
				    "% ALO BASE", "0.0%",
				    "% ATENDIDO/BASE", "0.0%",
				    "% EFETIVO/ATENDIDO", "0.0%",
				    "% EFETIVO/ALO", "0.0%",
				    "% EFETIVO/BASE", "0.0%",
				    "% CONV", "0.0%",
				    "% CONV VENDA", "0.0%",
				    "% RET", "0.0%",
				    "% PAG", "0.0%",
				    "% CONV MAT", "0.0%",
				
				    "#,##0"
				)

	measure 'CONV PAG' = CALCULATE(DIVIDE([PAGAMENTOS],[VENDA]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cc06c1cc-ed1c-48ae-9bb8-8fb5b38d6625

	measure 'Conv Atendido Matrícula %' =
			
			DIVIDE(
			    [MATRICULAS],
			    [Atendido],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 303a3dc3-2aa1-4510-a530-7fbcde50bbfa

	measure 'Conv Atendido Pagamento %' =
			
			DIVIDE(
			    [Pagamentos],
			    [Atendido],
			    0
			)
		lineageTag: db9dad89-67a0-4760-a219-0b7ca476a553

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Conv Efetivo Matrícula %' =
			
			DIVIDE(
			    [MATRICULAS],
			    [Efetivo],
			    0
			)
		lineageTag: 0f52d33d-9518-4e01-a280-9b134a686273

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Curso Top Matrícula' =
			
			VAR _Cursos =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED('DIM_CURSO'[ds_curso_ic]),
			            "@Matriculas", [MATRICULAS]
			        ),
			        [@Matriculas] > 0
			    )
			
			VAR _Top =
			    TOPN(
			        1,
			        _Cursos,
			        [@Matriculas], DESC,
			        'DIM_CURSO'[ds_curso_ic], ASC
			    )
			
			RETURN
			    CONCATENATEX(
			        _Top,
			        'DIM_CURSO'[ds_curso_ic],
			        ", "
			    )
		lineageTag: cd54fe97-fc77-4cf3-99e1-a5d3f07788be

	measure Tabulados =
			
			SUM('OMNI CHAT'[fl_tabulado])
		formatString: #,0
		lineageTag: 4d22ae8d-0dbb-495a-afef-da1d70ba328a

	measure 'Quebra Interação' =
			
