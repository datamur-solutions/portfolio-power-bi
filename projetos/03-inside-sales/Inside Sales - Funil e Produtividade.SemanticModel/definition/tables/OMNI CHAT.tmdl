	measure 'Insight Gargalo Funil' =
			
			VAR _GapEfetividade =
			    [EFETIVO/BASE] -
			    [Efetividade Operação %]
			
			VAR _GapConversao =
			    [Conv Efetivo Matrícula %]-
			    [Conv Efetivo Mat Operação %]
			
			VAR _GapPagamento =
			    [Realização Pgto %] -
			    [Realização Pgto Operação %]
			
			VAR _PiorGap =
			    MIN(
			        _GapEfetividade,
			        MIN(
			            _GapConversao,
			            _GapPagamento
			        )
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    _PiorGap >= 0,
			        "🟢 Sem gargalo relevante | taxas ≥ operação",
			
			    _PiorGap = _GapEfetividade,
			        "🔴 Efetividade -" &
			        FORMAT(ABS(_GapEfetividade) * 100, "0.0") &
			        " p.p. | revisar abordagem",
			
			    _PiorGap = _GapConversao,
			        "🔴 Efetivo → mat -" &
			        FORMAT(ABS(_GapConversao) * 100, "0.0") &
			        " p.p. | reforçar fechamento",
			
			    "🔴 Conversão em pgto -" &
			    FORMAT(ABS(_GapPagamento) * 100, "0.0") &
			    " p.p. | priorizar follow-up"
			)
		lineageTag: 1a706ef2-9f1d-4f54-ba22-7b2a8e7e6cb2

