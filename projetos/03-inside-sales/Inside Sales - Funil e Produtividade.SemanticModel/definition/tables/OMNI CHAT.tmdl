	measure 'Curso Maior Estoque' =
			
			VAR _Tabela =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED('DIM_CURSO'[ds_curso_ic]),
			            "@NaoTrab", [Não Trabalhados]
			        ),
			        [@NaoTrab] > 0
			    )
			
			VAR _Top =
			    TOPN(
			        1,
			        _Tabela,
			        [@NaoTrab], DESC
			    )
			
			RETURN
			    CONCATENATEX(
			        _Top,
			        'DIM_CURSO'[ds_curso_ic],
			        ", "
			    )
		lineageTag: 7ab3adb5-deb9-4984-83c8-d19f907cc16a

	measure 'Maior Estoque Não Trabalhado' =
			
			VAR _Tabela =
			    ADDCOLUMNS(
			        ALLSELECTED('DIM_CURSO'[ds_curso_ic]),
			        "@NaoTrab", [Não Trabalhados]
			    )
			
			RETURN
			    MAXX(
			        _Tabela,
			        [@NaoTrab]
			    )
		formatString: 0
		lineageTag: f19e4327-8dc7-42e1-81e4-0b0a7b695f00

	measure 'Score Oportunidade Pgto' =
			
			[Não Trabalhados]
			    * [CONV PAG]
		lineageTag: a3d4e8a3-3d04-4912-856a-3fadad272fbb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Curso Maior Oportunidade' =
			
			VAR _Tabela =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED('DIM_CURSO'[ds_curso_ic]),
			            "@Estoque", [Não Trabalhados],
			            "@Score", [Score Oportunidade Pgto]
			        ),
			        [@Estoque] > 0
			    )
			
			VAR _Top =
			    TOPN(
			        1,
			        _Tabela,
			        [@Score], DESC,
			        [@Estoque], DESC
			    )
			
			RETURN
			    CONCATENATEX(
			        _Top,
			        'DIM_CURSO'[ds_curso_ic],
			        ", "
			    )
		lineageTag: bae7c24a-19bc-494b-b5ab-5ea0a87093a6

	measure 'Top Tabulação Sem Venda' =
			
			VAR _Tabela =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED('OMNI CHAT'[tabulacao]),
			            "@Volume", [Sem Venda OMNI]
			        ),
			        NOT(ISBLANK('OMNI CHAT'[tabulacao]))
			            && [@Volume] > 0
			    )
			
			VAR _Top =
			    TOPN(
			        1,
			        _Tabela,
			        [@Volume], DESC
			    )
			
			RETURN
			    CONCATENATEX(
			        _Top,
			        'OMNI CHAT'[tabulacao],
			        ", "
			    )
		lineageTag: bfcc6a42-6c3e-4781-864a-d709206fd596

	measure 'Volume Top Tabulação' =
			
			VAR _Tabela =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED('OMNI CHAT'[tabulacao]),
			            "@Volume", [Sem Venda OMNI]
			        ),
			        NOT(ISBLANK('OMNI CHAT'[tabulacao]))
			    )
			
			RETURN
