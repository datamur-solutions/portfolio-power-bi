		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Insight Onde Está Dinheiro' =
			
			VAR _Local =
			    [Curso Unidade Maior Oportunidade]
			
			VAR _Estoque =
			    [Estoque Maior Oportunidade]
			
			RETURN
			IF(
			    NOT ISBLANK(_Local),
			
			    "🟣 " &
			    _Local &
			    ": " &
			    FORMAT(_Estoque, "#,0") &
			    " contatos | priorizar atuação",
			
			    "🟢 Sem estoque relevante no recorte"
			)
		lineageTag: 5f68725b-ddd5-4493-b62b-26e8b7cbfb73

	measure '% Tabulação' =
			
			VAR _Atual =
			    [Tabulados]
			
			VAR _Total =
			    CALCULATE(
			        [Tabulados],
			        REMOVEFILTERS('OMNI CHAT'[grupo_tabulacao])
			    )
			
			RETURN
			    DIVIDE(
			        _Atual,
			        _Total,
			        0
			    )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: efb007d0-2d24-4fa2-a42b-c409ea0e944b

	measure 'Efetivos Não Convertidos' =
			
			MAX(
			    0,
			    [EFETIVO] - [MATRICULAS]
			)
		formatString: 0
		lineageTag: 2b3d503b-5b8b-4f29-984e-e8135054a41a

	measure 'Potencial Mat Efetivos' =
			
			ROUND(
			    [Efetivos Não Convertidos]
			        * [Conv Efetivo Matrícula %],
			    0
			)
		lineageTag: 9378ddbf-ad1d-4bde-b4b4-b72d271e7fd8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Insight Efetivos' =
			
			VAR _Estoque =
			    [Efetivos Não Convertidos]
			
			VAR _Potencial =
			    [Potencial Mat Efetivos]
			
			RETURN
			"🟣 " &
			FORMAT(_Estoque, "#,0") &
			" efetivos sem mat | potencial estimado +" &
			FORMAT(_Potencial, "#,0") &
			" mat | foco em follow-up"
		lineageTag: 9e73cd58-2b76-44c9-936c-b9155a411231

	measure 'Insight Funil Operador' =
			
			VAR _Nome =
			    SELECTEDVALUE(
			        'DIM_CONSULTOR'[nm_consultor_recebimento],
			        "Operação"
			    )
			
			RETURN
			_Nome &
			": " &
			FORMAT([Mailing], "#,0") &
			" mailing | " &
			FORMAT([ATENDIDO], "0.0%") &
			" alô | " &
