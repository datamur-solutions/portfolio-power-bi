	measure 'Pace Mat Últimos 5 DU' =
			
			VAR _DataRef =
			    MAX('Dim_Data'[Date])
			
			VAR _Datas =
			    TOPN(
			        5,
			        FILTER(
			            ALLSELECTED('Dim_Data'),
			            'Dim_Data'[É Dia Útil] = 1
			                && 'Dim_Data'[Date] <= _DataRef
			        ),
			        'Dim_Data'[Date], DESC
			    )
			
			RETURN
			DIVIDE(
			    CALCULATE(
			        [MATRICULAS],
			        KEEPFILTERS(_Datas)
			    ),
			    COUNTROWS(_Datas),
			    0
			)
		lineageTag: 20005925-5896-4a9a-8c38-b324dd8c2654

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pace Mat 5 DU Anteriores' =
			
			VAR _DataRef =
			    MAX('Dim_Data'[Date])
			
			VAR _Ultimos5 =
			    TOPN(
			        5,
			        FILTER(
			            ALLSELECTED('Dim_Data'),
			            'Dim_Data'[É Dia Útil] = 1
			                && 'Dim_Data'[Date] <= _DataRef
			        ),
			        'Dim_Data'[Date], DESC
			    )
			
			VAR _PrimeiraData =
			    MINX(
			        _Ultimos5,
			        'Dim_Data'[Date]
			    )
			
			VAR _Anteriores5 =
			    TOPN(
			        5,
			        FILTER(
			            ALLSELECTED('Dim_Data'),
			            'Dim_Data'[É Dia Útil] = 1
			                && 'Dim_Data'[Date] < _PrimeiraData
			        ),
			        'Dim_Data'[Date], DESC
			    )
			
			RETURN
			DIVIDE(
			    CALCULATE(
			        [MATRICULAS],
			        KEEPFILTERS(_Anteriores5)
			    ),
			    COUNTROWS(_Anteriores5),
			    0
			)
		lineageTag: c5e4f2e1-60dd-480a-835e-573c45829475

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variação Pace 5DU %' =
			
			DIVIDE(
			    [Pace Mat Últimos 5 DU] -
			    [Pace Mat 5 DU Anteriores],
			    [Pace Mat 5 DU Anteriores],
			    0
			)
		lineageTag: 38e35cb2-0cc5-4804-a87d-1ffe1f59d965

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Insight Momento' =
			
			VAR _Pace =
			    [Pace Mat Últimos 5 DU]
			
			VAR _Variacao =
			    [Variação Pace 5DU %]
			
			VAR _Alo =
			    [ATENDIDO]
			
			VAR _TMA =
			    [TMA Atual Formatado]
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    _Variacao >= 0.05,
			        "🟢 Pace em aceleração: " &
			        FORMAT(_Pace, "0.0") &
			        " mat/DU | +" &
			        FORMAT(_Variacao, "0%") &
			        " vs 5 DU anteriores.",
			
			    _Variacao <= -0.05,
			        "🔴 Pace em desaceleração: " &
			        FORMAT(_Pace, "0.0") &
			        " mat/DU | " &
			        FORMAT(_Variacao, "0%") &
			        " vs 5 DU anteriores.",
			
			    "🟠 Pace estável em " &
			    FORMAT(_Pace, "0.0") &
			    " mat/DU | sem variação relevante."
			)
		lineageTag: 3243ca22-675d-4d3f-9c18-04cf5672859b

	measure 'Benchmark Alô %' =
			
			VAR _Base =
			    FILTER(
			        ADDCOLUMNS(
			            ALL('DIM_CONSULTOR'[nm_consultor_recebimento]),
			            "@Mailing", CALCULATE([Mailing]),
			            "@Alo", CALCULATE([ATENDIDO])
			        ),
			        [@Mailing] >= 30
			            && NOT ISBLANK([@Alo])
			    )
			
			RETURN
			PERCENTILEX.INC(
			    _Base,
			    [@Alo],
			    0.75
			)
		lineageTag: b6fe4c00-6aa3-4d1f-981f-82f51343a28e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Benchmark Efetividade %' =
			
			VAR _Base =
			    FILTER(
			        ADDCOLUMNS(
			            ALL('DIM_CONSULTOR'[nm_consultor_recebimento]),
			            "@Atendidos", CALCULATE([ATENDIDO]),
			            "@Efetividade", CALCULATE([EFETIVO])
			        ),
			        [@Atendidos] >= 30
			            && NOT ISBLANK([@Efetividade])
			    )
			
			RETURN
			PERCENTILEX.INC(
			    _Base,
			    [@Efetividade],
			    0.75
			)
		lineageTag: d5c34817-36ab-4ded-b47b-86ea2b762c3d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Benchmark Conv Efetivo Mat %' =
			
			VAR _Base =
			    FILTER(
			        ADDCOLUMNS(
			            ALL('DIM_CONSULTOR'[nm_consultor_recebimento]),
			            "@Efetivos", CALCULATE([EFETIVO]),
			            "@Conv", CALCULATE([Conv Efetivo Matrícula %])
			        ),
			        [@Efetivos] >= 30
			            && NOT ISBLANK([@Conv])
			    )
			
			RETURN
			PERCENTILEX.INC(
			    _Base,
			    [@Conv],
			    0.75
			)
		lineageTag: 815d678c-7d19-4a61-9ff3-4e0f18cfe1d3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Potencial Mat Alô' =
			
			VAR _AtendidosMeta =
			    [Mailing] * [Benchmark Alô %]
			
			VAR _AtendidosExtras =
			    MAX(
			        0,
			        _AtendidosMeta - [ATENDIDO]
			    )
			
			RETURN
			ROUND(
			    _AtendidosExtras
			        * [EFETIVO]
			        * [Conv Efetivo Matrícula %],
			    0
			)
		lineageTag: b92d59b9-25ae-4dfb-a7a1-45eae50263b3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Potencial Mat Efetividade' =
			
			VAR _EfetivosMeta =
			    [ATENDIDO] * [Benchmark Efetividade %]
			
			VAR _EfetivosExtras =
			    MAX(
			        0,
			        _EfetivosMeta - [EFETIVO]
			    )
			
			RETURN
			ROUND(
			    _EfetivosExtras
			        * [Conv Efetivo Matrícula %],
			    0
			)
		lineageTag: 1ba7f763-02f3-4073-a920-afbe10023097

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Potencial Mat Conversão' =
			
			VAR _MatMeta =
			    [EFETIVO]
			        * [Benchmark Conv Efetivo Mat %]
			
			RETURN
			MAX(
			    0,
			    ROUND(
			        _MatMeta - [MATRICULAS],
			        0
			    )
			)
		lineageTag: ffdff069-293c-4e3f-9f54-148f3a967709

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Potencial Mat Base' =
			
			ROUND(
			    [Não Trabalhados]
			        * [CONV MAT],
			    0
			)
		lineageTag: c74fd522-26b6-4dec-a70c-2d2cf104a89e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Principal Alavanca' =
			
			VAR _Alo =
			    COALESCE([Potencial Mat Alô], 0)
			
			VAR _Efetividade =
			    COALESCE([Potencial Mat Efetividade], 0)
			
			VAR _Conversao =
			    COALESCE([Potencial Mat Conversão], 0)
			
			VAR _TMA =
			    COALESCE([Matrículas Potenciais TMA], 0)
			
			VAR _Base =
			    COALESCE([Potencial Mat Base], 0)
			
			VAR _Maior =
			    MAX(
			        _Alo,
			        MAX(
			            _Efetividade,
			            MAX(
			                _Conversao,
			                MAX(
			                    _TMA,
			                    _Base
			                )
			            )
			        )
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			    _Maior = _Efetividade && _Maior > 0, "EFETIVIDADE",
			    _Maior = _Alo && _Maior > 0, "ALÔ",
			    _Maior = _Conversao && _Maior > 0, "CONVERSÃO",
			    _Maior = _TMA && _Maior > 0, "TMA",
			    _Maior = _Base && _Maior > 0, "BASE",
			    "MANUTENÇÃO"
			)
		lineageTag: c51a158b-3c34-42ba-8287-ca69a65a2a70

	measure 'Potencial Principal' =
			
			SWITCH(
			    [Principal Alavanca],
			
			    "ALÔ",
			        [Potencial Mat Alô],
			
			    "EFETIVIDADE",
			        [Potencial Mat Efetividade],
			
			    "CONVERSÃO",
			        [Potencial Mat Conversão],
			
			    "TMA",
			        [Matrículas Potenciais TMA],
			
			    "BASE",
			        [Potencial Mat Base],
			
			    0
			)
		lineageTag: 9632fdec-4599-438b-b66c-99719a17be98

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Insight Principal Oportunidade' =
			
			VAR _Alavanca =
			    [Principal Alavanca]
			
			VAR _Potencial =
			    [Potencial Principal]
			
			RETURN
			SWITCH(
			    _Alavanca,
			
			    "ALÔ",
			        "🟣 Alô é a maior oportunidade | potencial +" &
			        FORMAT(_Potencial, "#,0") &
			        " mat ao atingir o benchmark",
			
			    "EFETIVIDADE",
			        "🟣 Efetividade é a maior oportunidade | potencial +" &
			        FORMAT(_Potencial, "#,0") &
			        " mat",
			
			    "CONVERSÃO",
			        "🟣 Efetivo → matrícula concentra o maior gap | potencial +" &
			        FORMAT(_Potencial, "#,0") &
			        " mat",
			
			    "TMA",
			        "🟣 TMA é a maior alavanca de capacidade | potencial +" &
			        FORMAT(_Potencial, "#,0") &
			        " mat",
			
			    "BASE",
			        "🟣 Base não trabalhada é a maior oportunidade | potencial +" &
			        FORMAT(_Potencial, "#,0") &
			        " mat",
			
			    "🟢 Operação sem gap material | oportunidade está em sustentar e escalar o pace"
			)
		lineageTag: 338a0035-c0fd-4c43-b51d-6cbe216495bc

	measure 'Insight Plano Recuperação' =
			
			VAR _Alavanca =
			    [Principal Alavanca]
			
			RETURN
			SWITCH(
			    _Alavanca,
			
			    "ALÔ",
			        "🔵 Ação: acelerar 1ª resposta, priorizar D0/D1 e reforçar novas tentativas",
			
			    "EFETIVIDADE",
			        "🔵 Ação: revisar abordagem e objeções | replicar prática dos melhores consultores",
			
			    "CONVERSÃO",
			        "🔵 Ação: priorizar efetivos sem matrícula e reforçar fechamento comercial",
			
			    "TMA",
			        "🔵 Ação: reduzir TMA e tempo improdutivo para ampliar capacidade de atendimento",
			
			    "BASE",
			        "🔵 Ação: redistribuir estoque e priorizar contatos não trabalhados com maior aderência",
			
			    "🔵 Ação: preservar os indicadores atuais e concentrar volume nas melhores janelas"
			)
		lineageTag: f5d5bbbc-6b04-4ae2-bcc1-27b6ed8117d9

	measure 'Insight Fechamento' =
			
			VAR _Mat =
			    [MATRICULAS]
			
			VAR _Pgto =
			    [Pagamentos]
			
			VAR _Gap =
			    _Mat - _Pgto
			
			VAR _Realizacao =
			    DIVIDE(
			        _Pgto,
			        _Mat,
			        0
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    _Mat = 0 && _Pgto = 0,
			        "Sem fechamento no período",
			
			    _Pgto > _Mat,
			        "🟠 Pgto supera mat em " &
			        FORMAT(ABS(_Gap), "#,0") &
			        " | validar Cohort de pagamento",
			
			    _Realizacao >= 0.80,
			        "🟢 Fechamento " &
			        FORMAT(_Realizacao, "0.0%") &
			        " | " &
			        FORMAT(_Gap, "#,0") &
			        " mat pendentes",
			
			    _Realizacao >= 0.65,
			        "🟠 Fechamento " &
			        FORMAT(_Realizacao, "0.0%") &
			        " | " &
			        FORMAT(_Gap, "#,0") &
			        " pendentes | reforçar follow-up",
			
			    "🔴 Fechamento " &
			    FORMAT(_Realizacao, "0.0%") &
			    " | " &
			    FORMAT(_Gap, "#,0") &
			    " mat pendentes | atuação prioritária"
			)
		lineageTag: 9d5aba11-f5ae-4e32-a471-3ed8abbcef0a

	measure '% ATENDIDO COHORT' =
			
			DIVIDE(
			    [ATENDIDO],
			    CALCULATE(
			        [MAILING],
			        REMOVEFILTERS('DIM_COHORT ATEND')
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e8f9461a-c656-4d85-93d2-d370aeb3a870

