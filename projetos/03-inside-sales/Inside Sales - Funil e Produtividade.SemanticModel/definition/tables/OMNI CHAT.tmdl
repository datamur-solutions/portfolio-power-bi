table 'OMNI CHAT'
	lineageTag: 0d09c34c-273a-4d33-a075-df24c8a85a63

	measure VENDA = CALCULATE(SUM('OMNI CHAT'[fl_venda]))
		formatString: 0
		lineageTag: f11c5340-6276-4185-a414-881e4dbf3692

	measure 'CONV MAT' = CALCULATE(DIVIDE([MATRICULAS],[VENDA]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cde79897-99ab-453e-b5c7-bee5bcb0a8ff

	measure MAILING =
			
			CALCULATE(
