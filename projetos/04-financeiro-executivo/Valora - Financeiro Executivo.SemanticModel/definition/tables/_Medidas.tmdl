	measure 'Taxa de Liquidação %' =
			
			DIVIDE (
			    [Recebíveis Liquidados],
			    [Títulos a Receber]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3db26766-51a8-439c-ad5d-c5e73cf0b82b

	measure DSO =
			
			VAR Recebidos =
			    FILTER (
			        FATO_RECEBIVEIS,
			        FATO_RECEBIVEIS[Status] = "Pago"
			            && NOT ISBLANK (
			                FATO_RECEBIVEIS[DataRecebimento]
			            )
			    )
			
			VAR DiasPonderados =
			    SUMX (
			        Recebidos,
			        DATEDIFF (
			            FATO_RECEBIVEIS[DataEmissao],
			            FATO_RECEBIVEIS[DataRecebimento],
			            DAY
			        )
			            * FATO_RECEBIVEIS[ValorRecebido]
			    )
			
			VAR ValorBase =
			    SUMX (
			        Recebidos,
			        FATO_RECEBIVEIS[ValorRecebido]
			    )
			
			RETURN
			DIVIDE (
			    DiasPonderados,
			    ValorBase
			)
		formatString: 0" dias"
		lineageTag: ad71babb-2fb2-49f8-b3e3-aaff14ae3194


	measure 'Atraso Médio Recebimento' =
			
			AVERAGEX (
			    FILTER (
			        FATO_RECEBIVEIS,
			        FATO_RECEBIVEIS[Status] = "Pago"
			            && FATO_RECEBIVEIS[DiasAtraso] > 0
			    ),
			    FATO_RECEBIVEIS[DiasAtraso]
			)
		formatString: 0" dias"
		lineageTag: 1570e589-f4e9-4e9e-b3f5-5c2fb375a44b


