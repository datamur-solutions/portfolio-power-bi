	measure 'Headcount Atual' =
			
			VAR UltimaCompetencia =
			    MAX ( FATO_FOLHA[Competencia] )
			
			RETURN
			CALCULATE (
			    DISTINCTCOUNT (
			        FATO_FOLHA[ColaboradorID]
