			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 92e4fcf2-34d4-4522-b63c-4e6b995d5611

	measure 'Texto Alerta' =
			
			VAR Tipo =
			    SELECTEDVALUE ( DIM_ALERTAS[TipoAlerta] )
			
			RETURN
			SWITCH (
			    Tipo,
			
			    "Receita",
			        SWITCH (
			            TRUE(),
			            [Variação Receita vs Orçado %] < 0,
			                "🔴 Receita abaixo do orçado: "
			                    & FORMAT ( [Variação Receita vs Orçado %], "0,0%" ),
			
			            [Variação Receita vs Orçado %] >= 0,
			                "🟢 Receita acima do orçado: "
			                    & FORMAT ( [Variação Receita vs Orçado %], "0,0%" )
			        ),
			
			    "EBITDA",
			        SWITCH (
			            TRUE(),
			            [Gap Forecast EBITDA vs Orçado %] < 0,
			                "🔴 Forecast EBITDA abaixo do orçamento: "
			                    & FORMAT ( [Gap Forecast EBITDA vs Orçado %], "0,0%" ),
			
			            [Gap Forecast EBITDA vs Orçado %] >= 0,
			                "🟢 Forecast EBITDA em linha/acima: "
			                    & FORMAT ( [Gap Forecast EBITDA vs Orçado %], "0,0%" )
			        ),
			
			    "Margem",
			        SWITCH (
			            TRUE(),
			            [Variação Margem EBITDA p.p.] < 0,
			                "🔴 Margem EBITDA caiu "
			                    & FORMAT (
			                        ABS ( [Variação Margem EBITDA p.p.] ),
