	measure 'Fluxo de Financiamento' =
			
			CALCULATE (
			    SUM ( FATO_CAIXA_MOV[ValorLiquido] ),
			    FATO_CAIXA_MOV[GrupoFluxo] = "Financiamento"
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: ee7401e4-ec37-4f46-83f2-f52593315d9b

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Burn Rate Mensal' =
			
			VAR TabelaMeses =
			    ADDCOLUMNS (
			        VALUES ( DIM_DATA[AnoMes] ),
			        "@Movimento",
			            CALCULATE ( [Geração de Caixa] )
			    )
			
			RETURN
			ABS (
			    AVERAGEX (
			        FILTER (
			            TabelaMeses,
			            [@Movimento] < 0
			        ),
			        [@Movimento]
			    )
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 7d0b5150-1c6b-4e7e-a552-e6bd4844d25c

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Runway Meses' =
			
			DIVIDE (
			    [Saldo de Caixa],
			    [Burn Rate Mensal]
			)
		formatString: 0.0" meses"
		lineageTag: 42cb2a99-9c4e-4604-a856-0804d958e379

