	measure 'Prazo Médio de Recebimento' =
			
			VAR BaseRecebimentos =
			    CALCULATETABLE(
			        FATO_RECEBIVEIS,
			        TREATAS(
			            VALUES(DIM_DATA[Data]),
			            FATO_RECEBIVEIS[DataRecebimento]
			        )
			    )
			
			RETURN
			AVERAGEX(
			    FILTER(
			        BaseRecebimentos,
			        NOT ISBLANK(FATO_RECEBIVEIS[DataEmissao])
			            &&
			        NOT ISBLANK(FATO_RECEBIVEIS[DataRecebimento])
			    ),
			    DATEDIFF(
			        FATO_RECEBIVEIS[DataEmissao],
			        FATO_RECEBIVEIS[DataRecebimento],
			        DAY
			    )
			)
		formatString: 0
