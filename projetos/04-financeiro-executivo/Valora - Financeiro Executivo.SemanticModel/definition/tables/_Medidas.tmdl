	measure 'Cor Mapa de Risco' =
			
			VAR Saldo = [Saldo em Aberto]
			VAR Inadimplencia = [Inadimplência %]
			VAR CorteSaldo = [Média Saldo Carteira]
			VAR CorteInadimplencia = [Média Inadimplência Carteira]
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    Saldo >= CorteSaldo
			        && Inadimplencia >= CorteInadimplencia,
			        "#E74C5B",
			
			    Saldo < CorteSaldo
			        && Inadimplencia >= CorteInadimplencia,
			        "#F2C94C",
			
			    "#58C77A"
			)
		lineageTag: ad4cd35a-399c-4102-ab0d-891f9ff775d9

	measure 'Recebido no Prazo' =
			
			CALCULATE(
			    SUM(FATO_RECEBIVEIS[ValorRecebido]),
			    TREATAS(
			        VALUES(DIM_DATA[Data]),
			        FATO_RECEBIVEIS[DataRecebimento]
			    ),
			    FILTER(
			        FATO_RECEBIVEIS,
			        NOT ISBLANK(FATO_RECEBIVEIS[DataRecebimento])
			            &&
			        FATO_RECEBIVEIS[DataRecebimento]
			            <= FATO_RECEBIVEIS[DataVencimento]
			    )
			)
		formatString: 0
		lineageTag: fa6b7564-22d1-407e-9927-d21b75c2f51a

	measure 'Recebido com Atraso' =
			
			CALCULATE(
			    SUM(FATO_RECEBIVEIS[ValorRecebido]),
			    TREATAS(
			        VALUES(DIM_DATA[Data]),
			        FATO_RECEBIVEIS[DataRecebimento]
			    ),
			    FILTER(
			        FATO_RECEBIVEIS,
			        NOT ISBLANK(FATO_RECEBIVEIS[DataRecebimento])
			            &&
			        FATO_RECEBIVEIS[DataRecebimento]
			            > FATO_RECEBIVEIS[DataVencimento]
			    )
			)
		formatString: 0
		lineageTag: 73469722-d7a6-405b-888f-1e5191da7089

	measure '% Recebido no Prazo' =
			
			DIVIDE(
			    [Recebido no Prazo],
			    [Recebido no Prazo] + [Recebido com Atraso],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 09826cb4-880c-4a9c-8824-b7765af0265a

	measure '% Recebido com Atraso' =
			
			DIVIDE(
			    [Recebido com Atraso],
			    [Recebido no Prazo] + [Recebido com Atraso],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b8b2b2d5-df22-4528-b974-ab513a8dae2b

	measure 'Data Corte Realizado' =
			CALCULATE ( MAX ( FATO_DRE[Competencia] ), ALL ( FATO_DRE ) )
		formatString: dd/mm/yyyy
		displayFolder: Layout
		lineageTag: 4f21de07-9cd3-637b-3218-beb8cae953cb

	measure 'Receita Líquida Orçada Comparável' =
			VAR c = [Data Corte Realizado]
			RETURN CALCULATE ( [Receita Líquida Orçada], KEEPFILTERS ( DIM_DATA[Data] <= c ) )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Layout
		lineageTag: 1d5de6fe-a519-6f4e-14b9-49c200227124

	measure 'EBITDA Orçado Comparável' =
			VAR c = [Data Corte Realizado]
			RETURN CALCULATE ( [EBITDA Orçado], KEEPFILTERS ( DIM_DATA[Data] <= c ) )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Layout
		lineageTag: 02d4c067-0391-a2f7-fd06-f7549f2963a9

	measure 'DRE Orçado Comparável' =
			VAR c = [Data Corte Realizado]
			RETURN CALCULATE ( [Valor Orçado], KEEPFILTERS ( DIM_DATA[Data] <= c ) )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Layout
		lineageTag: 21338a3d-0907-2c6d-8fb6-0fd8b26bb866

	measure 'DRE Var vs Orçado R$' =
			[Valor DRE Realizado] - [DRE Orçado Comparável]
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Layout
		lineageTag: 910724d5-b82a-2c5f-24c6-bac296c7b79e

	measure 'DRE Var vs Orçado %' =
			DIVIDE ( [DRE Var vs Orçado R$], ABS ( [DRE Orçado Comparável] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Layout
		lineageTag: e4527676-cd0b-bdf7-d762-70f4b75ab331

	measure 'DRE % da Receita Líquida' =
			DIVIDE ( [Valor DRE Realizado], CALCULATE ( [Receita Líquida], REMOVEFILTERS ( DIM_CONTA_CONTABIL ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Layout
		lineageTag: f2736df4-2c6e-12e7-6e42-0be92a0c3681

	measure 'Atingimento Receita Comparável %' =
			DIVIDE ( [Receita Líquida], [Receita Líquida Orçada Comparável] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Layout
		lineageTag: b2a81bca-b3b0-6b6e-805e-161664806bc3

	measure 'Gap Receita Comparável R$' =
			[Receita Líquida] - [Receita Líquida Orçada Comparável]
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Layout
		lineageTag: ce1b4a47-f145-8c00-1834-bd1bba80d9f4

	measure 'Var Receita Comparável %' =
			DIVIDE ( [Gap Receita Comparável R$], [Receita Líquida Orçada Comparável] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Layout
		lineageTag: 7e38dac7-de3e-4864-68f2-16737d6abfd5

	measure 'Atingimento EBITDA Comparável %' =
			DIVIDE ( [EBITDA], [EBITDA Orçado Comparável] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Layout
		lineageTag: 6d4ab36a-924f-3d28-1288-847e534e1b3b

	measure 'Gap EBITDA Comparável R$' =
			[EBITDA] - [EBITDA Orçado Comparável]
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Layout
		lineageTag: 682f2ee7-37c6-0fe8-1374-d9de8c46d42f

	measure 'Var EBITDA Comparável %' =
			DIVIDE ( [Gap EBITDA Comparável R$], ABS ( [EBITDA Orçado Comparável] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Layout
		lineageTag: 18328aef-4796-d1e2-3d1e-817cb58ae43a

	measure 'Margem EBITDA Orçada Comparável %' =
			DIVIDE ( [EBITDA Orçado Comparável], [Receita Líquida Orçada Comparável] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Layout
		lineageTag: 4c4bcf36-7b6d-0825-4040-96fefa20fd74

	measure 'Receita Líquida AA Comparável' =
			VAR c = [Data Corte Realizado]
			RETURN CALCULATE ( [Receita Líquida AA], KEEPFILTERS ( DIM_DATA[Data] <= c ) )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Layout
		lineageTag: 36e52bf2-1667-2975-05b8-ba26ab115b59

	measure 'YoY Receita Comparável %' =
			DIVIDE ( [Receita Líquida] - [Receita Líquida AA Comparável], [Receita Líquida AA Comparável] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Layout
		lineageTag: 515aa56e-f162-57c5-1c4b-3f54ff088baa

	measure 'Margem Líquida %' =
			DIVIDE ( [Resultado Líquido], [Receita Líquida] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Layout
		lineageTag: 52b70cac-f6ea-bbb1-a570-e5bc1b63603a

	measure 'Média Mensal Entradas' =
			AVERAGEX ( VALUES ( DIM_DATA[AnoMes] ), [Entradas de Caixa] )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Layout
		lineageTag: baec07f6-9f68-3cc1-5397-6f5c3333f0d3

	measure 'Média Mensal Saídas' =
			AVERAGEX ( VALUES ( DIM_DATA[AnoMes] ), [Saídas de Caixa] )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Layout
		lineageTag: 9e0a54b0-8754-3846-ef5d-5b60203c76dc

	measure 'Contratos de Dívida Ativos' =
			CALCULATE ( DISTINCTCOUNT ( FATO_DIVIDA[EmprestimoID] ), REMOVEFILTERS ( DIM_DATA ), FATO_DIVIDA[Status] = "Em aberto" )
		formatString: 0
		displayFolder: Layout
		lineageTag: 453cacc4-3f15-bba7-50d0-f14ae43e7703

	measure 'KPI · Receita Sub' =
			VAR v = [Var Receita Comparável %]
			VAR y = [YoY Receita Comparável %]
			RETURN
			IF ( ISBLANK ( v ), BLANK (),
			    IF ( v >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( v ), "0.0%" ) & " vs orçado"
			    & IF ( ISBLANK ( y ), "", "   ·   " & IF ( y >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( y ), "0.0%" ) & " vs ano ant." ) )
		displayFolder: Layout
		lineageTag: 8067f5ca-1028-937c-03d3-1684a971df7f

	measure 'KPI · Receita Cor' =
			IF ( [Var Receita Comparável %] >= 0, "#0F6B4E", "#B4531F" )
		displayFolder: Layout
		lineageTag: cf3782d7-c3c8-9131-5e31-8af36d55929a

	measure 'KPI · EBITDA Sub' =
			VAR v = [Var EBITDA Comparável %]
			RETURN IF ( ISBLANK ( v ), BLANK (), IF ( v >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( v ), "0.0%" ) & " vs orçado" )
		displayFolder: Layout
		lineageTag: 5bbc83d8-083a-91b2-d140-fb49861cc6ca

	measure 'KPI · EBITDA Cor' =
			IF ( [Var EBITDA Comparável %] >= 0, "#0F6B4E", "#B4531F" )
		displayFolder: Layout
		lineageTag: 705ccf71-ed64-d895-11d6-5eee866d519d

	measure 'KPI · Margem EBITDA Sub' =
			VAR o = [Margem EBITDA Orçada Comparável %]
			VAR d = ( [Margem EBITDA %] - o ) * 100
			RETURN IF ( ISBLANK ( o ), BLANK (), "Orçado " & FORMAT ( o, "0.0%" ) & "   ·   " & IF ( d >= 0, "+", "" ) & FORMAT ( d, "0.0" ) & " p.p." )
		displayFolder: Layout
		lineageTag: b8d4aaad-9e16-fac5-ac73-828955b065ac

	measure 'KPI · Margem EBITDA Cor' =
			IF ( [Margem EBITDA %] >= [Margem EBITDA Orçada Comparável %], "#0F6B4E", "#B4531F" )
		displayFolder: Layout
		lineageTag: 1e287fe7-cb99-4a59-4340-1f5d22c35a8b

	measure 'KPI · Margem Bruta Sub' =
			"Lucro bruto " & "R$ " & FORMAT ( [Lucro Bruto] / 1000000, "#,0.0" ) & " mi"
