	measure '% Recebimento' =
			
			VAR Recebido =
			    CALCULATE(
			        SUM(FATO_RECEBIVEIS[ValorRecebido]),
			        TREATAS(
			            VALUES(DIM_DATA[Data]),
			            FATO_RECEBIVEIS[DataRecebimento]
			        )
			    )
			
			VAR Vencimentos =
			    CALCULATE(
			        SUM(FATO_RECEBIVEIS[ValorTitulo]),
			        TREATAS(
			            VALUES(DIM_DATA[Data]),
			            FATO_RECEBIVEIS[DataVencimento]
			        )
			    )
			
			RETURN
			DIVIDE(
			    Recebido,
			    Vencimentos,
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e942eb7c-4e1a-4b21-98c8-315340a1b815

