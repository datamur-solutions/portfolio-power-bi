		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 62e8617d-331d-414f-ae4e-d5e0f23ab74a

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Saldo Devedor' =
			
			VAR DataReferencia =
			    MIN ( MAX ( DIM_DATA[Data] ), [Última Data Realizada] )
			
			RETURN
			SUMX (
			    VALUES (
			        DIM_EMPRESTIMO[EmprestimoID]
			    ),
			
			    VAR EmprestimoAtual =
			        DIM_EMPRESTIMO[EmprestimoID]
			
			    VAR UltimaParcela =
			        TOPN (
			            1,
			            FILTER (
			                ALL ( FATO_DIVIDA ),
			                FATO_DIVIDA[EmprestimoID]
			                    = EmprestimoAtual
			                    && FATO_DIVIDA[DataVencimento]
			                        <= DataReferencia
			            ),
			            FATO_DIVIDA[DataVencimento],
			            DESC
			        )
			
			    RETURN
			        MAXX (
			            UltimaParcela,
			            FATO_DIVIDA[SaldoDevedor]
			        )
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: b809ddc4-99f8-479c-9015-c45d2bff84f9

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'EBITDA 12M' =
			
			VAR DataReferencia =
			    MIN ( MAX ( DIM_DATA[Data] ), [Última Data Realizada] )
			
			RETURN
			CALCULATE (
			    [EBITDA],
			    DATESINPERIOD (
			        DIM_DATA[Data],
			        DataReferencia,
			        -12,
			        MONTH
			    )
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 35304413-7a53-43d9-ab3c-7aff78fdd23a

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Dívida sobre EBITDA' =
			
