	measure DPO =
			
			VAR Pagos =
			    FILTER (
			        FATO_PAGAVEIS,
			        FATO_PAGAVEIS[Status] = "Pago"
			            && NOT ISBLANK (
			                FATO_PAGAVEIS[DataPagamento]
			            )
			    )
			
			VAR DiasPonderados =
			    SUMX (
			        Pagos,
			        DATEDIFF (
			            FATO_PAGAVEIS[DataEmissao],
			            FATO_PAGAVEIS[DataPagamento],
			            DAY
			        )
			            * FATO_PAGAVEIS[ValorPago]
			    )
			
			VAR ValorBase =
			    SUMX (
			        Pagos,
			        FATO_PAGAVEIS[ValorPago]
			    )
			
			RETURN
			DIVIDE (
			    DiasPonderados,
			    ValorBase
			)
		formatString: 0" dias"
		lineageTag: 4ec4b259-5ddc-4bee-8f8a-bb160d868353


