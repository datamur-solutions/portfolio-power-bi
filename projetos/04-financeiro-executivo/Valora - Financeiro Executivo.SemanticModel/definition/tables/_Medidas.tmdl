			                    )
			                    & " p.p.",
			
			            [Variação Margem EBITDA p.p.] >= 0,
			                "🟢 Margem EBITDA subiu "
			                    & FORMAT (
			                        [Variação Margem EBITDA p.p.],
			                        "0,0"
			                    )
			                    & " p.p."
			        ),
			
			    "Inadimplência",
			        SWITCH (
			            TRUE(),
			
			            [Inadimplência %] >= 0.10,
			                "🔴 Inadimplência crítica: "
			                    & FORMAT ( [Inadimplência %], "0,0%" ),
			
			            [Inadimplência %] >= 0.05,
			                "🟠 Inadimplência em atenção: "
			                    & FORMAT ( [Inadimplência %], "0,0%" ),
			
			            "🟢 Inadimplência controlada: "
			                & FORMAT ( [Inadimplência %], "0,0%" )
			        ),
			
			    "Capital de Giro",
			        SWITCH (
