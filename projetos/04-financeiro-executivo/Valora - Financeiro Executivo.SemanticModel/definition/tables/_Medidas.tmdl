	measure 'Média Geração Caixa 3M' =
			
			AVERAGEX (
			    DATESINPERIOD (
			        DIM_DATA[Data],
			        [Última Data Realizada],
			        -3,
			        MONTH
			    ),
			    [Geração de Caixa]
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: a9ce5fa6-e81e-4837-911f-f08210c15f4c


	measure 'Saldo Caixa Projetado' =
			
			VAR DataRealizada =
			    [Última Data Realizada]
			
			VAR DataAtual =
			    MAX ( DIM_DATA[Data] )
			
			VAR SaldoAtual =
			    CALCULATE (
			        [Saldo Caixa no Período],
			        REMOVEFILTERS ( DIM_DATA ),
			        FATO_CAIXA_DIARIO[Data] = DataRealizada
			    )
			
			VAR MediaMensal =
			    [Média Geração Caixa 3M]
			
			VAR MesesFuturos =
			    DATEDIFF (
			        EOMONTH ( DataRealizada, 0 ),
			        EOMONTH ( DataAtual, 0 ),
			        MONTH
			    )
			
			RETURN
			    IF (
			        DataAtual > DataRealizada,
			        SaldoAtual + ( MediaMensal * MesesFuturos )
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 5d7d8d84-adbe-4047-81c2-7a2fa93c7dab


	measure 'Saldo Caixa Realizado' =
			
			VAR DataRealizada =
			    [Última Data Realizada]
			
			VAR DataAtual =
			    MAX ( DIM_DATA[Data] )
			
			RETURN
			    IF (
			        DataAtual <= DataRealizada,
			        [Saldo Caixa no Período]
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: c79bbdf9-d5fd-40b2-ab52-10aefc7baa74

