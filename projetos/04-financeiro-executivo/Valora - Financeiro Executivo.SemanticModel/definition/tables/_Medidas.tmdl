	measure 'Inadimplência %' =
			
			VAR Vencidos =
			    CALCULATE(
			        [Recebíveis Vencidos],
			        TREATAS(
			            VALUES(DIM_DATA[Data]),
			            FATO_RECEBIVEIS[DataVencimento]
			        )
			    )
			
			VAR Saldo =
			    CALCULATE(
			        [Saldo a Receber],
			        TREATAS(
			            VALUES(DIM_DATA[Data]),
			            FATO_RECEBIVEIS[DataVencimento]
			        )
			    )
			
			RETURN
			DIVIDE(
			    Vencidos,
			    Saldo,
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a67b68ed-33cb-4b99-a081-72a90566ec92

	measure 'Recebíveis Liquidados' =
			
			CALCULATE (
			    [Valor Recebido],
			    FATO_RECEBIVEIS[Status] = "Pago"
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: cc698830-cd65-4c8e-bcc3-4a53c6389349

