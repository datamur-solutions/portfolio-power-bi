			    SELECTEDVALUE ( DIM_PONTE_RESULTADO[Etapa] ),
			
			    "Receita Bruta", [Receita Bruta],
			    "Deduções", [Deduções da Receita],
			    "CMV", [CMV],
			    "OPEX", [OPEX],
			    "Depreciação", [Depreciação e Amortização],
			    "Resultado Financeiro", [Resultado Financeiro],
