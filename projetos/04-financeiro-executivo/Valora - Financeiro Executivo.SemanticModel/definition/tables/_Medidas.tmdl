	measure 'Saldo de Caixa' =
			
			VAR DataReferencia =
			    CALCULATE (
			        MAX ( FATO_CAIXA_DIARIO[Data] ),
			        ALLSELECTED ( DIM_DATA )
			    )
			
			RETURN
			CALCULATE (
			    SUM ( FATO_CAIXA_DIARIO[SaldoFinal] ),
			    REMOVEFILTERS ( DIM_DATA ),
			    FATO_CAIXA_DIARIO[Data] = DataReferencia
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: ee7db3fe-8e2f-421b-ba5f-dcbd69b56ec3

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Saldo Inicial Caixa' =
			
			VAR PrimeiraData =
			    MIN ( DIM_DATA[Data] )
			
			RETURN
			CALCULATE (
			    SUM ( FATO_CAIXA_DIARIO[SaldoInicial] ),
			    DIM_DATA[Data] = PrimeiraData
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: f96a67d6-579f-43a2-ad6f-24bb910e2a27

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Variação Caixa R$' =
			
			[Saldo de Caixa]
