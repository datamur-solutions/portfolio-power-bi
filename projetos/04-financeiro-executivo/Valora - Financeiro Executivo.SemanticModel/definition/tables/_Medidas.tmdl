	measure 'KPI · Ating Receita Sub' =
			"R$ " & FORMAT ( [Receita Líquida] / 1000000, "#,0.0" ) & " mi de R$ " & FORMAT ( [Receita Líquida Orçada Comparável] / 1000000, "#,0.0" ) & " mi orçados"
		displayFolder: Layout
