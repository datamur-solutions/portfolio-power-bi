	partition FATO_DRE = m
		mode: import
		source =
				let
				    // FATO_DRE: base fictícia embutida no modelo (csv compactado)
				    Bin = Binary.Decompress(Binary.FromText(Text.Combine({
				        "",
				        "",
				        "",
				        "",
				        "",
				        "",
				        "",
				        "",
				        ""
				    }), BinaryEncoding.Base64), Compression.Deflate),
				    Fonte = Csv.Document(Bin, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Nulos = Table.TransformColumns(Cabecalhos, List.Transform(Table.ColumnNames(Cabecalhos), (c) => {c, (v) => if v = "" then null else v})),
				    Colunas = Table.SelectColumns(Nulos, {"LancamentoID", "Competencia", "UnidadeID", "CentroCustoID", "ContaID", "Canal", "Valor", "Cenario"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"LancamentoID", type text}, {"Competencia", type datetime}, {"UnidadeID", type text}, {"CentroCustoID", type text}, {"ContaID", type text}, {"Canal", type text}, {"Valor", Int64.Type}, {"Cenario", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

