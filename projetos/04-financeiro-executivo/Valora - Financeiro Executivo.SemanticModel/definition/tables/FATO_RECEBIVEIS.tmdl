	partition FATO_RECEBIVEIS = m
		mode: import
		source =
				let
				    // FATO_RECEBIVEIS: base fictícia embutida no modelo (csv compactado)
				    Bin = Binary.Decompress(Binary.FromText(Text.Combine({
				        "",
				        "",
				        "",
				        "",
				        "",
				        "",
				        "",
				        "",
				        "",
				        "",
				        "",
