	partition FATO_CAIXA_MOV = m
		mode: import
		source =
				let
				    // FATO_CAIXA_MOV: base fictícia embutida no modelo (csv compactado)
				    Bin = Binary.Decompress(Binary.FromText(Text.Combine({
				        "",
				        "",
				        "",
				        ""
				    }), BinaryEncoding.Base64), Compression.Deflate),
				    Fonte = Csv.Document(Bin, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Nulos = Table.TransformColumns(Cabecalhos, List.Transform(Table.ColumnNames(Cabecalhos), (c) => {c, (v) => if v = "" then null else v})),
				    Colunas = Table.SelectColumns(Nulos, {"MovimentoID", "Data", "ContaBancariaID", "GrupoFluxo", "CategoriaFluxo", "Descricao", "UnidadeID", "Entradas", "Saidas", "ValorLiquido", "ReferenciaID"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"MovimentoID", type text}, {"Data", type datetime}, {"ContaBancariaID", type text}, {"GrupoFluxo", type text}, {"CategoriaFluxo", type text}, {"Descricao", type text}, {"UnidadeID", type text}, {"Entradas", Int64.Type}, {"Saidas", Int64.Type}, {"ValorLiquido", Int64.Type}, {"ReferenciaID", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

