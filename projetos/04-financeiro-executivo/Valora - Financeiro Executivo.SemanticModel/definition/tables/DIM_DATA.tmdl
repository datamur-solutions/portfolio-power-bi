	partition DIM_DATA = m
		mode: import
		source =
				let
				    // DIM_DATA: base fictícia embutida no modelo (csv compactado)
				    Bin = Binary.Decompress(Binary.FromText(Text.Combine({
				        ""
				    }), BinaryEncoding.Base64), Compression.Deflate),
				    Fonte = Csv.Document(Bin, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Nulos = Table.TransformColumns(Cabecalhos, List.Transform(Table.ColumnNames(Cabecalhos), (c) => {c, (v) => if v = "" then null else v})),
				    Colunas = Table.SelectColumns(Nulos, {"Data", "Ano", "MesNumero", "Mes", "AnoMes", "Trimestre", "Semestre", "DiaSemanaNumero", "DiaSemana", "DiaUtil"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"Data", type datetime}, {"Ano", Int64.Type}, {"MesNumero", Int64.Type}, {"Mes", type text}, {"AnoMes", type datetime}, {"Trimestre", type text}, {"Semestre", Int64.Type}, {"DiaSemanaNumero", Int64.Type}, {"DiaSemana", type text}, {"DiaUtil", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

