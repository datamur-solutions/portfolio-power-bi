	partition FATO_PAGAVEIS = m
		mode: import
		source =
				let
				    // FATO_PAGAVEIS: base fictícia embutida no modelo (csv compactado)
				    Bin = Binary.Decompress(Binary.FromText(Text.Combine({
				        "",
				        "",
				        "",
				        "",
				        "",
				        "",
				        "",
				        ""
				    }), BinaryEncoding.Base64), Compression.Deflate),
				    Fonte = Csv.Document(Bin, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Nulos = Table.TransformColumns(Cabecalhos, List.Transform(Table.ColumnNames(Cabecalhos), (c) => {c, (v) => if v = "" then null else v})),
				    Colunas = Table.SelectColumns(Nulos, {"PagavelID", "DataEmissao", "DataVencimento", "DataPagamento", "Competencia", "UnidadeID", "FornecedorID", "ContaID", "ValorTitulo", "ValorPago", "Status", "DiasAtraso", "FaixaAging", "PrazoDias"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"PagavelID", type text}, {"DataEmissao", type datetime}, {"DataVencimento", type datetime}, {"DataPagamento", type datetime}, {"Competencia", type datetime}, {"UnidadeID", type text}, {"FornecedorID", type text}, {"ContaID", type text}, {"ValorTitulo", Int64.Type}, {"ValorPago", Int64.Type}, {"Status", type text}, {"DiasAtraso", Int64.Type}, {"FaixaAging", type text}, {"PrazoDias", Int64.Type}}, "en-US"),
				    ComOrdem = Table.AddColumn(Tipos, "Ordem Aging", each if [FaixaAging] = null then 9 else Record.FieldOrDefault([#"A vencer" = 1, #"1-15 dias" = 2, #"16-30 dias" = 3, #"31-60 dias" = 4, #"61-90 dias" = 5, #"90+ dias" = 6], [FaixaAging], 9), Int64.Type)
				in
				    ComOrdem

	annotation PBI_ResultType = Table

