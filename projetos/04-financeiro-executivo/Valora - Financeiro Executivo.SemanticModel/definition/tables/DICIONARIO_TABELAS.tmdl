	partition DICIONARIO_TABELAS = m
		mode: import
		source =
				let
				    // DICIONARIO_TABELAS: base fictícia embutida no modelo (csv compactado)
				    Bin = Binary.Decompress(Binary.FromText(Text.Combine({
				        ""
				    }), BinaryEncoding.Base64), Compression.Deflate),
				    Fonte = Csv.Document(Bin, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Nulos = Table.TransformColumns(Cabecalhos, List.Transform(Table.ColumnNames(Cabecalhos), (c) => {c, (v) => if v = "" then null else v})),
				    Colunas = Table.SelectColumns(Nulos, {"Tabela", "Descricao", "QtdLinhas", "QtdColunas"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"Tabela", type text}, {"Descricao", type text}, {"QtdLinhas", Int64.Type}, {"QtdColunas", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

