	partition FATO_CAPEX = m
		mode: import
		source =
				let
				    // FATO_CAPEX: base fictícia embutida no modelo (csv compactado)
				    Bin = Binary.Decompress(Binary.FromText(Text.Combine({
				        ""
				    }), BinaryEncoding.Base64), Compression.Deflate),
				    Fonte = Csv.Document(Bin, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Nulos = Table.TransformColumns(Cabecalhos, List.Transform(Table.ColumnNames(Cabecalhos), (c) => {c, (v) => if v = "" then null else v})),
				    Colunas = Table.SelectColumns(Nulos, {"AtivoID", "DataAquisicao", "Competencia", "UnidadeID", "CentroCustoID", "CategoriaAtivo", "ValorAquisicao", "VidaUtilMeses", "DepreciacaoMensal", "StatusAtivo"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"AtivoID", type text}, {"DataAquisicao", type datetime}, {"Competencia", type datetime}, {"UnidadeID", type text}, {"CentroCustoID", type text}, {"CategoriaAtivo", type text}, {"ValorAquisicao", Int64.Type}, {"VidaUtilMeses", Int64.Type}, {"DepreciacaoMensal", Int64.Type}, {"StatusAtivo", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

